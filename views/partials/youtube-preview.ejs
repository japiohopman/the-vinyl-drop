<% const previewVideoId = release && typeof release.youtubeVideoId === 'string' && /^[A-Za-z0-9_-]{11}$/.test(release.youtubeVideoId) ? release.youtubeVideoId : null; %>
<% if (previewVideoId) { %>
  <section class="listing-music-preview" aria-labelledby="listingMusicPreviewTitle" data-youtube-preview data-video-id="<%= previewVideoId %>" data-release-title="<%= release.title %>">
    <h2 id="listingMusicPreviewTitle">Listen to this release</h2>
    <p class="listing-music-preview-intro">A preview chosen by the seller for this release.</p>
    <button type="button" class="btn btn-outline btn-md youtube-preview-load" data-youtube-preview-load>Load YouTube preview</button>
    <p class="youtube-preview-privacy-note">Loading the player contacts YouTube and may share basic network and browser/device information. The privacy-enhanced domain does not mean no data reaches YouTube. The player is only loaded after you choose to load it.</p>
    <div class="youtube-preview-frame" data-youtube-preview-frame hidden></div>
    <p class="youtube-preview-fallback">
      If the video cannot play here or embedding is disabled, <a href="<%= 'https://www.youtube.com/watch?v=' + encodeURIComponent(previewVideoId) %>" target="_blank" rel="noopener noreferrer">open this preview on YouTube</a>.
    </p>
    <p class="youtube-preview-status" data-youtube-preview-status role="status" aria-live="polite"></p>
  </section>
  <script src="/js/youtube-preview.js" defer></script>
<% } %>
