<%
  const activePath = typeof currentPath !== 'undefined' ? currentPath : '/';
  const user = typeof currentUser !== 'undefined' ? currentUser : null;
  const userProfile = typeof currentProfile !== 'undefined' ? currentProfile : null;
%>
<nav class="site-nav" aria-label="Primary Navigation">
  <button
    type="button"
    class="nav-toggle"
    id="nav-toggle-btn"
    aria-expanded="false"
    aria-controls="primary-nav-list"
    aria-label="Toggle navigation menu"
  >
    <span class="nav-toggle-icon" aria-hidden="true">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </span>
    <span class="nav-toggle-text">MENU</span>
  </button>

  <ul id="primary-nav-list" class="nav-list">
    <li class="nav-item">
      <a href="/" class="nav-link<%= activePath === '/' ? ' active' : '' %>"<%- activePath === '/' ? ' aria-current="page"' : '' %>>HOME</a>
    </li>
    <li class="nav-item">
      <a href="/browse" class="nav-link<%= activePath.startsWith('/browse') ? ' active' : '' %>"<%- activePath.startsWith('/browse') ? ' aria-current="page"' : '' %>>BROWSE</a>
    </li>
    <li class="nav-item">
      <a href="/drop/new" class="nav-link nav-link-action<%= activePath.startsWith('/drop') || activePath.startsWith('/listings') ? ' active' : '' %>"<%- activePath.startsWith('/drop') || activePath.startsWith('/listings') ? ' aria-current="page"' : '' %>>+ DROP</a>
    </li>
    <li class="nav-item">
      <a href="/activity" class="nav-link<%= activePath.startsWith('/activity') ? ' active' : '' %>"<%- activePath.startsWith('/activity') ? ' aria-current="page"' : '' %>>ACTIVITY</a>
    </li>
    <li class="nav-item">
      <a href="/profile" class="nav-link<%= activePath.startsWith('/profile') || activePath.startsWith('/profiles') ? ' active' : '' %>"<%- activePath.startsWith('/profile') || activePath.startsWith('/profiles') ? ' aria-current="page"' : '' %>><%= userProfile ? '@' + userProfile.username : 'YOU' %></a>
    </li>
    <% if (user) { %>
      <li class="nav-item">
        <form action="/auth/logout" method="POST" class="inline-form" style="display: inline;">
          <button type="submit" class="nav-link nav-link-button" style="background: none; border: none; font: inherit; cursor: pointer;">LOGOUT</button>
        </form>
      </li>
    <% } else { %>
      <li class="nav-item">
        <a href="/auth/login" class="nav-link<%= activePath.startsWith('/auth/login') ? ' active' : '' %>"<%- activePath.startsWith('/auth/login') ? ' aria-current="page"' : '' %>>SIGN IN</a>
      </li>
    <% } %>
  </ul>
</nav>

<script>
  (function() {
    var toggle = document.getElementById('nav-toggle-btn');
    var menu = document.getElementById('primary-nav-list');
    if (!toggle || !menu) return;

    toggle.addEventListener('click', function() {
      var expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      if (!expanded) {
        menu.classList.add('is-open');
      } else {
        menu.classList.remove('is-open');
      }
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        toggle.setAttribute('aria-expanded', 'false');
        menu.classList.remove('is-open');
        toggle.focus();
      }
    });
  })();
</script>
