<%
  const commentsPageMode = typeof commentsPage !== 'undefined' && commentsPage;
  const commentsReturnPath = commentsPageMode ? `/listings/${listing.id}/comments` : `/listings/${listing.id}`;
%>
<section id="comments" class="comment-thread-section" aria-label="Listing comments" tabindex="-1">
  <% if (!(typeof hideContext !== 'undefined' && hideContext) && typeof release !== 'undefined' && release) { %>
    <div class="comment-thread-context">
      <div class="comment-thread-artwork">
        <% if (typeof photos !== 'undefined' && photos && photos.length > 0) { %>
          <img src="<%= photos[0].publicUrl %>" alt="" loading="lazy">
        <% } else { %>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
        <% } %>
      </div>
      <div class="comment-thread-context-copy">
        <p class="comment-context-eyebrow">Discussing drop</p>
        <p class="comment-thread-release-title">
          <%= release.title %> <span>— <%= release.artist %></span>
        </p>
      </div>
    </div>
  <% } %>

  <% if (!(typeof hideHeading !== 'undefined' && hideHeading)) { %>
    <h2 class="comment-thread-heading">
      Community Discussion (<%= typeof comments !== 'undefined' && comments ? comments.length : 0 %>)
    </h2>
  <% } %>

  <% if (typeof commentError !== 'undefined' && commentError) { %>
    <div class="comment-error alert alert-error" role="alert" id="comment-error">
      <p><%= commentError %></p>
    </div>
  <% } %>

  <div class="comment-list">
    <% if (typeof comments !== 'undefined' && comments && comments.length > 0) { %>
      <% comments.forEach(function(c) { %>
        <% const isSellerAuthor = (seller && c.authorId === seller.id) || (listing && c.authorId === listing.sellerId); %>
        <article class="comment-card <%= isSellerAuthor ? 'comment-card-seller' : '' %>">
          <div class="comment-card-header">
            <div class="comment-author">
              <div class="comment-avatar">
                <% if (c.author.avatarUrl) { %>
                  <img src="<%= c.author.avatarUrl %>" alt="<%= c.author.displayName || c.author.username %>'s avatar" loading="lazy">
                <% } else { %>
                  <span aria-hidden="true"><%= (c.author.displayName || c.author.username || 'U').substring(0, 1).toUpperCase() %></span>
                <% } %>
              </div>
              <div class="comment-author-identity">
                <a href="/profiles/<%= encodeURIComponent(c.author.username) %>" class="comment-author-name">
                  <%= c.author.displayName || c.author.username %>
                </a>
                <span class="comment-author-handle">@<%= c.author.username %></span>
                <% if (isSellerAuthor) { %>
                  <span class="seller-badge">Seller</span>
                <% } %>
              </div>
            </div>
            <time datetime="<%= new Date(c.createdAt).toISOString() %>" class="comment-time">
              <%= new Date(c.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
            </time>
          </div>
          <div class="comment-content">
            <p><%= c.content %></p>
          </div>
        </article>
      <% }); %>
    <% } else { %>
      <div class="empty-comments">
        <p>No comments yet. Be the first to start the discussion!</p>
      </div>
    <% } %>
  </div>

  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
    <form id="comment-form" action="/listings/<%= listing.id %>/comments" method="POST" class="comment-form">
      <input type="hidden" name="returnTo" value="<%= commentsPageMode ? 'comments' : 'thread' %>">
      <div class="form-group">
        <label for="comment-content">Post a comment or question</label>
        <textarea
          id="comment-content"
          name="content"
          rows="3"
          required
          maxlength="1000"
          placeholder="Ask the seller about media condition, pressing details, or drop availability..."
          <% if (typeof commentError !== 'undefined' && commentError) { %>aria-describedby="comment-error" autofocus<% } %>
        ><%= typeof submittedContent !== 'undefined' ? submittedContent : '' %></textarea>
      </div>
      <button type="submit" class="btn btn-primary">Post Comment</button>
    </form>
  <% } else { %>
    <div class="login-prompt">
      <p>Have a question about this record?</p>
      <a href="/auth/login?next=<%= encodeURIComponent(commentsReturnPath) %>" class="btn btn-outline btn-sm">
        Sign in to post a comment
      </a>
    </div>
  <% } %>
</section>
