<%
  const headerPath = typeof currentPath !== 'undefined' ? currentPath : '/';
  const isCustomReleasePage = headerPath === '/releases/new';
  const isListingCreatePage = headerPath === '/listings/create';
  const isListingDetailPage = headerPath !== '/listings/create' && /^\/listings\/[^/]+$/.test(headerPath);
  const isListingCommentsPage = headerPath.startsWith('/listings/') && headerPath.endsWith('/comments') && headerPath.split('/').length === 4;
  const isListingEditPage = headerPath.startsWith('/listings/') && headerPath.endsWith('/edit') && headerPath.split('/').length === 4;
  const isListingPreviewPage = headerPath.startsWith('/listings/') && headerPath.endsWith('/preview') && headerPath.split('/').length === 4;
  const isMyListingsPage = headerPath === '/listings';
  const isDigRoute = headerPath === '/dig';
  const digItemCount = typeof items !== 'undefined' && Array.isArray(items) ? items.length : 0;
  const aboutPagePaths = ['/contact', '/privacy', '/terms', '/community-rules'];
  const isAboutPage = aboutPagePaths.includes(headerPath);
  let mobileSectionLabel = 'THE VINYL DROP';

  if (headerPath === '/') {
    mobileSectionLabel = 'HOME';
  } else if (headerPath.startsWith('/dig') || headerPath.startsWith('/browse')) {
    mobileSectionLabel = 'DIG';
  } else if (isListingCommentsPage) {
    mobileSectionLabel = 'COMMENTS';
  } else if (isListingDetailPage) {
    mobileSectionLabel = 'RECORD';
  } else if (isListingPreviewPage) {
    mobileSectionLabel = 'PREVIEW';
  } else if (headerPath.startsWith('/drop') || headerPath.startsWith('/listings') || headerPath.startsWith('/releases')) {
    mobileSectionLabel = 'DROP';
  } else if (headerPath.startsWith('/messages')) {
    mobileSectionLabel = 'MESSAGES';
  } else if (headerPath.startsWith('/activity')) {
    mobileSectionLabel = 'ACTIVITY';
  } else if (headerPath.startsWith('/profile') || headerPath.startsWith('/profiles') || headerPath.startsWith('/auth')) {
    mobileSectionLabel = 'ME';
  } else if (headerPath === '/terms') {
    mobileSectionLabel = 'ABOUT · TERMS';
  } else if (headerPath === '/contact') {
    mobileSectionLabel = 'ABOUT · CONTACT';
  } else if (headerPath === '/privacy') {
    mobileSectionLabel = 'ABOUT · PRIVACY';
  } else if (headerPath === '/community-rules') {
    mobileSectionLabel = 'ABOUT · COMMUNITY RULES';
  }
%>
<header class="site-header">
  <div class="container header-container">
    <a href="/" class="brand-logo" aria-label="The Vinyl Drop Home">
      <img src="/assets/brand/vinyl-drop-cartridge.svg" alt="" class="brand-cartridge-icon" width="24" height="24">
      <span class="brand-text-container">
        <span class="logo-title">The Vinyl Drop</span>
        <span class="logo-tagline">BUY. TRADE. DIG.</span>
      </span>
    </a>
    <nav class="mobile-context-header" aria-label="Page navigation">
      <% if (isListingDetailPage && typeof release !== 'undefined' && release) { %>
        <span
          class="mobile-context-heading mobile-context-record-heading"
          aria-label="<%= release.artist %>, <%= release.title %><%= release.releaseYear ? ', ' + release.releaseYear : '' %>"
        >
          <span class="mobile-context-record-artist"><%= release.artist %></span>
          <span class="mobile-context-record-title"><%= release.title %></span>
          <% if (release.releaseYear) { %>
            <span class="mobile-context-record-year"><%= release.releaseYear %></span>
          <% } %>
        </span>
      <% } else { %>
        <span class="mobile-context-heading"><%= mobileSectionLabel %></span>
      <% } %>
      <% if (isDigRoute && digItemCount > 0) { %>
        <span class="mobile-dig-position" data-dig-header-position aria-live="polite" aria-atomic="true">1 of <%= digItemCount %></span>
      <% } else if (isAboutPage) { %>
        <a href="/" class="mobile-context-back mobile-context-back-icon-only mobile-context-home" aria-label="Back to Home">
          <span class="mobile-context-back-icon" aria-hidden="true">←</span>
        </a>
      <% } else if (isListingDetailPage) { %>
        <a href="/dig" class="mobile-context-back mobile-context-back-icon-only" aria-label="Back to Dig results">
          <span class="mobile-context-back-icon" aria-hidden="true">←</span>
        </a>
      <% } else if (isListingCommentsPage) { %>
        <a href="/listings/<%= encodeURIComponent(headerPath.split('/')[2]) %>#comments-entry" class="mobile-context-back mobile-context-back-icon-only" aria-label="Back to listing">
          <span class="mobile-context-back-icon" aria-hidden="true">←</span>
        </a>
      <% } else if (isCustomReleasePage) { %>
        <a href="/drop/new" class="mobile-context-back mobile-context-back-icon-only" aria-label="Back to catalog search">
          <span class="mobile-context-back-icon" aria-hidden="true">←</span>
        </a>
      <% } else if (isListingCreatePage) { %>
        <a href="/drop/new" class="mobile-context-back mobile-context-back-icon-only" aria-label="Back to release search">
          <span class="mobile-context-back-icon" aria-hidden="true">←</span>
        </a>
      <% } else if (isMyListingsPage) { %>
        <a href="/profile" class="mobile-context-back mobile-context-back-icon-only" aria-label="Back to My Profile">
          <span class="mobile-context-back-icon" aria-hidden="true">←</span>
        </a>
      <% } else if (isListingEditPage || isListingPreviewPage) { %>
        <a href="/listings" class="mobile-context-back mobile-context-back-icon-only" aria-label="Back to My Listings">
          <span class="mobile-context-back-icon" aria-hidden="true">←</span>
        </a>
      <% } %>
    </nav>
    <%- include('./nav') %>
  </div>
</header>
