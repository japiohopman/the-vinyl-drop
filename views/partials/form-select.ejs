<%
  /*
    form-select.ejs - Reusable accessible form select dropdown
  */
  const fieldName = typeof name !== 'undefined' ? name : '';
  const fieldId = typeof id !== 'undefined' && id ? id : `field-${fieldName}`;
  const fieldValue = typeof value !== 'undefined' && value !== null ? String(value) : '';
  const optionList = typeof options !== 'undefined' && Array.isArray(options) ? options : [];
  const isRequired = typeof required !== 'undefined' ? Boolean(required) : false;
  const isDisabled = typeof disabled !== 'undefined' ? Boolean(disabled) : false;
  const fieldError = typeof error !== 'undefined' && error ? String(error) : '';
  const help = typeof helpText !== 'undefined' && helpText ? String(helpText) : '';
  const fieldPlaceholder = typeof placeholder !== 'undefined' ? placeholder : '';

  const helpId = help ? `${fieldId}-help` : '';
  const errorId = fieldError ? `${fieldId}-error` : '';
  const describedByParts = [helpId, errorId].filter(Boolean);
  const describedBy = describedByParts.length > 0 ? describedByParts.join(' ') : undefined;
%>

<div class="form-group <%= fieldError ? 'has-error' : '' %>">
  <label for="<%= fieldId %>" class="form-label">
    <%= label %>
    <% if (isRequired) { %>
      <span class="required-indicator" title="Required">*</span>
    <% } %>
  </label>

  <% if (help) { %>
    <p id="<%= helpId %>" class="form-help-text"><%= help %></p>
  <% } %>

  <div class="select-wrapper">
    <select
      id="<%= fieldId %>"
      name="<%= fieldName %>"
      class="form-control form-select"
      <% if (isRequired) { %>required aria-required="true"<% } %>
      <% if (isDisabled) { %>disabled<% } %>
      <% if (fieldError) { %>aria-invalid="true"<% } %>
      <% if (describedBy) { %>aria-describedby="<%= describedBy %>"<% } %>
    >
      <% if (fieldPlaceholder) { %>
        <option value="" <%= !fieldValue ? 'selected' : '' %>><%= fieldPlaceholder %></option>
      <% } %>
      <% optionList.forEach(function(opt) { %>
        <%
          const optValue = String(opt.value);
          const isSelected = fieldValue ? optValue === fieldValue : Boolean(opt.selected);
        %>
        <option value="<%= optValue %>" <%= isSelected ? 'selected' : '' %>>
          <%= opt.label %>
        </option>
      <% }); %>
    </select>
  </div>

  <% if (fieldError) { %>
    <p id="<%= errorId %>" class="form-error-message" role="alert">
      <svg class="error-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <%= fieldError %>
    </p>
  <% } %>
</div>
