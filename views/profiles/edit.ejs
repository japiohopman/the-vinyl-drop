<div class="profile-edit-page">
  <div class="profile-edit-card">
    <header class="profile-edit-header">
      <h1 class="profile-edit-title">Edit profile</h1>
      <p class="profile-edit-intro">Update your public profile.</p>
    </header>

    <%- include('../partials/form-errors', {
      errors: form.generalErrors.length > 0
        ? form.generalErrors
        : Object.values(form.fieldErrors)
    }) %>

    <form action="/profile/edit" method="POST" class="profile-edit-form" novalidate>
      <div class="profile-edit-fields">
        <%- include('../partials/form-input', {
          type: 'text',
          name: 'username',
          label: 'Username',
          value: form.values.username,
          required: true,
          error: form.fieldErrors.username,
          helpText: 'Letters, numbers, hyphens and underscores.'
        }) %>

        <%- include('../partials/form-input', {
          type: 'text',
          name: 'displayName',
          label: 'Display name',
          value: form.values.displayName,
          placeholder: 'e.g. Miles Davis',
          error: form.fieldErrors.displayName
        }) %>

        <%- include('../partials/form-input', {
          type: 'text',
          name: 'location',
          label: 'Location',
          value: form.values.location,
          placeholder: 'e.g. Amsterdam',
          error: form.fieldErrors.location,
          helpText: 'City or neighborhood.'
        }) %>

        <%- include('../partials/form-input', {
          type: 'url',
          name: 'websiteUrl',
          label: 'Website / DJ link',
          value: form.values.websiteUrl,
          placeholder: 'https://example.com',
          error: form.fieldErrors.websiteUrl,
          helpText: 'Optional website, DJ page or Linktree.'
        }) %>

        <%- include('../partials/form-input', {
          type: 'url',
          name: 'avatarUrl',
          label: 'Avatar URL',
          value: form.values.avatarUrl,
          placeholder: 'https://example.com/avatar.jpg',
          error: form.fieldErrors.avatarUrl
        }) %>

        <div class="profile-edit-bio">
          <%- include('../partials/form-textarea', {
            name: 'bio',
            label: 'Bio',
            value: form.values.bio,
            rows: 4,
            placeholder: 'Your musical tastes, favorite genres or trade wishlist…',
            error: form.fieldErrors.bio
          }) %>
        </div>
      </div>

      <div class="profile-edit-actions">
        <button type="submit" class="btn btn-primary btn-md mobile-compact-action" aria-label="Save changes" title="Save changes">
          <span class="mobile-action-icon" aria-hidden="true"><%- include('../partials/icon', { name: 'save', size: '1.125rem', ariaHidden: true }) %></span>
          <span class="mobile-action-label">Save Changes</span>
        </button>

        <a href="/profiles/<%= encodeURIComponent(profile.username) %>" class="btn btn-outline btn-md mobile-compact-action" aria-label="Cancel editing profile" title="Cancel">
          <span class="mobile-action-icon" aria-hidden="true"><%- include('../partials/icon', { name: 'close', size: '1.125rem', ariaHidden: true }) %></span>
          <span class="mobile-action-label">Cancel</span>
        </a>
      </div>
    </form>
  </div>
</div>
