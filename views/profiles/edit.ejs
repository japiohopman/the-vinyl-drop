<div class="profile-edit-page">
  <div class="profile-edit-card">
    <header class="profile-edit-header">
      <h1 class="profile-edit-title">Edit profile</h1>
      <p class="profile-edit-intro">Update your public profile.</p>
    </header>

    <%- include('../partials/form-errors', {
      errors: form.generalErrors.length > 0
        ? form.generalErrors
        : Object.values(form.fieldErrors)
    }) %>

    <section class="profile-avatar-editor" aria-labelledby="profile-avatar-title">
      <div class="profile-avatar-editor-copy">
        <h2 id="profile-avatar-title">Profile photo</h2>
        <p>Choose a photo or animated GIF. JPEG, PNG, WebP and GIF are supported (maximum 5 MiB).</p>
      </div>
      <div class="profile-avatar-editor-preview">
        <% const currentAvatar = (typeof avatarPublicUrl !== 'undefined' && avatarPublicUrl) ? avatarPublicUrl : form.values.avatarUrl; %>
        <% if (currentAvatar) { %>
          <img src="<%= currentAvatar %>" alt="Current profile avatar" data-profile-avatar-preview>
        <% } else { %>
          <span class="profile-avatar-placeholder" data-profile-avatar-placeholder aria-hidden="true"><%= (form.values.displayName || form.values.username || '?').substring(0, 1).toUpperCase() %></span>
          <img src="" alt="Selected profile avatar preview" data-profile-avatar-preview hidden>
        <% } %>
      </div>
      <form action="/profile/avatar" method="POST" enctype="multipart/form-data" class="profile-avatar-upload-form" id="profile-avatar-upload-form">
        <label for="profile-avatar-file">Choose a profile image</label>
        <input id="profile-avatar-file" type="file" name="avatar" accept="image/jpeg,image/png,image/webp,image/gif,.jpg,.jpeg,.png,.webp,.gif" required>
        <p class="profile-avatar-file-name" data-profile-avatar-file-name aria-live="polite">No new image selected.</p>
        <button type="submit" class="btn btn-primary btn-md mobile-compact-action">Upload profile photo</button>
      </form>
      <% if (profile.avatarStoragePath) { %>
        <form action="/profile/avatar/remove" method="POST" class="profile-avatar-remove-form">
          <button type="submit" class="btn btn-outline btn-sm mobile-compact-action">Remove uploaded photo</button>
          <p>Your Avatar URL fallback remains available after removal.</p>
        </form>
      <% } %>
    </section>

    <form action="/profile/edit" method="POST" class="profile-edit-form" novalidate>
      <div class="profile-edit-fields">
        <%- include('../partials/form-input', {
          type: 'text',
          name: 'username',
          label: 'Username',
          value: form.values.username,
          required: true,
          error: form.fieldErrors.username,
          helpText: 'Letters, numbers, hyphens and underscores.'
        }) %>

        <%- include('../partials/form-input', {
          type: 'text',
          name: 'displayName',
          label: 'Display name',
          value: form.values.displayName,
          placeholder: 'e.g. Miles Davis',
          error: form.fieldErrors.displayName
        }) %>

        <%- include('../partials/form-input', {
          type: 'text',
          name: 'location',
          label: 'Location',
          value: form.values.location,
          placeholder: 'e.g. Amsterdam',
          error: form.fieldErrors.location,
          helpText: 'City or neighborhood.'
        }) %>

        <%- include('../partials/form-input', {
          type: 'url',
          name: 'websiteUrl',
          label: 'Website / DJ link',
          value: form.values.websiteUrl,
          placeholder: 'https://example.com',
          error: form.fieldErrors.websiteUrl,
          helpText: 'Optional website, DJ page or Linktree.'
        }) %>

        <%- include('../partials/form-input', {
          type: 'url',
          name: 'avatarUrl',
          label: 'Avatar URL fallback',
          value: form.values.avatarUrl,
          placeholder: 'https://example.com/avatar.jpg',
          error: form.fieldErrors.avatarUrl,
          helpText: 'Used only when no uploaded profile photo is set.'
        }) %>

        <%- include('../partials/form-input', {
          type: 'url',
          name: 'soundcloudUrl',
          label: 'SoundCloud',
          value: form.values.soundcloudUrl || '',
          placeholder: 'https://soundcloud.com/your-name',
          error: form.fieldErrors.soundcloudUrl,
          helpText: 'Optional public SoundCloud profile or artist page.'
        }) %>

        <%- include('../partials/form-input', {
          type: 'url',
          name: 'mixcloudUrl',
          label: 'Mixcloud',
          value: form.values.mixcloudUrl || '',
          placeholder: 'https://www.mixcloud.com/your-name',
          error: form.fieldErrors.mixcloudUrl,
          helpText: 'Optional public Mixcloud profile or show page.'
        }) %>

        <div class="profile-edit-bio">
          <%- include('../partials/form-textarea', {
            name: 'bio',
            label: 'Bio',
            value: form.values.bio,
            rows: 4,
            placeholder: 'Your musical tastes, favorite genres or trade wishlist…',
            error: form.fieldErrors.bio
          }) %>
        </div>
      </div>

      <div class="profile-edit-actions">
        <button type="submit" class="btn btn-primary btn-md mobile-compact-action" aria-label="Save changes" title="Save changes">
          <span class="mobile-action-icon" aria-hidden="true"><%- include('../partials/icon', { name: 'save', size: '1.125rem', ariaHidden: true }) %></span>
          <span class="mobile-action-label">Save Changes</span>
        </button>

        <a href="/profiles/<%= encodeURIComponent(profile.username) %>" class="btn btn-outline btn-md mobile-compact-action" aria-label="Cancel editing profile" title="Cancel">
          <span class="mobile-action-icon" aria-hidden="true"><%- include('../partials/icon', { name: 'close', size: '1.125rem', ariaHidden: true }) %></span>
          <span class="mobile-action-label">Cancel</span>
        </a>
      </div>
    </form>
  </div>
</div>
<script src="/js/profile-avatar-upload.js" defer></script>
