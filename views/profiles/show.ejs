<div class="profile-landing-page">
  <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
    <div class="alert alert-error profile-page-alert" role="alert"><%= errorMessage %></div>
  <% } %>

  <section class="profile-landing-card" aria-labelledby="profile-display-name">
    <div class="profile-landing-identity">
      <div class="profile-landing-avatar">
        <% if (profile.avatarUrl) { %>
          <img src="<%= profile.avatarUrl %>" alt="<%= profile.displayName || profile.username %>'s avatar">
        <% } else { %>
          <span aria-hidden="true"><%= (profile.displayName || profile.username).substring(0, 1).toUpperCase() %></span>
        <% } %>
      </div>

      <div class="profile-landing-details">
        <p class="profile-eyebrow">DIGGER PROFILE</p>
        <h1 id="profile-display-name"><%= profile.displayName || profile.username %></h1>
        <p class="profile-username">@<%= profile.username %></p>

        <% if (profile.location) { %>
          <p class="profile-location"><%- include('../partials/icon', { name: 'position-marker', size: '1rem', ariaHidden: true }) %><span><%= profile.location %></span></p>
        <% } %>

        <% if (profile.bio) { %>
          <p class="profile-bio"><%= profile.bio %></p>
        <% } %>

        <% if (profile.websiteUrl) { %>
          <p class="profile-website"><a href="<%= profile.websiteUrl %>" target="_blank" rel="noopener noreferrer"><%= profile.websiteUrl %></a></p>
        <% } %>

        <p class="profile-member-since">Member since <%= new Date(profile.createdAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) %></p>
      </div>
    </div>

    <div class="profile-owner-actions">
      <% if (isOwner) { %>
        <a href="/profile/edit" class="btn btn-outline btn-sm">Edit Profile</a>
        <% if (typeof messagingEnabled !== 'undefined' && messagingEnabled) { %>
          <button
            type="button"
            class="btn btn-outline btn-sm messaging-widget-trigger"
            data-messaging-widget-trigger
            aria-controls="messaging-floating-window"
            aria-expanded="false"
            aria-haspopup="dialog"
            aria-label="Open Messages and Saved People"
          >Messages &amp; People</button>
        <% } %>
      <% } else if (typeof user !== 'undefined' && user && typeof messagingEnabled !== 'undefined' && messagingEnabled) { %>
        <form
          action="/messages/profile/<%= profile.id %>"
          method="POST"
          class="inline-form"
          data-message-profile-form
          data-message-profile-id="<%= profile.id %>"
        >
          <button type="submit" class="btn btn-primary btn-sm">Message</button>
        </form>
        <form action="/messages/saved-people/<%= profile.id %>" method="POST" class="inline-form">
          <input type="hidden" name="action" value="<%= typeof isSavedPerson !== 'undefined' && isSavedPerson ? 'remove' : 'save' %>">
          <button type="submit" class="btn btn-outline btn-sm"><%= typeof isSavedPerson !== 'undefined' && isSavedPerson ? 'Remove from Saved People' : 'Save Person' %></button>
        </form>
      <% } %>
    </div>
  </section>

  <% const recordCount = typeof crateTotalCount === 'number' ? crateTotalCount : 0; %>
  <a class="profile-crate-entry" href="/profiles/<%= encodeURIComponent(profile.username) %>/crate" aria-label="View <%= profile.displayName || profile.username %>'s Crate, <%= recordCount %> published <%= recordCount === 1 ? 'record' : 'records' %>">
    <span class="profile-crate-entry-icon" aria-hidden="true">
      <%- include('../partials/icon', { name: 'cardboard-box-closed', size: '2rem', ariaHidden: true }) %>
    </span>
    <span class="profile-crate-entry-main">
      <span class="profile-crate-entry-title">Crate</span>
      <span class="profile-crate-entry-count"><%= recordCount %> published <%= recordCount === 1 ? 'record' : 'records' %></span>
      <span class="profile-crate-entry-action">View Crate</span>
    </span>
    <span class="profile-crate-entry-chevron" aria-hidden="true">
      <%- include('../partials/icon', { name: 'next-button', size: '1.25rem', ariaHidden: true }) %>
    </span>
  </a>
</div>
