<div class="profile-page" style="max-width: 720px; margin: var(--space-8) auto;">
  <div class="profile-header-card" style="padding: var(--space-6); border: var(--border-thick); border-radius: var(--radius-md); background: var(--color-surface-card);">
    <div style="display: flex; gap: var(--space-6); align-items: flex-start; flex-wrap: wrap;">
      <div class="profile-avatar" style="width: 96px; height: 96px; border-radius: 50%; border: var(--border-thick); overflow: hidden; background-color: var(--color-paper-muted); flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-size: 2rem;">
        <% if (profile.avatarUrl) { %>
          <img src="<%= profile.avatarUrl %>" alt="<%= profile.displayName || profile.username %>'s avatar" style="width: 100%; height: 100%; object-fit: cover;">
        <% } else { %>
          <span><%= (profile.displayName || profile.username).substring(0, 1).toUpperCase() %></span>
        <% } %>
      </div>

      <div class="profile-details" style="flex: 1; min-width: 240px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-4);">
          <div>
            <h1 style="font-family: var(--font-display); font-size: var(--font-size-xl); margin-bottom: var(--space-1);"><%= profile.displayName || profile.username %></h1>
            <p style="font-family: var(--font-mono); color: var(--color-ink-muted); font-size: var(--font-size-sm);">@<%= profile.username %></p>
          </div>

          <% if (isOwner) { %>
            <a href="/profile/edit" class="btn btn-outline btn-sm">Edit Profile</a>
          <% } %>
        </div>

        <% if (profile.location) { %>
          <p style="margin-top: var(--space-3); font-size: var(--font-size-sm); color: var(--color-ink-muted); display: flex; align-items: center; gap: var(--space-1);">
            📍 <%= profile.location %>
          </p>
        <% } %>

        <% if (profile.bio) { %>
          <p style="margin-top: var(--space-4); line-height: 1.5; font-size: var(--font-size-md);"><%= profile.bio %></p>
        <% } %>

        <div style="margin-top: var(--space-4); font-family: var(--font-mono); font-size: var(--font-size-xs); color: var(--color-ink-muted);">
          Member since <%= new Date(profile.createdAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) %>
        </div>
      </div>
    </div>
  </div>

  <!-- Seller's Crate Section -->
  <div class="profile-crate-section" style="margin-top: var(--space-8);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4); border-bottom: var(--border-thick); padding-bottom: var(--space-2);">
      <h2 style="font-family: var(--font-display); font-size: var(--font-size-lg); margin: 0; display: flex; align-items: center; gap: var(--space-2);">
        📦 <%= isOwner ? 'My Crate (Active Listings)' : (profile.displayName || profile.username) + "'s Crate" %>
      </h2>
      <span style="font-family: var(--font-mono); font-size: var(--font-size-sm); color: var(--color-ink-muted);">
        <%= (typeof crateListings !== 'undefined' && crateListings) ? crateListings.length : 0 %> <%= (typeof crateListings !== 'undefined' && crateListings && crateListings.length === 1) ? 'record' : 'records' %> for sale
      </span>
    </div>

    <% if (typeof crateListings === 'undefined' || !crateListings || crateListings.length === 0) { %>
      <div class="card" style="padding: var(--space-6); text-align: center; border: var(--border-thick); background: var(--color-surface-card);">
        <p style="font-family: var(--font-display); font-size: var(--font-size-md); margin-bottom: var(--space-2);">
          <%= isOwner ? 'Your crate is currently empty.' : 'This seller has no active listings in their crate right now.' %>
        </p>
        <% if (isOwner) { %>
          <a href="/drop/new" class="btn btn-primary btn-sm" style="margin-top: var(--space-2);">+ Drop a Record for Sale</a>
        <% } %>
      </div>
    <% } else { %>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: var(--space-4);">
        <% crateListings.forEach(function(listing) { %>
          <%- include('../partials/listing-card', { listing }) %>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>
