<div class="conversation-container">
  <div class="conversation-topbar">
    <a href="/messages" class="conversation-back-link">← Back to Inbox</a>
    <div class="conversation-actions">
      <form action="/messages/<%= conversation.id %>/read" method="POST">
        <input type="hidden" name="messageSeq" value="<%= readThroughSeq %>">
        <button type="submit" class="btn btn-outline btn-xs">Mark as read</button>
      </form>
      <form action="/messages/<%= conversation.id %>/archive" method="POST">
        <button type="submit" class="btn btn-outline btn-xs">Archive Thread</button>
      </form>
    </div>
  </div>

  <% if (conversation.conversationType === 'listing' && conversation.listing && conversation.release) { %>
    <section class="linked-listing-card conversation-context-card" aria-labelledby="conversation-context-title">
      <div class="conversation-context-copy">
        <div class="conversation-page-kicker">
          <img src="/assets/svg/talk.svg" alt="" aria-hidden="true">
          Listing inquiry (<%= userRole === 'buyer' ? 'Seller' : 'Buyer' %>: @<%= otherParticipant.username %>)
        </div>
        <h1 id="conversation-context-title" class="conversation-page-title">
          <img src="/assets/svg/conversation.svg" alt="" aria-hidden="true">
          <span><%= conversation.release.artist %> — <%= conversation.release.title %></span>
        </h1>
      </div>
      <a href="/listings/<%= conversation.listing.id %>" class="btn btn-outline btn-sm conversation-context-action">View Listing Details</a>
    </section>
  <% } else { %>
    <section class="linked-listing-card conversation-context-card" aria-labelledby="conversation-context-title">
      <div class="conversation-context-copy">
        <div class="conversation-page-kicker">
          <img src="/assets/svg/talk.svg" alt="" aria-hidden="true">
          Private direct conversation
        </div>
        <h1 id="conversation-context-title" class="conversation-page-title">
          <img src="/assets/svg/conversation.svg" alt="" aria-hidden="true">
          <span><%= otherParticipant.displayName || ('@' + otherParticipant.username) %></span>
        </h1>
      </div>
      <a href="/profiles/<%= encodeURIComponent(otherParticipant.username) %>" class="btn btn-outline btn-sm conversation-context-action">View Profile</a>
    </section>
  <% } %>

  <section class="messages-stream" aria-label="Conversation messages">
    <% if (!messages || messages.length === 0) { %>
      <div class="conversation-empty-state">
        No messages sent yet. Send a message below to start chatting!
      </div>
    <% } else { %>
      <% messages.forEach(function(msg) { %>
        <% const isSelf = msg.senderId === user.id; %>
        <div class="message-bubble-wrapper <%= isSelf ? 'message-bubble-wrapper-own' : 'message-bubble-wrapper-other' %>">
          <div class="message-meta">
            <%= isSelf ? 'You' : ('@' + otherParticipant.username) %>
            <span aria-hidden="true">·</span>
            <time datetime="<%= new Date(msg.createdAt).toISOString() %>"><%= new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></time>
          </div>
          <div class="message-bubble <%= isSelf ? 'message-bubble-own' : 'message-bubble-other' %>"><%= msg.body %></div>
        </div>
      <% }); %>
    <% } %>
  </section>

  <section class="send-message-card" aria-labelledby="conversation-compose-heading">
    <form action="/messages/<%= conversation.id %>/send" method="POST" class="conversation-compose">
      <div class="conversation-compose-field">
        <label id="conversation-compose-heading" for="message-body" class="conversation-compose-label">Send a message</label>
        <textarea
          id="message-body"
          name="body"
          class="conversation-compose-textarea"
          rows="3"
          required
          maxlength="4000"
          placeholder="Type your message here..."
        ></textarea>
        <div class="conversation-compose-help">Plain text, up to 4,000 characters</div>
      </div>
      <div class="conversation-compose-actions">
        <button type="submit" class="btn btn-primary conversation-send-button">
          <img src="/assets/svg/send.svg" alt="" aria-hidden="true">
          <span>Send message</span>
        </button>
      </div>
    </form>
  </section>
</div>
