<div class="activity-container">
  <header class="activity-header">
    <div>
      <span class="activity-kicker">THE VINYL DROP / COMMUNITY</span>
      <h1>COMMUNITY ACTIVITY</h1>
      <p>Fresh drops, conversations and records saved by the people in your crate-digging community.</p>
    </div>
  </header>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error" role="alert">
      <strong>Activity unavailable:</strong> <%= error %>
    </div>
  <% } %>

  <% if (events && events.length > 0) { %>
    <ul class="activity-feed-list" aria-label="Community activity stream">
      <% events.forEach(function(item) { %>
        <li class="activity-card">
          <a class="activity-artwork-link" href="<%= item.listingUrl %>" aria-label="Open <%= item.releaseTitle %> by <%= item.releaseArtist %>">
            <img
              class="activity-record-artwork"
              src="<%= item.listingArtworkUrl || item.releaseCoverArtUrl || '/assets/vinyl-placeholder.svg' %>"
              alt="Artwork for <%= item.releaseTitle %> by <%= item.releaseArtist %>"
              loading="lazy"
              referrerpolicy="no-referrer"
              data-artwork-image
              data-artwork-fallback="<%= item.artworkFallbackUrl || '/assets/vinyl-placeholder.svg' %>"
            />
            <span
              class="activity-artwork-terminal-fallback"
              data-artwork-terminal-fallback
              role="img"
              aria-label="Artwork unavailable for <%= item.releaseTitle %> by <%= item.releaseArtist %>"
              hidden
            >
              <span class="activity-artwork-terminal-mark" aria-hidden="true"></span>
              <span>Artwork unavailable</span>
            </span>
          </a>

          <div class="activity-card-content">
            <div class="activity-card-body">
              <div class="activity-card-header">
                <div class="activity-actor-row">
                  <% if (item.actorUsername && item.eventType !== 'favorite.created') { %>
                    <a class="activity-actor-avatar-link" href="/profiles/<%= encodeURIComponent(item.actorUsername) %>" aria-label="View <%= item.actorUsername %>'s profile">
                  <% } %>
                  <span class="activity-avatar">
                    <% if (item.actorAvatarUrl) { %>
                      <img
                        class="activity-avatar-image"
                        src="<%= item.actorAvatarUrl %>"
                        alt=""
                        aria-hidden="true"
                        loading="lazy"
                        referrerpolicy="no-referrer"
                        data-avatar-image
                      />
                      <span class="activity-avatar-fallback" hidden aria-hidden="true"><%= item.actorUsername ? item.actorUsername.slice(0, 1).toUpperCase() : '?' %></span>
                    <% } else { %>
                      <span class="activity-avatar-fallback" aria-hidden="true"><%= item.actorUsername ? item.actorUsername.slice(0, 1).toUpperCase() : '?' %></span>
                    <% } %>
                  </span>
                  <% if (item.actorUsername && item.eventType !== 'favorite.created') { %>
                    </a>
                  <% } %>
                  <div class="activity-event-copy">
                    <span class="activity-event-label"><%= item.eventType === 'listing.published' ? 'NEW DROP' : (item.eventType === 'comment.created' ? 'COMMUNITY COMMENT' : 'SAVED TO YOUR CRATE') %></span>
                    <span class="activity-actor">
                      <% if (item.actorUsername && item.eventType !== 'favorite.created') { %>
                        <a href="/profiles/<%= encodeURIComponent(item.actorUsername) %>">@<%= item.actorUsername %></a>
                        <%= item.eventType === 'listing.published' ? 'published a drop' : 'commented on a drop' %>
                      <% } else { %>
                        <%= item.eventDescription %>
                      <% } %>
                    </span>
                  </div>
                </div>
                <span class="activity-time"><%= item.timeAgo %></span>
              </div>

              <div class="activity-release-info">
                <a href="<%= item.listingUrl %>" class="activity-release-link">
                  <h2><%= item.releaseTitle %></h2>
                  <span class="activity-release-artist"><%= item.releaseArtist %></span>
                </a>
              </div>

              <% if (item.eventType === 'comment.created' && item.commentContent) { %>
                <div class="activity-comment">
                  <span class="activity-comment-label">COMMENT</span>
                  <blockquote><%= item.commentContent %></blockquote>
                </div>
              <% } %>

              <div class="activity-card-footer">
                <% if (item.priceFormatted) { %>
                  <span class="activity-price">
                    <%- include('../partials/icon', { name: 'price-tag', size: '0.875rem', ariaHidden: true }) %>
                    <%= item.priceFormatted %>
                  </span>
                <% } %>

                <% if (item.isPrivate) { %>
                  <span class="private-badge">
                    <%- include('../partials/icon', { name: 'save', size: '0.875rem', ariaHidden: true }) %>
                    <span>Private to you</span>
                  </span>
                <% } %>
              </div>

              <% if (typeof item.youtubeVideoId === 'string' && /^[A-Za-z0-9_-]{11}$/.test(item.youtubeVideoId)) { %>
                <section
                  class="activity-youtube-preview"
                  data-youtube-preview
                  data-video-id="<%= item.youtubeVideoId %>"
                  data-release-title="<%= item.releaseTitle %>"
                  aria-label="Listening preview for <%= item.releaseTitle %>"
                >
                  <button
                    type="button"
                    class="btn activity-youtube-load"
                    data-youtube-preview-load
                    aria-controls="activity-youtube-frame-<%= item.id %>"
                    aria-label="Play YouTube preview for <%= item.releaseTitle %> by <%= item.releaseArtist %>"
                    aria-description="Pressing Play loads YouTube and may share basic request and device information."
                  >
                    <span class="activity-play-glyph" aria-hidden="true">▶</span>
                    <span>Play preview</span>
                  </button>
                  <div
                    class="youtube-preview-frame activity-youtube-frame"
                    id="activity-youtube-frame-<%= item.id %>"
                    data-youtube-preview-frame
                    hidden
                  ></div>
                </section>
              <% } %>
            </div>

            <div class="activity-icon-badge" role="img" aria-label="<%= item.eventType === 'listing.published' ? 'New drop' : (item.eventType === 'comment.created' ? 'Comment' : 'Saved record') %>">
              <% if (item.eventType === 'listing.published') { %>
                <%- include('../partials/icon', { name: 'price-tag', size: '1.25rem', ariaHidden: true }) %>
              <% } else if (item.eventType === 'comment.created') { %>
                <%- include('../partials/icon', { name: 'talk', size: '1.25rem', ariaHidden: true }) %>
              <% } else if (item.eventType === 'favorite.created') { %>
                <%- include('../partials/icon', { name: 'save', size: '1.25rem', ariaHidden: true }) %>
              <% } %>
            </div>
          </div>
        </li>
      <% }); %>
    </ul>
    <% if (events.some(function(item) { return typeof item.youtubeVideoId === 'string' && /^[A-Za-z0-9_-]{11}$/.test(item.youtubeVideoId); })) { %>
      <script src="/js/youtube-preview.js" defer></script>
    <% } %>
  <% } else if (!error) { %>
    <div class="activity-empty-state">
      <div class="activity-empty-icon" aria-hidden="true">
        <%- include('../partials/icon', { name: 'boombox', size: '3rem', ariaHidden: true }) %>
      </div>
      <h2>No recent activity</h2>
      <p>When records are dropped, community members leave comments, or you save a record, the latest activity will show up here.</p>
      <a href="/dig" class="btn btn-primary">Explore Dig</a>
    </div>
  <% } %>
</div>
