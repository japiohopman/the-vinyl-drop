<%
  const selectedFormats = Array.isArray(filters.formats) ? filters.formats : [];
  const baseQueryParams = [
    'q=' + encodeURIComponent(filters.q || ''),
    'genre=' + encodeURIComponent(filters.genre || ''),
    'condition=' + encodeURIComponent(filters.condition || ''),
    'minPrice=' + encodeURIComponent(filters.minPrice || ''),
    'maxPrice=' + encodeURIComponent(filters.maxPrice || ''),
    'sort=' + encodeURIComponent(filters.sort || 'newest'),
    ...selectedFormats.map(function(format) { return 'format=' + encodeURIComponent(format); }),
    filters.whiteLabel ? 'whiteLabel=1' : '',
  ].filter(Boolean).join('&');
  const browseReturnUrl = '/browse?' + baseQueryParams + '&view=grid';
  const visibleItems = Array.isArray(items) ? items : [];
  const digFilterFormats = typeof formatOptions !== 'undefined' && Array.isArray(formatOptions) ? formatOptions : [];
  const digWhiteLabelAvailable = typeof whiteLabelAvailable !== 'undefined' && whiteLabelAvailable === true;
  const digActiveFilterCount = [
    filters.q,
    filters.genre,
    filters.condition,
    filters.minPrice,
    filters.maxPrice,
    filters.sort && filters.sort !== 'newest',
    selectedFormats.length > 0,
    filters.whiteLabel
  ].filter(Boolean).length;
%>

<div class="dig-page" data-dig-experience data-reduced-motion="false">
  <header class="dig-page-header">
    <div>
      <p class="dig-eyebrow">THE VINYL DROP / DIG</p>
      <h1>Dig</h1>
    </div>
    <a class="btn btn-outline dig-back-to-browse" href="<%= browseReturnUrl %>" aria-label="Back to Dig results"><span class="back-control-icon" aria-hidden="true">←</span><span class="back-control-label">Back to Dig results</span></a>
  </header>

  <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
    <div role="alert" class="alert alert-error"><%= errorMessage %></div>
  <% } %>

  <div class="dig-crate-toolbar" data-dig-crate-toolbar>
    <button
      type="button"
      class="dig-crate-filter-trigger"
      data-dig-filter-open
      aria-controls="dig-crate-filter-dialog"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-label="Open Dig filters<%= digActiveFilterCount ? ', ' + digActiveFilterCount + ' active' : '' %>"
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 5h16l-6.2 7.1v5.2l-3.6 1.8v-7z"></path>
      </svg>
      <span>Filters</span>
      <% if (digActiveFilterCount) { %><span class="dig-crate-filter-count"><%= digActiveFilterCount %></span><% } %>
    </button>
  </div>

  <% if (visibleItems.length === 0) { %>
    <section class="dig-empty-state" aria-labelledby="dig-empty-title">
      <h2 id="dig-empty-title">No records found</h2>
      <p>No available listings match these filters. Adjust the Dig filters above to try again.</p>
      <a class="btn btn-primary" href="<%= browseReturnUrl %>">Back to results</a>
    </section>
  <% } else { %>
    <div class="dig-context-row">
      <p class="dig-result-summary">
        <strong><span data-dig-position aria-live="polite" aria-atomic="true">1 of <%= visibleItems.length %></span></strong>
        <span>in this session</span>
      </p>
      <% if (hasMore) { %>
        <p class="dig-result-limit">Showing up to 100 results for these filters.</p>
      <% } %>
    </div>

    <% if (filters.q || filters.genre || filters.condition || filters.minPrice || filters.maxPrice || selectedFormats.length || filters.whiteLabel) { %>
      <p class="dig-filter-summary">
        Active filters:
        <% if (filters.q) { %><span>Search: <strong><%= filters.q %></strong></span><% } %>
        <% if (filters.genre) { %><span>Genre: <strong><%= filters.genre %></strong></span><% } %>
        <% if (filters.condition) { %><span>Condition: <strong><%= filters.condition %></strong></span><% } %>
        <% if (filters.minPrice) { %><span>Min: <strong>€<%= filters.minPrice %></strong></span><% } %>
        <% if (filters.maxPrice) { %><span>Max: <strong>€<%= filters.maxPrice %></strong></span><% } %>
        <% selectedFormats.forEach(function(format) { %><span>Format: <strong><%= format %></strong></span><% }); %>
        <% if (filters.whiteLabel) { %><span><strong>White label</strong></span><% } %>
      </p>
    <% } %>

    <section class="dig-explorer" aria-label="Crate Dig album explorer">
      <div class="dig-viewer" data-dig-viewer tabindex="0" role="region" aria-label="Crate Dig. Use the up and down arrow keys to browse records.">
        <div class="dig-crate-stack" data-dig-stack>
          <div class="dig-crate-source" data-dig-crate-source aria-hidden="true">
            <img src="/assets/UI/dig_crate.webp" alt="" draggable="false" loading="lazy" decoding="async">
          </div>
          <% visibleItems.forEach(function(item, index) { %>
            <article
              class="dig-slide <%= index === 0 ? 'is-active' : (index === 1 ? 'is-next' : (index === 0 ? 'is-previous' : '')) %>"
              data-dig-slide
              data-index="<%= index %>"
              role="group"
              aria-roledescription="slide"
              aria-label="Record <%= index + 1 %> of <%= visibleItems.length %>: <%= item.title %> by <%= item.artist %>"
              aria-hidden="<%= index === 0 ? 'false' : 'true' %>"
              <%= index === 0 ? '' : 'inert' %>
            >
              <div class="dig-listing-meta">
                <h2><%= item.title %></h2>
                <p class="dig-artist"><%= item.artist %><% if (item.releaseYear) { %> · <%= item.releaseYear %><% } %></p>
              </div>

              <div class="dig-sleeve-interaction">
                <div class="dig-sleeve-stage" data-dig-swipe-area role="group" aria-label="Album cover. Swipe left or right to flip this album between its front and back. Swipe up to discard this record and reveal the next; swipe down to restore the previous record.">
                  <div class="dig-sleeve-card" data-dig-sleeve-card>
                      <div class="dig-sleeve-face dig-sleeve-face-front" aria-hidden="false">
                        <% if (item.frontArtwork.sourceKind === 'placeholder') { %>
                          <div class="dig-missing-front" role="status">
                            <span class="dig-missing-front-mark" aria-hidden="true">▢</span>
                            <strong>Front cover not photographed</strong>
                            <p>No seller-selected front-cover photo has been added for this copy.</p>
                          </div>
                        <% } else { %>
                          <img class="dig-sleeve-image" src="<%= item.frontArtwork.src %>" alt="<%= item.frontArtwork.altText %>" draggable="false">
                        <% } %>
                      </div>
                      <div class="dig-sleeve-face dig-sleeve-face-back" aria-label="Back cover" aria-hidden="true">
                        <% if (item.backArtwork) { %>
                          <img class="dig-sleeve-image" src="<%= item.backArtwork.src %>" alt="<%= item.backArtwork.altText %>" draggable="false">
                        <% } else { %>
                          <div class="dig-missing-back" role="status">
                            <span class="dig-missing-back-mark" aria-hidden="true">↻</span>
                            <strong>Back cover not photographed</strong>
                            <p>No back-cover photo was provided for this copy.</p>
                          </div>
                        <% } %>
                      </div>
                  </div>
                </div>
              </div>

              <div class="dig-card-actions">
                <p class="dig-price">
                  <span class="dig-price-label">Price</span>
                  <strong><%= item.priceFormatted %></strong>
                  <% if (item.isTrade) { %><span class="dig-trade-note">Trade considered</span><% } %>
                </p>
                <a class="dig-listing-link" href="<%= item.url %>">Open listing <span aria-hidden="true">↗</span></a>
                <button type="button" class="dig-flip-control" data-dig-flip aria-label="Flip cover to view the back" aria-pressed="false">Flip cover</button>
              </div>
            </article>
          <% }); %>
        </div>
      </div>

      <div class="dig-navigation" aria-label="Record navigation">
        <button type="button" class="btn btn-outline dig-nav-button" data-dig-prev disabled>
          ↓ Previous record
        </button>
        <div class="dig-progress-wrap">
          <progress data-dig-progress max="<%= visibleItems.length %>" value="1" aria-label="Dig session progress"></progress>
        </div>
        <button type="button" class="btn btn-outline dig-nav-button" data-dig-next <%= visibleItems.length <= 1 ? 'disabled' : '' %>>
          Next record ↑
        </button>
      </div>

      <p class="dig-keyboard-note">Keyboard: ↑ next / discard · ↓ previous / restore · Home first · End last · F flips the cover.</p>
    </section>
  <% } %>

  <dialog class="dig-crate-filter-dialog" id="dig-crate-filter-dialog" data-dig-filter-dialog aria-labelledby="dig-crate-filter-title">
    <header class="dig-crate-filter-header">
      <div>
        <p class="dig-crate-filter-eyebrow">THE VINYL DROP / DIG</p>
        <h2 id="dig-crate-filter-title">Filter this crate</h2>
      </div>
      <button type="button" class="dig-crate-filter-close" data-dig-filter-close aria-label="Close Dig filters">×</button>
    </header>

    <form action="/dig" method="GET" class="dig-crate-filter-form" data-dig-filter-form>
      <input type="hidden" name="view" value="<%= filters.view === 'list' ? 'list' : 'grid' %>">

      <div class="dig-crate-filter-field">
        <label for="dig-filter-search">Search records</label>
        <input id="dig-filter-search" type="search" name="q" value="<%= filters.q || '' %>" placeholder="Artist, album, label, catalogue #" autocomplete="off">
      </div>

      <div class="dig-crate-filter-field">
        <label for="dig-filter-genre">Genre</label>
        <select id="dig-filter-genre" name="genre">
          <option value="">All genres</option>
          <% ['Electronic', 'Hip Hop', 'Rock', 'Jazz', 'Funk / Soul', 'Reggae', 'Ambient', 'Classical', 'Pop'].forEach(function(genre) { %>
            <option value="<%= genre %>" <%= filters.genre === genre ? 'selected' : '' %>><%= genre %></option>
          <% }); %>
        </select>
      </div>

      <fieldset class="dig-crate-filter-fieldset">
        <legend>Format</legend>
        <div class="dig-crate-format-options">
          <% digFilterFormats.forEach(function(option) { %>
            <label class="dig-crate-filter-checkbox">
              <input type="checkbox" name="format" value="<%= option.value %>" <%= selectedFormats.includes(option.value) ? 'checked' : '' %>>
              <span><%= option.label %></span>
            </label>
          <% }); %>
          <% if (digWhiteLabelAvailable) { %>
            <label class="dig-crate-filter-checkbox">
              <input type="checkbox" name="whiteLabel" value="1" <%= filters.whiteLabel ? 'checked' : '' %>>
              <span>White label</span>
            </label>
          <% } %>
        </div>
      </fieldset>

      <div class="dig-crate-filter-grid">
        <div class="dig-crate-filter-field">
          <label for="dig-filter-condition">Condition</label>
          <select id="dig-filter-condition" name="condition">
            <option value="">Any condition</option>
            <% ['M', 'NM', 'VG+', 'VG', 'VG-', 'G+', 'G', 'F', 'P'].forEach(function(condition) { %>
              <option value="<%= condition %>" <%= filters.condition === condition ? 'selected' : '' %>><%= condition %></option>
            <% }); %>
          </select>
        </div>
        <div class="dig-crate-filter-field">
          <label for="dig-filter-sort">Sort by</label>
          <select id="dig-filter-sort" name="sort">
            <option value="newest" <%= filters.sort === 'newest' || !filters.sort ? 'selected' : '' %>>Newest additions</option>
            <option value="price_asc" <%= filters.sort === 'price_asc' ? 'selected' : '' %>>Price: low to high</option>
            <option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Price: high to low</option>
            <option value="artist_asc" <%= filters.sort === 'artist_asc' ? 'selected' : '' %>>Artist: A–Z</option>
            <option value="title_asc" <%= filters.sort === 'title_asc' ? 'selected' : '' %>>Title: A–Z</option>
          </select>
        </div>
        <div class="dig-crate-filter-field">
          <label for="dig-filter-min-price">Min price (€)</label>
          <input id="dig-filter-min-price" type="number" name="minPrice" step="0.01" min="0" value="<%= filters.minPrice || '' %>" placeholder="0.00">
        </div>
        <div class="dig-crate-filter-field">
          <label for="dig-filter-max-price">Max price (€)</label>
          <input id="dig-filter-max-price" type="number" name="maxPrice" step="0.01" min="0" value="<%= filters.maxPrice || '' %>" placeholder="500.00">
        </div>
      </div>

      <footer class="dig-crate-filter-actions">
        <a class="dig-crate-filter-clear" href="/dig?view=<%= filters.view === 'list' ? 'list' : 'grid' %>">Clear all</a>
        <button type="button" class="dig-crate-filter-cancel" data-dig-filter-cancel>Cancel</button>
        <button type="submit" class="dig-crate-filter-apply">Apply filters</button>
      </footer>
    </form>
  </dialog>
</div>

<script src="/js/dig-state.js" defer></script>
<script src="/js/dig-mode.js" defer></script>
<script src="/js/dig-crate-filter.js" defer></script>
