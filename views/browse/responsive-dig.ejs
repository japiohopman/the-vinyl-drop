<%
  const selectedFormats = Array.isArray(filters.formats) ? filters.formats : [];
  const currentView = filters && filters.view === 'list' ? 'list' : 'grid';
  const currentPage = pagination && pagination.page ? pagination.page : 1;
  const buildDigViewUrl = function(view) {
    const params = [
      'q=' + encodeURIComponent(filters.q || ''),
      'genre=' + encodeURIComponent(filters.genre || ''),
      'condition=' + encodeURIComponent(filters.condition || ''),
      'minPrice=' + encodeURIComponent(filters.minPrice || ''),
      'maxPrice=' + encodeURIComponent(filters.maxPrice || ''),
      'sort=' + encodeURIComponent(filters.sort || 'newest'),
      ...selectedFormats.map(function(format) { return 'format=' + encodeURIComponent(format); }),
      filters.whiteLabel ? 'whiteLabel=1' : '',
      'page=' + encodeURIComponent(currentPage),
      'view=' + encodeURIComponent(view)
    ].filter(Boolean);
    return '/dig?' + params.join('&');
  };
%>
<div class="dig-responsive-page">

  <div class="dig-search-control-bar" role="group" aria-label="Dig search and display controls">
    <form action="/dig" method="GET" class="dig-primary-search-form">
      <input type="hidden" name="genre" value="<%= filters.genre || '' %>">
      <input type="hidden" name="condition" value="<%= filters.condition || '' %>">
      <input type="hidden" name="minPrice" value="<%= filters.minPrice || '' %>">
      <input type="hidden" name="maxPrice" value="<%= filters.maxPrice || '' %>">
      <input type="hidden" name="sort" value="<%= filters.sort || 'newest' %>">
      <% selectedFormats.forEach(function(format) { %>
        <input type="hidden" name="format" value="<%= format %>">
      <% }); %>
      <input type="hidden" name="whiteLabel" value="<%= filters.whiteLabel ? '1' : '' %>">
      <input type="hidden" name="view" value="<%= currentView %>">
      <label class="dig-search-visually-hidden" for="dig-primary-search">Search records</label>
      <input type="search" id="dig-primary-search" name="q" value="<%= filters.q || '' %>" placeholder="Artist, album, label, catalogue #">
      <button type="submit" class="btn btn-primary">Search</button>
    </form>

    <div class="view-mode-toggle" role="group" aria-label="Dig presentation mode">
      <a href="<%= buildDigViewUrl('grid') %>" class="view-toggle-btn <%= currentView === 'grid' ? 'active' : '' %>" <%- currentView === 'grid' ? 'aria-current="page"' : '' %> aria-label="Grid view">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        <span>Grid</span>
      </a>
      <a href="<%= buildDigViewUrl('list') %>" class="view-toggle-btn <%= currentView === 'list' ? 'active' : '' %>" <%- currentView === 'list' ? 'aria-current="page"' : '' %> aria-label="List view">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="8" y1="6" x2="21" y2="6"></line>
          <line x1="8" y1="12" x2="21" y2="12"></line>
          <line x1="8" y1="18" x2="21" y2="18"></line>
          <line x1="3" y1="6" x2="3.01" y2="6"></line>
          <line x1="3" y1="12" x2="3.01" y2="12"></line>
          <line x1="3" y1="18" x2="3.01" y2="18"></line>
        </svg>
        <span>List</span>
      </a>
    </div>
  </div>

  <section class="dig-responsive-desktop" aria-label="Dig grid and list results">
    <%- include('./index', {
      title,
      listings,
      formatOptions,
      whiteLabelAvailable,
      filters,
      pagination,
      errorMessage,
      responsiveDig: true
    }) %>
  </section>

  <section class="dig-responsive-mobile" aria-label="Dig crate exploration">
    <%- include('./dig', {
      title,
      items,
      totalCount,
      hasMore,
      filters,
      errorMessage
    }) %>
  </section>
</div>

<script>
  // Keep the separate top search form and filter disclosure in sync so that
  // typing a query and then applying a quick filter cannot drop either value.
  (() => {
    const searchForm = document.querySelector('.dig-primary-search-form');
    const searchInput = document.getElementById('dig-primary-search');
    const filterForm = document.querySelector('.browse-filter-form');

    if (!searchForm || !searchInput || !filterForm) return;

    const filterQuery = filterForm.querySelector('input[type="hidden"][name="q"]');
    const filterMappings = [
      { name: 'genre', selector: '#filter-genre' },
      { name: 'condition', selector: '#filter-condition' },
      { name: 'minPrice', selector: '#filter-min-price' },
      { name: 'maxPrice', selector: '#filter-max-price' },
      { name: 'sort', selector: '#filter-sort' },
    ];

    const syncQueryToFilters = () => {
      if (filterQuery) filterQuery.value = searchInput.value;
    };

    const syncFiltersToSearch = () => {
      filterMappings.forEach(({ name, selector }) => {
        const control = filterForm.querySelector(selector);
        const searchHidden = searchForm.querySelector('input[type="hidden"][name="' + name + '"]');
        if (control && searchHidden) searchHidden.value = control.value;
      });
    };

    searchInput.addEventListener('input', syncQueryToFilters);

    filterMappings.forEach(({ name, selector }) => {
      const control = filterForm.querySelector(selector);
      const searchHidden = searchForm.querySelector('input[type="hidden"][name="' + name + '"]');
      if (!control || !searchHidden) return;

      const syncField = () => { searchHidden.value = control.value; };
      control.addEventListener('input', syncField);
      control.addEventListener('change', syncField);
    });

    searchForm.addEventListener('submit', () => {
      syncQueryToFilters();
      syncFiltersToSearch();
    });
  })();
</script>
