<div class="info-page" style="max-width: 800px; margin: var(--space-8) auto; padding: 0 var(--space-4);">
  <div class="card" style="padding: var(--space-6); border: var(--border-thick); border-radius: var(--radius-md); background: var(--color-surface-card);">
    <h1 style="font-family: var(--font-display); font-size: var(--font-size-2xl); margin-bottom: var(--space-4);">Contact The Vinyl Drop</h1>

    <p style="font-size: var(--font-size-md); line-height: 1.6; margin-bottom: var(--space-6);">
      The Vinyl Drop is a free, invite-only local vinyl community site run by Jaap Hopman as a private individual, not by a company. For questions, feedback, listing concerns or privacy requests, contact him using the email address or form below.
    </p>

    <div style="padding: var(--space-4); background: var(--color-paper-muted); border: 2px dashed var(--color-border-subtle); border-radius: var(--radius-sm); margin-bottom: var(--space-6); font-family: var(--font-mono); font-size: var(--font-size-lg); text-align: center;">
      ✉️ <a href="mailto:<%= contactEmail %>" style="color: var(--color-rust-accessible); font-weight: bold;"><%= contactEmail %></a>
    </div>

    <section aria-labelledby="contact-form-title" style="margin-bottom: var(--space-8);">
      <h2 id="contact-form-title" style="font-family: var(--font-display); font-size: var(--font-size-xl); margin-bottom: var(--space-2);">Contact or report content</h2>
      <p style="font-size: var(--font-size-sm); color: var(--color-ink-muted); margin-bottom: var(--space-4);">
        Use this form for general questions, privacy requests and reports about a specific listing, profile or comment. For an illegal-content, copyright/trademark or counterfeit/fraud notice, include your name and reply email, the exact page URL, a clear explanation of why you believe the content is illegal, and the good-faith confirmation below. Do not attach or send copies of illegal material.
      </p>

      <% if (contactForm.feedback) { %>
        <div role="<%= contactForm.feedback.kind === 'success' ? 'status' : 'alert' %>" style="padding: var(--space-4); margin-bottom: var(--space-4); background: <%= contactForm.feedback.kind === 'success' ? 'var(--color-success-bg)' : 'var(--color-error-bg)' %>; border: 1px solid <%= contactForm.feedback.kind === 'success' ? 'var(--color-success-border)' : 'var(--color-error-border)' %>; border-left: 4px solid <%= contactForm.feedback.kind === 'success' ? 'var(--color-success-border)' : 'var(--color-error-border)' %>;">
          <%= contactForm.feedback.message %>
        </div>
      <% } %>

      <form action="/contact" method="POST" class="auth-form" novalidate>
        <div style="margin-bottom: var(--space-4);">
          <label for="contact-category" style="display: block; font-weight: 600; margin-bottom: var(--space-2);">What is this about?</label>
          <select id="contact-category" name="category" required style="width: 100%;">
            <option value="general" <%= contactForm.values.category === 'general' ? 'selected' : '' %>>General question or feedback</option>
            <option value="illegal-content" <%= contactForm.values.category === 'illegal-content' ? 'selected' : '' %>>Illegal content notice</option>
            <option value="copyright-trademark" <%= contactForm.values.category === 'copyright-trademark' ? 'selected' : '' %>>Copyright or trademark concern</option>
            <option value="counterfeit-or-fraud" <%= contactForm.values.category === 'counterfeit-or-fraud' ? 'selected' : '' %>>Suspected counterfeit record or fraud</option>
            <option value="community-rules" <%= contactForm.values.category === 'community-rules' ? 'selected' : '' %>>Community Rules concern</option>
            <option value="safety-concern" <%= contactForm.values.category === 'safety-concern' ? 'selected' : '' %>>Safety concern</option>
            <option value="privacy-request" <%= contactForm.values.category === 'privacy-request' ? 'selected' : '' %>>Privacy or personal-data request</option>
          </select>
          <% if (contactForm.fieldErrors.category) { %><p role="alert" style="color: var(--color-rust-accessible); font-size: var(--font-size-sm);"><%= contactForm.fieldErrors.category %></p><% } %>
        </div>

        <div style="margin-bottom: var(--space-4);">
          <label for="contact-name" style="display: block; font-weight: 600; margin-bottom: var(--space-2);">Name (required for an illegal-content notice)</label>
          <input id="contact-name" name="name" type="text" autocomplete="name" maxlength="80" placeholder="Your name" value="<%= contactForm.values.name %>" aria-invalid="<%= Boolean(contactForm.fieldErrors.name) %>" <%= contactForm.fieldErrors.name ? 'aria-describedby="contact-name-error"' : '' %> style="width: 100%;">
          <% if (contactForm.fieldErrors.name) { %><p id="contact-name-error" role="alert" style="color: var(--color-rust-accessible); font-size: var(--font-size-sm);"><%= contactForm.fieldErrors.name %></p><% } %>
        </div>

        <div style="margin-bottom: var(--space-4);">
          <label for="contact-email" style="display: block; font-weight: 600; margin-bottom: var(--space-2);">Reply email address</label>
          <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" placeholder="you@example.com" required value="<%= contactForm.values.email %>" aria-invalid="<%= Boolean(contactForm.fieldErrors.email) %>" <%= contactForm.fieldErrors.email ? 'aria-describedby="contact-email-error"' : '' %> style="width: 100%;">
          <% if (contactForm.fieldErrors.email) { %><p id="contact-email-error" role="alert" style="color: var(--color-rust-accessible); font-size: var(--font-size-sm);"><%= contactForm.fieldErrors.email %></p><% } %>
        </div>

        <div style="margin-bottom: var(--space-4);">
          <label for="contact-content-url" style="display: block; font-weight: 600; margin-bottom: var(--space-2);">Exact page URL (required for content reports)</label>
          <input id="contact-content-url" name="contentUrl" type="url" inputmode="url" maxlength="2048" placeholder="https://thevinyldrop.nl/listings/..." value="<%= contactForm.values.contentUrl %>" aria-invalid="<%= Boolean(contactForm.fieldErrors.contentUrl) %>" <%= contactForm.fieldErrors.contentUrl ? 'aria-describedby="contact-content-url-error"' : '' %> style="width: 100%;">
          <% if (contactForm.fieldErrors.contentUrl) { %><p id="contact-content-url-error" role="alert" style="color: var(--color-rust-accessible); font-size: var(--font-size-sm);"><%= contactForm.fieldErrors.contentUrl %></p><% } %>
        </div>

        <div style="margin-bottom: var(--space-4);">
          <label for="contact-message" style="display: block; font-weight: 600; margin-bottom: var(--space-2);">Details / explanation</label>
          <textarea id="contact-message" name="message" placeholder="Tell us what happened and why the item may be illegal or violate the Community Rules..." required minlength="10" maxlength="5000" rows="6" aria-invalid="<%= Boolean(contactForm.fieldErrors.message) %>" <%= contactForm.fieldErrors.message ? 'aria-describedby="contact-message-error"' : '' %> style="width: 100%; resize: vertical;"><%= contactForm.values.message %></textarea>
          <% if (contactForm.fieldErrors.message) { %><p id="contact-message-error" role="alert" style="color: var(--color-rust-accessible); font-size: var(--font-size-sm);"><%= contactForm.fieldErrors.message %></p><% } %>
        </div>

        <div style="margin-bottom: var(--space-4);">
          <label style="display: flex; align-items: flex-start; gap: var(--space-2); font-size: var(--font-size-sm); line-height: 1.5;">
            <input name="goodFaithConfirmed" type="checkbox" value="yes" <%= contactForm.values.goodFaithConfirmed === 'yes' ? 'checked' : '' %> aria-invalid="<%= Boolean(contactForm.fieldErrors.goodFaithConfirmed) %>" style="margin-top: 0.2rem;">
            <span>I believe the information and allegations in this notice are accurate and complete, and I am submitting it in good faith. Required for illegal-content, copyright/trademark and counterfeit/fraud notices.</span>
          </label>
          <% if (contactForm.fieldErrors.goodFaithConfirmed) { %><p role="alert" style="color: var(--color-rust-accessible); font-size: var(--font-size-sm);"><%= contactForm.fieldErrors.goodFaithConfirmed %></p><% } %>
        </div>

        <div aria-hidden="true" style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;">
          <label for="contact-fax-number">Leave this field empty</label>
          <input id="contact-fax-number" name="contactFaxNumber" type="text" tabindex="-1" autocomplete="off">
        </div>

        <p style="font-size: var(--font-size-sm); color: var(--color-ink-muted); margin-bottom: var(--space-4);">
          Do not include passwords, session tokens, account-recovery links or unnecessary sensitive personal information. Do not upload or email copies of illegal material. Reports are reviewed manually; there is no guaranteed response time. The form is sent through the email provider and the application does not keep a support-message history.
        </p>

        <button type="submit" class="btn btn-primary btn-md">Send message</button>
      </form>
    </section>

    <h2 style="font-family: var(--font-display); font-size: var(--font-size-lg); margin-top: var(--space-6); margin-bottom: var(--space-3);">When to contact us</h2>
    <p style="font-size: var(--font-size-sm); color: var(--color-ink-muted); margin-bottom: var(--space-3);">
      You can contact the operator about:
    </p>

    <ul style="line-height: 1.8; margin-left: var(--space-6); margin-bottom: var(--space-6);">
      <li><strong>Bugs &amp; Technical Problems:</strong> Something broken on the site? Let us know so it can be reviewed.</li>
      <li><strong>Tips &amp; Feedback:</strong> Ideas for improving the marketplace or record-digging features.</li>
      <li><strong>Errors or Bad Listings:</strong> Incorrect metadata, suspicious activity or fraudulent listings.</li>
      <li><strong>Complaints or Community Concerns:</strong> Community-rule issues, safety concerns or privacy requests.</li>
    </ul>

    <div class="info-page-actions" style="margin-top: var(--space-8); padding-top: var(--space-4); border-top: var(--border-thick); display: flex; gap: var(--space-4);">
      <a href="/community-rules" class="btn btn-outline btn-sm">Read Community Rules</a>
    </div>
  </div>
</div>
