<div class="info-page" style="max-width: 800px; margin: var(--space-8) auto; padding: 0 var(--space-4);">
  <div class="card" style="padding: var(--space-6); border: var(--border-thick); border-radius: var(--radius-md); background: var(--color-surface-card);">
    <h1 style="font-family: var(--font-display); font-size: var(--font-size-2xl); margin-bottom: var(--space-4);">Contact The Vinyl Drop</h1>

    <p style="font-size: var(--font-size-md); line-height: 1.6; margin-bottom: var(--space-6);">
      The Vinyl Drop is a free, invite-only local vinyl community site run by Jaap Hopman as a private individual, not by a company. For questions, feedback, listing concerns or privacy requests, contact him using the email address or form below.
    </p>

    <div style="padding: var(--space-4); background: var(--color-paper-muted); border: 2px dashed var(--color-border-subtle); border-radius: var(--radius-sm); margin-bottom: var(--space-6); font-family: var(--font-mono); font-size: var(--font-size-lg); text-align: center;">
      ✉️ <a href="mailto:<%= contactEmail %>" style="color: var(--color-rust-accessible); font-weight: bold;"><%= contactEmail %></a>
    </div>

    <section aria-labelledby="contact-form-title" style="margin-bottom: var(--space-8);">
      <h2 id="contact-form-title" style="font-family: var(--font-display); font-size: var(--font-size-xl); margin-bottom: var(--space-2);">Send a contact message</h2>
      <p style="font-size: var(--font-size-sm); color: var(--color-ink-muted); margin-bottom: var(--space-4);">
        Name is optional. Your email address is used only to reply, and your message is sent to the site operator through the email provider. The application does not save a support-message history.
      </p>

      <% if (contactForm.feedback) { %>
        <div class="alert <%= contactForm.feedback.kind === 'success' ? 'alert-success' : 'alert-error' %>" role="<%= contactForm.feedback.kind === 'success' ? 'status' : 'alert' %>" style="padding: var(--space-4); margin-bottom: var(--space-4);">
          <%= contactForm.feedback.message %>
        </div>
      <% } %>

      <form action="/contact" method="POST" class="auth-form" novalidate>
        <div style="margin-bottom: var(--space-4);">
          <label for="contact-name" style="display: block; font-weight: 600; margin-bottom: var(--space-2);">Name (optional)</label>
          <input id="contact-name" name="name" type="text" autocomplete="name" maxlength="80" value="<%= contactForm.values.name %>" aria-describedby="<%= contactForm.fieldErrors.name ? 'contact-name-error' : '' %>" style="width: 100%;">
          <% if (contactForm.fieldErrors.name) { %><p id="contact-name-error" role="alert" style="color: var(--color-rust-accessible); font-size: var(--font-size-sm);"><%= contactForm.fieldErrors.name %></p><% } %>
        </div>

        <div style="margin-bottom: var(--space-4);">
          <label for="contact-email" style="display: block; font-weight: 600; margin-bottom: var(--space-2);">Reply email address</label>
          <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required value="<%= contactForm.values.email %>" aria-invalid="<%= Boolean(contactForm.fieldErrors.email) %>" <%= contactForm.fieldErrors.email ? 'aria-describedby="contact-email-error"' : '' %> style="width: 100%;">
          <% if (contactForm.fieldErrors.email) { %><p id="contact-email-error" role="alert" style="color: var(--color-rust-accessible); font-size: var(--font-size-sm);"><%= contactForm.fieldErrors.email %></p><% } %>
        </div>

        <div style="margin-bottom: var(--space-4);">
          <label for="contact-message" style="display: block; font-weight: 600; margin-bottom: var(--space-2);">Message</label>
          <textarea id="contact-message" name="message" required minlength="10" maxlength="5000" rows="6" aria-invalid="<%= Boolean(contactForm.fieldErrors.message) %>" <%= contactForm.fieldErrors.message ? 'aria-describedby="contact-message-error"' : '' %> style="width: 100%; resize: vertical;"><%= contactForm.values.message %></textarea>
          <% if (contactForm.fieldErrors.message) { %><p id="contact-message-error" role="alert" style="color: var(--color-rust-accessible); font-size: var(--font-size-sm);"><%= contactForm.fieldErrors.message %></p><% } %>
        </div>

        <div aria-hidden="true" style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;">
          <label for="contact-fax-number">Leave this field empty</label>
          <input id="contact-fax-number" name="contactFaxNumber" type="text" tabindex="-1" autocomplete="off">
        </div>

        <p style="font-size: var(--font-size-sm); color: var(--color-ink-muted); margin-bottom: var(--space-4);">
          Do not include passwords, session tokens, account-recovery links, health details or other sensitive personal information. There is no guaranteed response time. If the form reports a sending problem, use the email address above instead.
        </p>

        <button type="submit" class="btn btn-primary btn-md">Send message</button>
      </form>
    </section>

    <h2 style="font-family: var(--font-display); font-size: var(--font-size-lg); margin-top: var(--space-6); margin-bottom: var(--space-3);">When to contact us</h2>
    <p style="font-size: var(--font-size-sm); color: var(--color-ink-muted); margin-bottom: var(--space-3);">
      You can contact the operator about:
    </p>

    <ul style="line-height: 1.8; margin-left: var(--space-6); margin-bottom: var(--space-6);">
      <li><strong>Bugs &amp; Technical Problems:</strong> Something broken on the site? Let us know so it can be reviewed.</li>
      <li><strong>Tips &amp; Feedback:</strong> Ideas for improving the marketplace or record-digging features.</li>
      <li><strong>Errors or Bad Listings:</strong> Incorrect metadata, suspicious activity or fraudulent listings.</li>
      <li><strong>Complaints or Community Concerns:</strong> Community-rule issues, safety concerns or privacy requests.</li>
    </ul>

    <div style="margin-top: var(--space-8); padding-top: var(--space-4); border-top: var(--border-thick); display: flex; gap: var(--space-4);">
      <a href="/community-rules" class="btn btn-outline btn-sm">Read Community Rules</a>
      <a href="/" class="btn btn-primary btn-sm">Back to Home</a>
    </div>
  </div>
</div>
