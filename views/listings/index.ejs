<div class="my-listings-page">
  <header class="my-listings-header">
    <div class="my-listings-header-copy">
      <h1 class="my-listings-title">My Listings</h1>
      <p class="my-listings-description">Manage your vinyl drops, drafts, and record trades.</p>
      <nav class="my-listings-view-tabs" aria-label="Listing views">
        <a href="/listings" class="my-listings-view-tab" <%= !viewHidden ? 'aria-current="page"' : '' %>>Visible</a>
        <a href="/listings?view=hidden" class="my-listings-view-tab" <%= viewHidden ? 'aria-current="page"' : '' %>>Hidden completed</a>
      </nav>
    </div>
    <a href="/drop/new" class="btn btn-primary btn-md my-listings-sell-cta">
      <%- include('../partials/icon', { name: 'plain-arrow', size: '1rem', ariaHidden: true }) %>
      <span>+ Sell a Record</span>
    </a>
  </header>

  <% if (listings.length === 0) { %>
    <section class="card my-listings-empty-state">
      <%- include('../partials/icon', { name: 'cardboard-box-closed', size: '2rem', ariaHidden: true }) %>
      <% if (viewHidden) { %>
        <h2 class="my-listings-empty-title">No hidden completed listings.</h2>
        <p class="my-listings-empty-description">Completed listings you dismiss will appear here and can be restored.</p>
      <% } else { %>
        <h2 class="my-listings-empty-title">No listings yet!</h2>
        <p class="my-listings-empty-description">Ready to share your vinyl collection with local collectors?</p>
        <a href="/drop/new" class="btn btn-primary btn-md my-listings-empty-cta">
          <%- include('../partials/icon', { name: 'plain-arrow', size: '1rem', ariaHidden: true }) %>
          <span>Create Your First Listing</span>
        </a>
      <% } %>
    </section>
  <% } else { %>
    <div class="my-listings-list">
      <% listings.forEach(function(item) { %>
        <%
          const sellerPhoto = (item.photos && item.photos.length > 0) ? item.photos[0] : null;
          const releaseArt = (item.release && item.release.coverArtUrl) ? item.release.coverArtUrl : null;
          const localPlaceholder = '/assets/vinyl-placeholder.svg';

          let initialSrc = localPlaceholder;
          let initialAlt = 'Default vinyl placeholder for ' + item.release.title;
          let secondarySrc = '';
          let secondaryAlt = '';

          if (sellerPhoto && sellerPhoto.publicUrl) {
            initialSrc = sellerPhoto.publicUrl;
            initialAlt = sellerPhoto.altText || ('Seller photo of ' + item.release.title + ' by ' + item.release.artist);
            if (releaseArt) {
              secondarySrc = releaseArt;
              secondaryAlt = 'Catalog cover artwork for ' + item.release.title;
            } else {
              secondarySrc = localPlaceholder;
              secondaryAlt = 'Default vinyl placeholder for ' + item.release.title;
            }
          } else if (releaseArt) {
            initialSrc = releaseArt;
            initialAlt = 'Catalog cover artwork for ' + item.release.title;
            secondarySrc = localPlaceholder;
            secondaryAlt = 'Default vinyl placeholder for ' + item.release.title;
          }
        %>
        <article class="card my-listings-card" data-listing-status="<%= item.status %>">
          <div class="my-listings-item-row">
            <div class="my-listings-thumbnail-frame">
              <img
                src="<%= initialSrc %>"
                alt="<%= initialAlt %>"
                class="my-listings-thumbnail-img"
                loading="lazy"
                referrerpolicy="no-referrer"
                data-secondary-src="<%= secondarySrc %>"
                data-secondary-alt="<%= secondaryAlt %>"
                data-placeholder="<%= localPlaceholder %>"
                data-placeholder-alt="Default vinyl placeholder for <%= item.release.title %>"
                onerror="handleMyListingsImageFallback(this)"
              />
            </div>
            <div class="my-listings-item-info">
              <div class="my-listings-badges">
                <span class="badge my-listings-status my-listings-status--<%= item.status %>">
                  <%= item.status %>
                </span>
                <% if (item.tradeAvailable) { %>
                  <span class="my-listings-trade-badge">[TRADE OK]</span>
                <% } %>
              </div>
              <h2 class="my-listings-release-title"><%= item.release.title %></h2>
              <p class="my-listings-release-meta">
                by <%= item.release.artist %> (<%= item.release.releaseYear || 'Unknown' %>) &bull; Media: <%= item.physicalCopy.mediaCondition %>, Sleeve: <%= item.physicalCopy.sleeveCondition %>
              </p>
            </div>
          </div>

          <div class="my-listings-price"><%= item.priceFormatted %></div>

          <div class="my-listings-actions" aria-label="Actions for <%= item.release.title %>">
            <a
              href="/listings/<%= item.id %>/preview"
              class="btn <%= !viewHidden && item.status !== 'published' ? 'btn-primary my-listings-action-primary' : 'btn-outline my-listings-action-secondary' %> btn-sm my-listings-action"
            >
              <%- include('../partials/icon', { name: 'search', size: '1rem', ariaHidden: true }) %>
              <span>Preview</span>
            </a>

            <% if (item.status !== 'sold' && item.status !== 'traded' && item.status !== 'archived') { %>
              <a
                href="/listings/<%= item.id %>/edit"
                class="btn <%= !viewHidden && item.status === 'published' ? 'btn-primary my-listings-action-primary' : 'btn-outline my-listings-action-secondary' %> btn-sm my-listings-action"
              >
                <%- include('../partials/icon', { name: 'edit', size: '1rem', ariaHidden: true }) %>
                <span>Edit &amp; Photos</span>
              </a>
            <% } %>

            <% if (item.status === 'draft') { %>
              <form action="/listings/<%= item.id %>/publish" method="POST" class="my-listings-action-form">
                <button type="submit" class="btn btn-outline btn-sm my-listings-action my-listings-action-secondary">
                  <%- include('../partials/icon', { name: 'confirmed', size: '1rem', ariaHidden: true }) %>
                  <span>Publish</span>
                </button>
              </form>
            <% } %>

            <% if (item.status === 'published') { %>
              <form action="/listings/<%= item.id %>/unpublish" method="POST" class="my-listings-action-form">
                <button type="submit" class="btn btn-outline btn-sm my-listings-action my-listings-action-quiet">
                  <%- include('../partials/icon', { name: 'pause-button', size: '1rem', ariaHidden: true }) %>
                  <span>Unpublish</span>
                </button>
              </form>
            <% } %>

            <% if (viewHidden) { %>
              <form action="/listings/<%= item.id %>/restore-dismissed" method="POST" class="my-listings-action-form">
                <button type="submit" class="btn btn-primary btn-sm my-listings-action my-listings-action-primary">
                  <%- include('../partials/icon', { name: 'next-button', size: '1rem', ariaHidden: true }) %>
                  <span>Restore</span>
                </button>
              </form>
            <% } else if (item.status === 'sold' || item.status === 'traded' || item.status === 'archived') { %>
              <form action="/listings/<%= item.id %>/dismiss" method="POST" class="my-listings-action-form">
                <button type="submit" class="btn btn-outline btn-sm my-listings-action my-listings-action-quiet">
                  <%- include('../partials/icon', { name: 'close', size: '1rem', ariaHidden: true }) %>
                  <span>Dismiss</span>
                </button>
              </form>
            <% } %>
          </div>
        </article>
      <% }); %>
    </div>
  <% } %>
</div>

<script>
  var myListingsTerminalFallbackIcon = <%- JSON.stringify(typeof getIconSvg === 'function' ? getIconSvg('cardboard-box-closed', { size: '1.25rem', ariaHidden: true }) : '') %>;

  function handleMyListingsImageFallback(img) {
    if (!img) return;
    var secondary = img.getAttribute('data-secondary-src');
    var secondaryAlt = img.getAttribute('data-secondary-alt');
    var placeholder = img.getAttribute('data-placeholder') || '/assets/vinyl-placeholder.svg';
    var placeholderAlt = img.getAttribute('data-placeholder-alt') || 'Default vinyl placeholder';

    if (img.src.indexOf(placeholder) !== -1) {
      renderMyListingsTerminalFallback(img);
      return;
    }

    if (secondary && secondary !== placeholder && img.src.indexOf(secondary) === -1) {
      img.onerror = function() {
        this.onerror = function() {
          renderMyListingsTerminalFallback(this);
        };
        this.src = placeholder;
        this.alt = placeholderAlt;
      };
      img.src = secondary;
      if (secondaryAlt) img.alt = secondaryAlt;
    } else {
      img.onerror = function() {
        renderMyListingsTerminalFallback(this);
      };
      img.src = placeholder;
      img.alt = placeholderAlt;
    }
  }

  function renderMyListingsTerminalFallback(img) {
    if (!img) return;
    img.onerror = null;
    img.style.display = 'none';
    var frame = img.parentElement;
    if (frame && !frame.querySelector('.my-listings-terminal-fallback')) {
      var fallback = document.createElement('div');
      fallback.className = 'my-listings-terminal-fallback';
      fallback.setAttribute('role', 'img');
      var label = img.getAttribute('data-placeholder-alt') || img.getAttribute('alt') || 'Default vinyl record placeholder';
      fallback.setAttribute('aria-label', label);
      if (myListingsTerminalFallbackIcon) {
        fallback.innerHTML = myListingsTerminalFallbackIcon;
      } else {
        fallback.textContent = 'VINYL';
      }
      frame.appendChild(fallback);
    }
  }
</script>
