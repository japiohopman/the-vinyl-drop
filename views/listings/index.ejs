<div class="listings-index-page" style="max-width: 900px; margin: var(--space-8) auto;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-6);">
    <div>
      <h1 style="font-family: var(--font-display); font-size: var(--font-size-xl); margin-bottom: var(--space-1);">My Listings</h1>
      <p style="font-family: var(--font-mono); font-size: var(--font-size-sm); color: var(--color-ink-muted);">Manage your vinyl drops, drafts, and record trades.</p>
    </div>
    <a href="/listings/new" class="btn btn-primary btn-md">+ Sell a Record</a>
  </div>

  <% if (listings.length === 0) { %>
    <div class="card" style="padding: var(--space-8); text-align: center; border: var(--border-thick); background: var(--color-surface-card);">
      <p style="font-family: var(--font-display); font-size: var(--font-size-lg); margin-bottom: var(--space-2);">No listings yet!</p>
      <p style="color: var(--color-ink-muted); margin-bottom: var(--space-4);">Ready to share your vinyl collection with local collectors?</p>
      <a href="/listings/new" class="btn btn-primary btn-md">Create Your First Listing</a>
    </div>
  <% } else { %>
    <div style="display: flex; flex-direction: column; gap: var(--space-4);">
      <% listings.forEach(function(item) { %>
        <div class="card" style="padding: var(--space-4); border: var(--border-thick); background: var(--color-surface-card); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-3);">
          <div style="flex: 1; min-width: 250px;">
            <div style="display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-1);">
              <span class="badge" style="padding: 2px 8px; border-radius: 4px; font-size: var(--font-size-xs); font-weight: bold; text-transform: uppercase; background: <%= item.status === 'published' ? 'var(--color-accent-teal)' : item.status === 'draft' ? '#f59e0b' : '#6b7280' %>; color: #fff;">
                <%= item.status %>
              </span>
              <% if (item.tradeAvailable) { %>
                <span style="font-size: var(--font-size-xs); font-family: var(--font-mono); font-weight: bold; color: var(--color-brand-primary);">[TRADE OK]</span>
              <% } %>
            </div>
            <h2 style="font-family: var(--font-heading); font-size: var(--font-size-md); margin: 0;">
              <%= item.release.title %>
            </h2>
            <p style="font-family: var(--font-mono); font-size: var(--font-size-sm); color: var(--color-ink-muted); margin: 0;">
              by <%= item.release.artist %> (<%= item.release.releaseYear || 'Unknown' %>) &bull; Media: <%= item.physicalCopy.mediaCondition %>, Sleeve: <%= item.physicalCopy.sleeveCondition %>
            </p>
          </div>

          <div style="font-family: var(--font-display); font-size: var(--font-size-md); font-weight: bold; min-width: 100px; text-align: right;">
            <%= item.priceFormatted %>
          </div>

          <div style="display: flex; gap: var(--space-2); align-items: center;">
            <a href="/listings/<%= item.id %>/preview" class="btn btn-outline btn-sm">Preview</a>
            <% if (item.status !== 'sold' && item.status !== 'traded' && item.status !== 'archived') { %>
              <a href="/listings/<%= item.id %>/edit" class="btn btn-outline btn-sm">Edit & Photos</a>
            <% } %>
            <% if (item.status === 'draft') { %>
              <form action="/listings/<%= item.id %>/publish" method="POST" style="display: inline;">
                <button type="submit" class="btn btn-primary btn-sm">Publish</button>
              </form>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>
