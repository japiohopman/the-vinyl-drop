<div class="listings-index-page" style="max-width: 900px; margin: var(--space-8) auto;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-6);">
    <div>
      <h1 style="font-family: var(--font-display); font-size: var(--font-size-xl); margin-bottom: var(--space-1);">My Listings</h1>
      <p style="font-family: var(--font-mono); font-size: var(--font-size-sm); color: var(--color-ink-muted);">Manage your vinyl drops, drafts, and record trades.</p>
      <nav aria-label="Listing views" style="display:flex;gap:var(--space-3);margin-top:var(--space-2);font-size:var(--font-size-sm);">
        <a href="/listings" <%= !viewHidden ? 'aria-current="page"' : '' %>>Visible</a>
        <a href="/listings?view=hidden" <%= viewHidden ? 'aria-current="page"' : '' %>>Hidden completed</a>
      </nav>
    </div>
    <a href="/listings/new" class="btn btn-primary btn-md">+ Sell a Record</a>
  </div>

  <% if (listings.length === 0) { %>
    <div class="card" style="padding: var(--space-8); text-align: center; border: var(--border-thick); background: var(--color-surface-card);">
      <% if (viewHidden) { %>
        <p style="font-family: var(--font-display); font-size: var(--font-size-lg); margin-bottom: var(--space-2);">No hidden completed listings.</p>
        <p style="color: var(--color-ink-muted);">Completed listings you dismiss will appear here and can be restored.</p>
      <% } else { %>
        <p style="font-family: var(--font-display); font-size: var(--font-size-lg); margin-bottom: var(--space-2);">No listings yet!</p>
      <p style="color: var(--color-ink-muted); margin-bottom: var(--space-4);">Ready to share your vinyl collection with local collectors?</p>
      <a href="/listings/new" class="btn btn-primary btn-md">Create Your First Listing</a>
      <% } %>
    </div>
  <% } else { %>
    <div style="display: flex; flex-direction: column; gap: var(--space-4);">
      <% listings.forEach(function(item) { %>
        <%
          const sellerPhoto = (item.photos && item.photos.length > 0) ? item.photos[0] : null;
          const releaseArt = (item.release && item.release.coverArtUrl) ? item.release.coverArtUrl : null;
          const localPlaceholder = '/assets/vinyl-placeholder.svg';

          let initialSrc = localPlaceholder;
          let initialAlt = 'Default vinyl placeholder for ' + item.release.title;
          let secondarySrc = '';
          let secondaryAlt = '';

          if (sellerPhoto && sellerPhoto.publicUrl) {
            initialSrc = sellerPhoto.publicUrl;
            initialAlt = sellerPhoto.altText || ('Seller photo of ' + item.release.title + ' by ' + item.release.artist);
            if (releaseArt) {
              secondarySrc = releaseArt;
              secondaryAlt = 'Catalog cover artwork for ' + item.release.title;
            } else {
              secondarySrc = localPlaceholder;
              secondaryAlt = 'Default vinyl placeholder for ' + item.release.title;
            }
          } else if (releaseArt) {
            initialSrc = releaseArt;
            initialAlt = 'Catalog cover artwork for ' + item.release.title;
            secondarySrc = localPlaceholder;
            secondaryAlt = 'Default vinyl placeholder for ' + item.release.title;
          }
        %>
        <div class="card" style="padding: var(--space-4); border: var(--border-thick); background: var(--color-surface-card); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-3);">
          <div class="my-listings-item-row">
            <div class="my-listings-thumbnail-frame">
              <img
                src="<%= initialSrc %>"
                alt="<%= initialAlt %>"
                class="my-listings-thumbnail-img"
                loading="lazy"
                referrerpolicy="no-referrer"
                data-secondary-src="<%= secondarySrc %>"
                data-secondary-alt="<%= secondaryAlt %>"
                data-placeholder="<%= localPlaceholder %>"
                data-placeholder-alt="Default vinyl placeholder for <%= item.release.title %>"
                onerror="handleMyListingsImageFallback(this)"
              />
            </div>
            <div style="flex: 1; min-width: 0;">
              <div style="display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-1);">
                <span class="badge" style="padding: 2px 8px; border-radius: 4px; font-size: var(--font-size-xs); font-weight: bold; text-transform: uppercase; background: <%= item.status === 'published' ? 'var(--color-accent-teal)' : item.status === 'draft' ? '#f59e0b' : '#6b7280' %>; color: #fff;">
                  <%= item.status %>
                </span>
                <% if (item.tradeAvailable) { %>
                  <span style="font-size: var(--font-size-xs); font-family: var(--font-mono); font-weight: bold; color: var(--color-brand-primary);">[TRADE OK]</span>
                <% } %>
              </div>
              <h2 style="font-family: var(--font-heading); font-size: var(--font-size-md); margin: 0; overflow-wrap: anywhere;">
                <%= item.release.title %>
              </h2>
              <p style="font-family: var(--font-mono); font-size: var(--font-size-sm); color: var(--color-ink-muted); margin: 0; overflow-wrap: anywhere;">
                by <%= item.release.artist %> (<%= item.release.releaseYear || 'Unknown' %>) &bull; Media: <%= item.physicalCopy.mediaCondition %>, Sleeve: <%= item.physicalCopy.sleeveCondition %>
              </p>
            </div>
          </div>

          <div style="font-family: var(--font-display); font-size: var(--font-size-md); font-weight: bold; min-width: 100px; text-align: right;">
            <%= item.priceFormatted %>
          </div>

          <div class="my-listings-actions" style="display: flex; gap: var(--space-2); align-items: center;">
            <a href="/listings/<%= item.id %>/preview" class="btn btn-outline btn-sm">Preview</a>
            <% if (item.status !== 'sold' && item.status !== 'traded' && item.status !== 'archived') { %>
              <a href="/listings/<%= item.id %>/edit" class="btn btn-outline btn-sm">Edit & Photos</a>
            <% } %>
            <% if (item.status === 'draft') { %>
              <form action="/listings/<%= item.id %>/publish" method="POST" style="display: inline;">
                <button type="submit" class="btn btn-primary btn-sm">Publish</button>
              </form>
            <% } %>
            <% if (item.status === 'published') { %>
              <form action="/listings/<%= item.id %>/unpublish" method="POST" style="display: inline;">
                <button type="submit" class="btn btn-outline btn-sm">Unpublish</button>
              </form>
            <% } %>
            <% if (viewHidden) { %>
              <form action="/listings/<%= item.id %>/restore-dismissed" method="POST" style="display: inline;">
                <button type="submit" class="btn btn-outline btn-sm">Restore</button>
              </form>
            <% } else if (item.status === 'sold' || item.status === 'traded' || item.status === 'archived') { %>
              <form action="/listings/<%= item.id %>/dismiss" method="POST" style="display: inline;">
                <button type="submit" class="btn btn-outline btn-sm">Dismiss</button>
              </form>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

<script>
  function handleMyListingsImageFallback(img) {
    if (!img) return;
    var secondary = img.getAttribute('data-secondary-src');
    var secondaryAlt = img.getAttribute('data-secondary-alt');
    var placeholder = img.getAttribute('data-placeholder') || '/assets/vinyl-placeholder.svg';
    var placeholderAlt = img.getAttribute('data-placeholder-alt') || 'Default vinyl placeholder';

    if (img.src.indexOf(placeholder) !== -1) {
      renderMyListingsTerminalFallback(img);
      return;
    }

    if (secondary && secondary !== placeholder && img.src.indexOf(secondary) === -1) {
      img.onerror = function() {
        this.onerror = function() {
          renderMyListingsTerminalFallback(this);
        };
        this.src = placeholder;
        this.alt = placeholderAlt;
      };
      img.src = secondary;
      if (secondaryAlt) img.alt = secondaryAlt;
    } else {
      img.onerror = function() {
        renderMyListingsTerminalFallback(this);
      };
      img.src = placeholder;
      img.alt = placeholderAlt;
    }
  }

  function renderMyListingsTerminalFallback(img) {
    if (!img) return;
    img.onerror = null;
    img.style.display = 'none';
    var frame = img.parentElement;
    if (frame && !frame.querySelector('.my-listings-terminal-fallback')) {
      var fallback = document.createElement('div');
      fallback.className = 'my-listings-terminal-fallback';
      fallback.setAttribute('role', 'img');
      var label = img.getAttribute('data-placeholder-alt') || img.getAttribute('alt') || 'Default vinyl record placeholder';
      fallback.setAttribute('aria-label', label);
      fallback.innerHTML = '<span aria-hidden="true" style="font-size:1.25rem;line-height:1;">🎵</span>';
      frame.appendChild(fallback);
    }
  }
</script>
