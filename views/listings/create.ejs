<div class="create-listing-page" style="max-width: 650px; margin: var(--space-8) auto;">
  <a href="/listings/new" style="font-family: var(--font-mono); font-size: var(--font-size-sm); color: var(--color-ink-muted); text-decoration: none;">&larr; Choose a different release</a>

  <div class="card" style="padding: var(--space-6); border: var(--border-thick); border-radius: var(--radius-md); background: var(--color-surface-card); margin-top: var(--space-4);">
    <h1 style="font-family: var(--font-display); font-size: var(--font-size-xl); margin-bottom: var(--space-1);">Create Listing Draft</h1>
    <div style="padding: var(--space-3); background: var(--color-surface-bg); border-radius: var(--radius-sm); margin-bottom: var(--space-6); border: 1px solid var(--color-border-subtle);">
      <h2 style="font-family: var(--font-heading); font-size: var(--font-size-md); margin: 0;"><%= release.title %></h2>
      <p style="font-family: var(--font-mono); font-size: var(--font-size-sm); color: var(--color-ink-muted); margin: 0;">by <%= release.artist %> &bull; <%= release.label || '' %> (<%= release.releaseYear || '' %>)</p>
    </div>

    <%- include('../partials/form-errors', {
      errors: form.generalErrors.length > 0
        ? form.generalErrors
        : Object.values(form.fieldErrors)
    }) %>

    <form action="/listings" method="POST" class="create-listing-form" novalidate>
      <input type="hidden" name="releaseId" value="<%= release.id %>" />

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); margin-bottom: var(--space-4);">
        <%- include('../partials/form-select', {
          name: 'mediaCondition',
          label: 'Media Condition',
          required: true,
          error: form.fieldErrors.mediaCondition,
          options: [
            { value: 'M', label: 'M (Mint)', selected: form.values.mediaCondition === 'M' },
            { value: 'NM', label: 'NM (Near Mint)', selected: form.values.mediaCondition === 'NM' || !form.values.mediaCondition },
            { value: 'VG+', label: 'VG+ (Very Good Plus)', selected: form.values.mediaCondition === 'VG+' },
            { value: 'VG', label: 'VG (Very Good)', selected: form.values.mediaCondition === 'VG' },
            { value: 'VG-', label: 'VG- (Very Good Minus)', selected: form.values.mediaCondition === 'VG-' },
            { value: 'G+', label: 'G+ (Good Plus)', selected: form.values.mediaCondition === 'G+' },
            { value: 'G', label: 'G (Good)', selected: form.values.mediaCondition === 'G' },
            { value: 'F', label: 'F (Fair)', selected: form.values.mediaCondition === 'F' },
            { value: 'P', label: 'P (Poor)', selected: form.values.mediaCondition === 'P' }
          ]
        }) %>

        <%- include('../partials/form-select', {
          name: 'sleeveCondition',
          label: 'Sleeve Condition',
          required: true,
          error: form.fieldErrors.sleeveCondition,
          options: [
            { value: 'M', label: 'M (Mint)', selected: form.values.sleeveCondition === 'M' },
            { value: 'NM', label: 'NM (Near Mint)', selected: form.values.sleeveCondition === 'NM' || !form.values.sleeveCondition },
            { value: 'VG+', label: 'VG+ (Very Good Plus)', selected: form.values.sleeveCondition === 'VG+' },
            { value: 'VG', label: 'VG (Very Good)', selected: form.values.sleeveCondition === 'VG' },
            { value: 'VG-', label: 'VG- (Very Good Minus)', selected: form.values.sleeveCondition === 'VG-' },
            { value: 'G+', label: 'G+ (Good Plus)', selected: form.values.sleeveCondition === 'G+' },
            { value: 'G', label: 'G (Good)', selected: form.values.sleeveCondition === 'G' },
            { value: 'F', label: 'F (Fair)', selected: form.values.sleeveCondition === 'F' },
            { value: 'P', label: 'P (Poor)', selected: form.values.sleeveCondition === 'P' }
          ]
        }) %>
      </div>

      <div style="margin-bottom: var(--space-4);">
        <%- include('../partials/form-input', {
          type: 'text',
          name: 'priceEur',
          label: 'Price (€ EUR)',
          value: form.values.priceEur || '',
          placeholder: 'e.g. 24.95 (leave empty for trade-only)',
          error: form.fieldErrors.priceEur,
          helpText: 'Set price in Euros. Leave blank if listing is trade-only.'
        }) %>
      </div>

      <div style="margin-bottom: var(--space-4); display: flex; align-items: center; gap: var(--space-2);">
        <input type="checkbox" id="tradeAvailable" name="tradeAvailable" value="true" <%= form.values.tradeAvailable === 'true' || form.values.tradeAvailable === true ? 'checked' : '' %> style="width: 18px; height: 18px;" />
        <label for="tradeAvailable" style="font-family: var(--font-body); font-weight: bold; font-size: var(--font-size-sm); cursor: pointer;">
          Open to trade offers
        </label>
      </div>

      <%- include('../partials/form-textarea', {
        name: 'description',
        label: 'Listing Description',
        value: form.values.description || '',
        rows: 4,
        placeholder: 'Describe play testing, audible scratches, pressing details, or trade preferences...',
        error: form.fieldErrors.description
      }) %>

      <%- include('../partials/form-textarea', {
        name: 'notes',
        label: 'Physical Record Notes (Private/Optional)',
        value: form.values.notes || '',
        rows: 2,
        placeholder: 'e.g. Cleaned with spin-cleaner on 2026-09-12...',
        error: form.fieldErrors.notes
      }) %>

      <div style="margin-top: var(--space-6); display: flex; gap: var(--space-3);">
        <%- include('../partials/button', {
          text: 'Save Draft & Continue to Photos',
          type: 'submit',
          variant: 'primary',
          size: 'md'
        }) %>
        <a href="/listings/new" class="btn btn-outline btn-md">Cancel</a>
      </div>
    </form>
  </div>
</div>
