<script>
  function renderTerminalFallback(img) {
    if (!img) return;
    img.onerror = null;
    img.style.display = 'none';
    const wrapper = img.closest('.primary-photo-wrapper') || img.parentElement;
    if (wrapper && !wrapper.querySelector('.terminal-fallback-badge')) {
      const badge = document.createElement('div');
      badge.className = 'terminal-fallback-badge';
      badge.setAttribute('role', 'img');
      badge.style.cssText = 'font-family: var(--font-mono, monospace); font-size: var(--font-size-base, 1rem); color: var(--color-ink-muted, #666); text-align: center; padding: var(--space-4, 1rem); font-weight: 700; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-2, 0.5rem); width: 100%; height: 100%; background: var(--color-paper-muted, #f4f4f0);';
      const plcAlt = img.getAttribute('data-placeholder-alt') || img.getAttribute('alt') || 'Default vinyl record placeholder';
      badge.setAttribute('aria-label', plcAlt);
      badge.innerHTML = '<span style="font-size: 2.5rem; line-height: 1;">🎵</span><span>Vinyl Record</span>';
      wrapper.appendChild(badge);
    }
  }

  function handleImageFallback(img) {
    if (!img) return;
    const sec = img.getAttribute('data-secondary-fallback');
    const secAlt = img.getAttribute('data-secondary-alt');
    const plc = img.getAttribute('data-placeholder') || '/assets/vinyl-placeholder.svg';
    const plcAlt = img.getAttribute('data-placeholder-alt');

    if (img.src.endsWith(plc) || img.src === plc) {
      renderTerminalFallback(img);
      return;
    }

    document.querySelectorAll('.thumbnail-btn').forEach(btn => {
      btn.classList.remove('selected');
      btn.setAttribute('aria-current', 'false');
    });

    if (sec && sec !== plc && !img.src.endsWith(sec) && img.src !== sec) {
      img.onerror = function() {
        this.onerror = function() {
          renderTerminalFallback(this);
        };
        this.src = plc;
        if (plcAlt) this.alt = plcAlt;
      };
      img.src = sec;
      if (secAlt) img.alt = secAlt;
    } else {
      img.onerror = function() {
        renderTerminalFallback(this);
      };
      img.src = plc;
      if (plcAlt) img.alt = plcAlt;
    }
  }
</script>

<div class="listing-detail-container">
  <nav class="breadcrumb-nav" aria-label="Breadcrumb">
    <a href="/browse" class="listing-breadcrumb">
      ← Back to Browse
    </a>
  </nav>

  <div class="listing-detail-grid">
    <!-- Left Column: Photo Gallery -->
    <% const defaultAlt = `Album cover artwork for ${release.title} by ${release.artist}`; %>
    <% const secondaryFallbackUrl = (release && release.coverArtUrl) ? release.coverArtUrl : '/assets/vinyl-placeholder.svg'; %>
    <% const secondaryFallbackAlt = (release && release.coverArtUrl) ? `Catalog cover artwork for ${release.title}` : `Default vinyl placeholder for ${release.title}`; %>
    <% const placeholderAlt = `Default vinyl placeholder for ${release.title}`; %>
    <div class="listing-gallery-section">
      <div class="primary-photo-wrapper">
        <% if (photos && photos.length > 0) { %>
          <img
            id="main-photo-img"
            src="<%= photos[0].publicUrl %>"
            alt="<%= photos[0].altText || defaultAlt %>"
            class="listing-main-photo"
            referrerpolicy="no-referrer"
            data-secondary-fallback="<%= secondaryFallbackUrl %>"
            data-secondary-alt="<%= secondaryFallbackAlt %>"
            data-placeholder="/assets/vinyl-placeholder.svg"
            data-placeholder-alt="<%= placeholderAlt %>"
            onerror="if (typeof handleImageFallback === 'function') { handleImageFallback(this); } else { this.onerror=null; this.src='/assets/vinyl-placeholder.svg'; }"
          />
        <% } else if (release && release.coverArtUrl) { %>
          <img
            id="main-photo-img"
            src="<%= release.coverArtUrl %>"
            alt="<%= defaultAlt %>"
            class="listing-main-photo"
            referrerpolicy="no-referrer"
            data-placeholder="/assets/vinyl-placeholder.svg"
            data-placeholder-alt="<%= placeholderAlt %>"
            onerror="if (typeof handleImageFallback === 'function') { handleImageFallback(this); } else if (typeof renderTerminalFallback === 'function') { renderTerminalFallback(this); } else { this.onerror=null; }"
          />
        <% } else { %>
          <img
            id="main-photo-img"
            src="/assets/vinyl-placeholder.svg"
            alt="<%= placeholderAlt %>"
            class="listing-main-photo"
            data-placeholder="/assets/vinyl-placeholder.svg"
            data-placeholder-alt="<%= placeholderAlt %>"
            onerror="if (typeof renderTerminalFallback === 'function') { renderTerminalFallback(this); } else { this.onerror=null; }"
          />
        <% } %>
      </div>

      <% if (photos && photos.length > 1) { %>
        <div class="thumbnail-list">
          <% photos.forEach(function(photo, index) { %>
            <% const thumbAlt = photo.altText || `Item photo ${index + 1} for ${release.title}`; %>
            <% const thumbUnavailableAlt = `Item photo ${index + 1} unavailable for ${release.title}`; %>
            <button
              type="button"
              class="thumbnail-btn <%= index === 0 ? 'selected' : '' %>"
              aria-current="<%= index === 0 ? 'true' : 'false' %>"
              aria-label="<%= thumbAlt %>"
              data-public-url="<%= photo.publicUrl %>"
              data-alt-text="<%= thumbAlt %>"
              data-unavailable-alt="<%= thumbUnavailableAlt %>"
              onclick="
                const mainImg = document.getElementById('main-photo-img');
                if (mainImg) {
                  mainImg.style.display = 'block';
                  const wrapper = mainImg.closest('.primary-photo-wrapper') || mainImg.parentElement;
                  if (wrapper) { const badge = wrapper.querySelector('.terminal-fallback-badge'); if (badge) badge.remove(); }
                  if (typeof handleImageFallback === 'function') { mainImg.onerror = function() { handleImageFallback(this); }; }
                  mainImg.src = this.getAttribute('data-public-url');
                  mainImg.alt = this.getAttribute('data-alt-text');
                }
                document.querySelectorAll('.thumbnail-btn').forEach(btn => { btn.classList.remove('selected'); btn.setAttribute('aria-current', 'false'); });
                this.classList.add('selected');
                this.setAttribute('aria-current', 'true');
              "

            >
              <img
                src="<%= photo.publicUrl %>"
                alt="<%= thumbAlt %>"
                class="thumbnail-image"
                data-placeholder="/assets/vinyl-placeholder.svg"
                data-unavailable-alt="<%= thumbUnavailableAlt %>"
                onerror="this.onerror=null; this.src=this.getAttribute('data-placeholder') || '/assets/vinyl-placeholder.svg'; const unAv=this.getAttribute('data-unavailable-alt'); if (unAv) { this.alt=unAv; if (this.parentElement && this.parentElement.tagName==='BUTTON') this.parentElement.setAttribute('aria-label', unAv); }"
              >
            </button>
          <% }); %>
        </div>
      <% } %>
    </div>

    <!-- Right Column: Details & Actions -->
    <div class="listing-info-section">
      <!-- Title & Release Meta -->
      <div class="release-header">
        <h1 class="listing-title">
          <%= release.title %>
        </h1>
        <p class="listing-artist">
          <%= release.artist %>
        </p>

        <div class="release-metadata">
          <% if (release.format) { %><span>Format: <strong><%= release.format %></strong></span><% } %>
          <% if (release.releaseYear) { %><span>Year: <strong><%= release.releaseYear %></strong></span><% } %>
          <% if (release.label) { %><span>Label: <strong><%= release.label %></strong></span><% } %>
          <% if (release.catalogueNumber) { %><span>Cat#: <strong><%= release.catalogueNumber %></strong></span><% } %>
          <% if (release.genre) { %><span>Genre: <strong><%= release.genre %></strong></span><% } %>
        </div>
      </div>

      <!-- Price & Status Bar -->
      <div class="price-status-card">
        <div>
          <div style="font-family: var(--font-mono); font-size: var(--font-size-2xs); text-transform: uppercase; color: var(--color-ink-muted);">Listing Price</div>
          <div style="font-family: var(--font-display); font-size: var(--font-size-2xl); font-weight: 700; color: var(--color-ink);">
            <%= priceFormatted %>
          </div>
        </div>

        <div style="display: flex; gap: var(--space-3); align-items: center; flex-wrap: wrap;">
          <% if (listing.tradeAvailable) { %>
            <span style="padding: var(--space-1) var(--space-3); font-family: var(--font-mono); font-size: var(--font-size-xs); background: var(--color-deep-green); color: var(--color-white); border-radius: var(--radius-sm); font-weight: 600;">
              Trade Open
            </span>
          <% } %>
          <span style="padding: var(--space-1) var(--space-3); font-family: var(--font-mono); font-size: var(--font-size-xs); text-transform: uppercase; background: var(--color-white); border: var(--border-thick); border-radius: var(--radius-sm); font-weight: 700;">
            <%= listing.status %>
          </span>

          <% if (currentUser && listing.status === 'published') { %>
            <% if (typeof isFavorited !== 'undefined' && isFavorited) { %>
              <form action="/listings/<%= listing.id %>/unfavorite" method="POST" style="margin: 0; display: inline;">
                <button type="submit" class="btn btn-outline btn-sm" aria-label="Remove from favorites">
                  ❤️ Saved
                </button>
              </form>
            <% } else { %>
              <form action="/listings/<%= listing.id %>/favorite" method="POST" style="margin: 0; display: inline;">
                <button type="submit" class="btn btn-primary btn-sm" aria-label="Save to favorites">
                  🤍 Favorite
                </button>
              </form>
            <% } %>
          <% } %>
        </div>
      </div>

      <!-- Message Seller Action Button for Non-Seller when Messaging Enabled -->
      <% if (currentUser && !isSeller && listing.status === 'published' && typeof messagingEnabled !== 'undefined' && messagingEnabled) { %>
        <div class="message-seller-card" style="padding: var(--space-4); border: var(--border-thick); border-radius: var(--radius-sm); background: var(--color-paper-muted); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-3);">
          <div>
            <div style="font-family: var(--font-display); font-size: var(--font-size-md); font-weight: 700;">Interested in this record?</div>
            <div style="font-family: var(--font-mono); font-size: var(--font-size-xs); color: var(--color-ink-muted);">Send a private message directly to the seller</div>
          </div>
          <form action="/messages/listing/<%= listing.id %>" method="POST" style="margin: 0;">
            <button type="submit" class="btn btn-primary">
              💬 Message Seller
            </button>
          </form>
        </div>
      <% } %>

      <!-- Condition Grades -->
      <div class="condition-section">
        <h3 style="font-family: var(--font-display); font-size: var(--font-size-md); margin-bottom: var(--space-3);">Condition Grading</h3>
        <%- include('../partials/condition-badge', { mediaCondition: physicalCopy.mediaCondition, sleeveCondition: physicalCopy.sleeveCondition, size: 'md' }) %>
        <% if (physicalCopy.notes) { %>
          <p style="margin-top: var(--space-3); font-size: var(--font-size-sm); color: var(--color-ink-muted); font-style: italic;">
            Sleeve/media copy notes: "<%= physicalCopy.notes %>"
          </p>
        <% } %>
      </div>

      <!-- Description -->
      <% if (listing.description) { %>
        <div class="description-section">
          <h3 style="font-family: var(--font-display); font-size: var(--font-size-md); margin-bottom: var(--space-2);">Seller Description</h3>
          <p style="line-height: var(--line-height-base); font-size: var(--font-size-base); white-space: pre-wrap;"><%= listing.description %></p>
        </div>
      <% } %>

      <!-- Seller Profile Summary Card -->
      <div class="seller-card" style="padding: var(--space-4); border: var(--border-thick); border-radius: var(--radius-sm); background: var(--color-white); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-4);">
        <div style="display: flex; align-items: center; gap: var(--space-4);">
          <div style="width: 48px; height: 48px; border-radius: 50%; border: var(--border-thick); overflow: hidden; background: var(--color-paper-muted); display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-size: var(--font-size-lg); flex-shrink: 0;">
            <% if (seller.avatarUrl) { %>
              <img src="<%= seller.avatarUrl %>" alt="<%= seller.displayName || seller.username %>'s avatar" style="width: 100%; height: 100%; object-fit: cover;">
            <% } else { %>
              <span><%= (seller.displayName || seller.username).substring(0, 1).toUpperCase() %></span>
            <% } %>
          </div>

          <div>
            <div style="font-weight: 700; font-family: var(--font-display); font-size: var(--font-size-base);"><%= seller.displayName || seller.username %></div>
            <div style="font-family: var(--font-mono); font-size: var(--font-size-xs); color: var(--color-ink-muted);">@<%= seller.username %></div>
            <% if (seller.location) { %>
              <div style="font-size: var(--font-size-xs); color: var(--color-ink-muted); margin-top: 2px;">📍 <%= seller.location %></div>
            <% } %>
          </div>
        </div>

        <div>
          <a href="/profiles/<%= encodeURIComponent(seller.username) %>" class="btn btn-outline btn-sm">
            View Seller Profile
          </a>
        </div>
      </div>

      <% if (isSeller) { %>
        <div class="seller-actions" style="padding: var(--space-3); border: 2px dashed var(--color-rust-accessible); border-radius: var(--radius-sm); background: var(--color-error-bg);">
          <p style="font-family: var(--font-mono); font-size: var(--font-size-xs); margin-bottom: var(--space-2); font-weight: 600; color: var(--color-rust-accessible);">
            You own this listing
          </p>
          <div style="display: flex; gap: var(--space-3);">
            <a href="/listings/<%= listing.id %>/edit" class="btn btn-primary btn-sm">Edit Listing</a>
            <a href="/listings/<%= listing.id %>/preview" class="btn btn-outline btn-sm">Preview Status</a>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Comment Thread Section -->
  <%- include('../partials/comment-thread', { listing, release, photos, seller, comments, currentUser, commentError: typeof commentError !== 'undefined' ? commentError : null, submittedContent: typeof submittedContent !== 'undefined' ? submittedContent : '' }) %>
</div>
