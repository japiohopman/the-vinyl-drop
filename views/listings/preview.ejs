<div class="listing-preview-page" style="max-width: 800px; margin: var(--space-8) auto;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4);">
    <a href="/listings" style="font-family: var(--font-mono); font-size: var(--font-size-sm); color: var(--color-ink-muted); text-decoration: none;">&larr; Back to My Listings</a>
    <span class="badge" style="padding: 4px 10px; border-radius: 4px; font-family: var(--font-mono); font-size: var(--font-size-xs); font-weight: bold; text-transform: uppercase; background: <%= listing.status === 'published' ? 'var(--color-accent-teal)' : listing.status === 'draft' ? '#f59e0b' : '#6b7280' %>; color: #fff;">
      STATUS: <%= listing.status %>
    </span>
  </div>

  <div class="card" style="padding: var(--space-6); border: var(--border-thick); border-radius: var(--radius-md); background: var(--color-surface-card);">
    <!-- Header Banner -->
    <div style="margin-bottom: var(--space-6); border-bottom: 2px solid var(--color-border-subtle); padding-bottom: var(--space-4);">
      <h1 style="font-family: var(--font-display); font-size: var(--font-size-2xl); margin-bottom: var(--space-1);"><%= release.title %></h1>
      <p style="font-family: var(--font-heading); font-size: var(--font-size-lg); color: var(--color-ink-muted); margin: 0;">
        by <%= release.artist %>
      </p>
      <p style="font-family: var(--font-mono); font-size: var(--font-size-xs); color: var(--color-ink-muted); margin-top: var(--space-2);">
        <%= release.label || 'Unknown Label' %> &bull; Cat #: <%= release.catalogueNumber || 'N/A' %> &bull; Year: <%= release.releaseYear || 'N/A' %> &bull; Format: <%= release.format || 'Vinyl' %>
      </p>
    </div>

    <!-- Photo Gallery -->
    <% if (photos && photos.length > 0) { %>
      <div style="margin-bottom: var(--space-6);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-md); margin-bottom: var(--space-3);">Photos (<%= photos.length %>)</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: var(--space-4);">
          <% photos.forEach(function(photo, index) { %>
            <div style="border: var(--border-thin); border-radius: var(--radius-sm); overflow: hidden; background: #000;">
              <img src="<%= photo.publicUrl %>" alt="<%= photo.altText || ('Photo ' + (index + 1) + ' of ' + release.title) %>" style="width: 100%; height: 200px; object-fit: cover; display: block;" />
            </div>
          <% }); %>
        </div>
      </div>
    <% } else { %>
      <div style="padding: var(--space-4); background: var(--color-surface-bg); border-radius: var(--radius-sm); margin-bottom: var(--space-6); font-family: var(--font-mono); font-size: var(--font-size-sm); color: var(--color-ink-muted); text-align: center;">
        No photos added yet. You can upload up to 5 photos in the edit page.
      </div>
    <% } %>

    <!-- Offer & Condition Details -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-4); margin-bottom: var(--space-6); padding: var(--space-4); background: var(--color-surface-bg); border-radius: var(--radius-sm); border: 1px solid var(--color-border-subtle);">
      <div>
        <span style="font-family: var(--font-mono); font-size: var(--font-size-xs); color: var(--color-ink-muted); text-transform: uppercase;">Price & Trade</span>
        <div style="font-family: var(--font-display); font-size: var(--font-size-xl); font-weight: bold; margin-top: var(--space-1);">
          <%= priceFormatted %>
        </div>
        <% if (listing.tradeAvailable) { %>
          <div style="font-family: var(--font-mono); font-size: var(--font-size-xs); color: var(--color-brand-primary); font-weight: bold; margin-top: 4px;">
            ✓ Open to record trades
          </div>
        <% } %>
      </div>

      <div>
        <span style="font-family: var(--font-mono); font-size: var(--font-size-xs); color: var(--color-ink-muted); text-transform: uppercase;">Condition Grading</span>
        <div style="font-family: var(--font-body); font-size: var(--font-size-sm); margin-top: var(--space-1);">
          <div><strong>Media:</strong> <%= physicalCopy.mediaCondition %></div>
          <div><strong>Sleeve:</strong> <%= physicalCopy.sleeveCondition %></div>
        </div>
      </div>

      <div>
        <span style="font-family: var(--font-mono); font-size: var(--font-size-xs); color: var(--color-ink-muted); text-transform: uppercase;">Seller</span>
        <div style="font-family: var(--font-body); font-size: var(--font-size-sm); margin-top: var(--space-1);">
          <div><strong>@<%= seller.username %></strong></div>
          <% if (seller.location) { %>
            <div style="font-family: var(--font-mono); font-size: var(--font-size-xs); color: var(--color-ink-muted);"><%= seller.location %></div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Description -->
    <% if (listing.description) { %>
      <div style="margin-bottom: var(--space-6);">
        <h2 style="font-family: var(--font-display); font-size: var(--font-size-md); margin-bottom: var(--space-2);">Seller Notes / Description</h2>
        <p style="font-family: var(--font-body); font-size: var(--font-size-md); line-height: 1.5; white-space: pre-line; background: #fff; padding: var(--space-4); border: var(--border-thin); border-radius: var(--radius-sm); margin: 0;">
          <%= listing.description %>
        </p>
      </div>
    <% } %>

    <!-- Actions -->
    <div style="margin-top: var(--space-8); padding-top: var(--space-4); border-top: 2px solid var(--color-border-subtle); display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center;">
      <% if (listing.status === 'draft') { %>
        <form action="/listings/<%= listing.id %>/publish" method="POST" style="display: inline;">
          <input type="hidden" name="previewConfirmed" value="true" />
          <%- include('../partials/button', {
            text: 'Publish Listing Now',
            type: 'submit',
            variant: 'primary',
            size: 'md'
          }) %>
        </form>
      <% } %>

      <% if (listing.status !== 'sold' && listing.status !== 'traded' && listing.status !== 'archived') { %>
        <a href="/listings/<%= listing.id %>/edit" class="btn btn-outline btn-md">Edit Details & Photos</a>
      <% } %>

      <% if (listing.status !== 'archived' && listing.status !== 'sold' && listing.status !== 'traded') { %>
        <form action="/listings/<%= listing.id %>/archive" method="POST" style="display: inline;">
          <button type="submit" class="btn btn-outline btn-md" style="color: #dc2626; border-color: #fca5a5;">Archive Listing</button>
        </form>
      <% } %>

      <a href="/listings" class="btn btn-outline btn-md" style="margin-left: auto;">Back to Dashboard</a>
    </div>
  </div>
</div>
