<div class="edit-listing-page" style="max-width: 750px; margin: var(--space-8) auto;">
  <div class="card edit-listing-card" style="padding: var(--space-4); border: var(--border-thick); border-radius: var(--radius-md); background: var(--color-surface-card);">
    <header class="edit-listing-header">
      <h1>Edit listing</h1>
      <a href="/listings/<%= listing.id %>/preview" class="btn btn-outline btn-sm edit-listing-preview-link">Preview <span aria-hidden="true">→</span></a>
    </header>

    <div class="edit-listing-record">
      <h2><%= release.title %></h2>
      <p>by <%= release.artist %><% if (release.releaseYear) { %> · <%= release.releaseYear %><% } %></p>
    </div>
    <section class="release-artwork-editor" aria-labelledby="releaseArtworkHeading">
      <div class="release-artwork-preview-column">
        <div class="release-artwork-preview-frame">
          <% if (release.coverArtUrl) { %>
            <img data-artwork-image src="<%= release.coverArtUrl %>" alt="Catalogue artwork for <%= release.title %> by <%= release.artist %>; release reference, not a photo of your physical copy" />
          <% } else { %>
            <div class="release-artwork-empty-state" data-release-artwork-empty>
              <%- include('../partials/icon', { name: 'photo-camera', size: '2rem', ariaHidden: true }) %>
              <span>No release artwork yet</span>
            </div>
          <% } %>
        </div>
        <span class="release-artwork-current-label"><%= release.coverArtUrl ? 'Current release artwork' : 'Artwork not added' %></span>
      </div>
      <div class="release-artwork-content">
        <span class="release-artwork-kicker">RELEASE ARTWORK</span>
        <h2 id="releaseArtworkHeading">Catalogue artwork</h2>
        <p class="release-artwork-description">This is the default front image for the release. A photo of your actual front cover takes priority on your listing; the back image is always a photo of your copy.</p>
        <p class="release-artwork-shared-note">Release artwork is shared by listings of this same release.</p>
        <% if (typeof releaseArtworkError !== 'undefined' && releaseArtworkError) { %>
          <p class="release-artwork-error" role="alert">That image could not be saved. Choose a valid JPEG, PNG or WebP image up to 5 MiB and try again.</p>
        <% } %>
        <% if (typeof releaseArtworkRestoreError !== 'undefined' && releaseArtworkRestoreError) { %>
          <p class="release-artwork-error" role="alert">Discogs artwork could not be restored. Your current release artwork has not changed.</p>
        <% } %>
        <form action="/listings/<%= encodeURIComponent(listing.id) %>/release-artwork" method="POST" enctype="multipart/form-data" class="release-artwork-upload-form">
          <p id="releaseCoverArtHelp" class="release-artwork-file-help">Add a new catalogue image or replace the current one. JPEG, PNG or WebP · max 5 MiB.</p>
          <div class="custom-release-file-picker release-artwork-file-picker">
            <input type="file" id="releaseCoverArt" name="coverArt" accept="image/jpeg,image/png,image/webp" class="custom-release-file-input" aria-describedby="releaseCoverArtHelp releaseCoverArtFilename" required />
            <label for="releaseCoverArt" class="btn btn-outline custom-release-file-trigger">
              <%- include('../partials/icon', { name: 'photo-camera', size: '1.25rem', ariaHidden: true }) %>
              <span class="release-artwork-file-mobile-label">Use this device</span>
              <span class="release-artwork-file-desktop-label">Choose file</span>
            </label>
            <span id="releaseCoverArtFilename" class="custom-release-file-name release-artwork-file-name" role="status" aria-live="polite">No replacement selected</span>
          </div>
          <div class="release-cover-override-preview" data-release-cover-override-preview hidden>
            <img src="" alt="Preview of selected replacement catalogue artwork" data-release-cover-override-image />
            <div>
              <strong>Selected replacement</strong>
              <p>This replaces the shared release artwork when saved.</p>
              <button type="button" class="btn btn-outline btn-sm" data-clear-release-cover-override>Clear selection</button>
            </div>
          </div>
          <button type="submit" class="btn btn-primary btn-md release-artwork-save-button">Save release artwork</button>
        </form>
        <% if (release.externalSource === 'discogs' && release.externalId) { %>
          <form action="/listings/<%= encodeURIComponent(listing.id) %>/release-artwork/restore-discogs" method="POST" class="release-artwork-restore-form">
            <p>Discogs is still saved as the original catalogue source for this release.</p>
            <button type="submit" class="btn btn-outline btn-md">Use original Discogs artwork</button>
          </form>
        <% } %>
      </div>
    </section>

    <%- include('../partials/form-errors', {
      errors: form.generalErrors.length > 0
        ? form.generalErrors
        : Object.values(form.fieldErrors)
    }) %>

    <section class="release-youtube-preview" aria-labelledby="releaseYoutubePreviewTitle">
      <h2 id="releaseYoutubePreviewTitle">YouTube music preview</h2>
      <p class="release-youtube-preview-scope">YouTube preview for this release — shared by all listings of this release.</p>
      <% if (typeof youtubePreviewError !== 'undefined' && youtubePreviewError) { %>
        <p class="release-youtube-preview-error" role="alert">That link was not saved. Enter a valid YouTube watch/share URL (not an embed or playlist URL), or leave the field blank to remove the current preview.</p>
      <% } %>
      <form action="/listings/<%= encodeURIComponent(listing.id) %>/release-preview" method="POST" class="release-youtube-preview-form">
        <label for="youtubePreviewUrl">YouTube preview for this release — shared by all listings of this release</label>
        <input
          type="url"
          id="youtubePreviewUrl"
          name="youtubePreviewUrl"
          maxlength="2048"
          inputmode="url"
          autocomplete="off"
          placeholder="https://youtu.be/VIDEO_ID"
          value="<%= release.youtubeVideoId ? 'https://youtu.be/' + encodeURIComponent(release.youtubeVideoId) : '' %>"
        />
        <p class="release-youtube-preview-help">Paste a normal YouTube watch or share link. Leave blank and save to remove the preview. Adding a link does not verify the recording or whether embedding is enabled.</p>
        <button type="submit" class="btn btn-outline btn-md">Save YouTube preview</button>
      </form>
    </section>

    <!-- Physical-copy photo management -->
    <section class="photos-section">
      <div class="photo-section-header">
        <div>
          <h2>Photos</h2>
          <p>Optional photos of your actual copy. Add them only when you want to show its sleeve, record or condition. Release artwork above supplies the default front image when you do not add a front photo of your copy.</p>
        </div>
        <button type="button" class="btn btn-outline btn-sm photo-help-trigger" data-open-photo-help>
          <span class="photo-help-mark" aria-hidden="true">?</span>
          <span>Help</span>
        </button>
      </div>

      <% const frontCoverPhoto = photos.find(function(photo) { return photo.role === 'front_cover'; }); %>
      <% const backCoverPhoto = photos.find(function(photo) { return photo.role === 'back_cover'; }); %>
      <% const coverSlots = [ { role: 'front_cover', label: 'Front of your copy', photo: frontCoverPhoto }, { role: 'back_cover', label: 'Back of your copy', photo: backCoverPhoto } ]; %>
      <% const displayedCoverPhotoIds = [frontCoverPhoto && frontCoverPhoto.id, backCoverPhoto && backCoverPhoto.id].filter(Boolean); %>

      <div class="cover-photo-slots">
        <% coverSlots.forEach(function(slot) { %>
          <article class="cover-photo-slot<%= slot.photo ? ' is-filled' : ' is-empty' %>" data-cover-slot="<%= slot.role %>">
            <div class="cover-photo-slot-heading">
              <%- include('../partials/icon', { name: 'photo-camera', size: '1.25rem', ariaHidden: true }) %>
              <h3><%= slot.label %></h3>
            </div>
            <% if (slot.photo) { %>
              <div class="cover-photo-preview listing-photo-card" data-photo-role="<%= slot.role %>">
                <img class="listing-photo-image" src="<%= slot.photo.publicUrl %>" alt="<%= slot.photo.altText || slot.label + ' photo' %>" />
                <p class="listing-photo-square-warning" hidden role="status"></p>
              </div>
              <p class="cover-photo-status"><span aria-hidden="true">✓</span> Photo added</p>
              <div class="cover-photo-actions">
                <button type="button" class="btn btn-outline btn-sm" data-open-existing-photo-editor
                  data-editor-source-url="/listings/<%= listing.id %>/photos/<%= slot.photo.id %>/editor-source"
                  data-photo-id="<%= slot.photo.id %>"
                  data-photo-role="<%= slot.role %>"
                  data-photo-alt-text="<%= slot.photo.altText || '' %>"
                  data-editor-state="<%= JSON.stringify(slot.photo.editorState || '') %>">
                  Edit photo
                </button>
              </div>
              <form action="/listings/<%= listing.id %>/photos/<%= slot.photo.id %>/delete" method="POST" class="cover-photo-remove-form">
                <button type="submit" class="photo-remove-link">Remove photo</button>
              </form>
            <% } else { %>
              <div class="cover-photo-empty-state">
                <%- include('../partials/icon', { name: 'photo-camera', size: '1.75rem', ariaHidden: true }) %>
                <span>No photo yet</span>
              </div>
              <% if (photos.length < 5) { %>
                <button type="button" class="btn btn-primary cover-photo-upload-button" data-open-photo-upload data-photo-role="<%= slot.role %>" data-photo-label="<%= slot.label %>">Upload <%= slot.label.toLowerCase() %></button>
              <% } else { %>
                <p class="photo-limit-note">Photo limit reached</p>
              <% } %>
            <% } %>
          </article>
        <% }); %>
      </div>

      <% if (photos.length >= 5) { %>
        <p class="photo-limit-note" role="status">You have reached the 5-photo limit. Remove a photo before adding another.</p>
      <% } %>

      <details class="additional-photos">
        <summary>Additional photos <span>Optional</span></summary>
        <p class="additional-photos-copy">Add the record, inside sleeve, inserts, or condition details.</p>

        <% const additionalPhotos = photos.filter(function(photo) { return displayedCoverPhotoIds.indexOf(photo.id) === -1; }); %>
        <% if (additionalPhotos.length > 0) { %>
          <div class="additional-photo-list">
            <% additionalPhotos.forEach(function(photo, idx) { %>
              <article class="additional-photo-card listing-photo-card" data-photo-role="<%= photo.role %>">
                <img class="listing-photo-image" src="<%= photo.publicUrl %>" alt="<%= photo.altText || 'Additional listing photo' %>" />
                <div class="additional-photo-meta">
                  <strong><%= photoRoleLabels[photo.role] || photoRoleLabels.legacy_unclassified %></strong>
                  <% if (photo.altText) { %><span><%= photo.altText %></span><% } %>
                  <button type="button" class="btn btn-outline btn-sm" data-open-existing-photo-editor
                    data-editor-source-url="/listings/<%= listing.id %>/photos/<%= photo.id %>/editor-source"
                    data-photo-id="<%= photo.id %>"
                    data-photo-role="<%= photo.role %>"
                    data-photo-alt-text="<%= photo.altText || '' %>"
                    data-editor-state="<%= JSON.stringify(photo.editorState || '') %>">
                    Edit photo
                  </button>
                  <form action="/listings/<%= listing.id %>/photos/<%= photo.id %>/role" method="POST" class="additional-photo-role-form">
                    <label for="photo-role-<%= idx %>">Photo type</label>
                    <select id="photo-role-<%= idx %>" name="role" required class="form-control">
                      <% photoRoles.forEach(function(role) { %>
                        <option value="<%= role %>" <%= role === photo.role ? 'selected' : '' %>><%= photoRoleLabels[role] %></option>
                      <% }); %>
                    </select>
                    <button type="submit" class="btn btn-outline btn-sm">Save type</button>
                  </form>
                  <form action="/listings/<%= listing.id %>/photos/<%= photo.id %>/delete" method="POST">
                    <button type="submit" class="photo-remove-link">Remove photo</button>
                  </form>
                </div>
              </article>
            <% }); %>
          </div>
        <% } else { %>
          <p class="additional-photos-empty">No additional photos yet.</p>
        <% } %>

        <% if (photos.length < 5) { %>
          <button type="button" class="btn btn-outline additional-photo-add-button" data-open-photo-upload data-photo-role="optional" data-photo-label="Additional photo">
            <%- include('../partials/icon', { name: 'photo-camera', size: '1rem', ariaHidden: true }) %>
            Add another photo
          </button>
        <% } %>
      </details>

      <dialog id="photoUploadDialog" class="photo-dialog" aria-labelledby="photoUploadTitle" data-open-on-load="<%= photoError ? 'true' : 'false' %>">
        <div class="photo-dialog-header">
          <h2 id="photoUploadTitle">Upload a photo</h2>
          <button type="button" class="photo-dialog-close" data-close-photo-upload aria-label="Close upload dialog">×</button>
        </div>
        <% if (photoError) { %>
          <p role="alert" class="photo-dialog-error"><%= photoError %></p>
        <% } %>
        <form id="photoUploadForm" action="/listings/<%= listing.id %>/photos" data-new-action="/listings/<%= listing.id %>/photos" method="POST" enctype="multipart/form-data" class="photo-upload-form">
            <div class="photo-upload-field photo-role-field">
              <label for="newPhotoRole">Photo type</label>
              <select id="newPhotoRole" name="role" required class="form-control">
                <option value="">Choose a photo type</option>
                <% newPhotoRoles.forEach(function(role) { %>
                  <option value="<%= role %>" data-guidance="<%= photoRoleGuidance[role] %>"><%= photoRoleLabels[role] %></option>
                <% }); %>
              </select>
            </div>
            <p id="photo-role-guidance" role="status" aria-live="polite" class="photo-role-guidance">Choose what the photo shows.</p>

            <div class="photo-upload-field">
              <span class="photo-upload-label">Photo file</span>
              <input type="file" id="photoFile" name="photo" accept="image/jpeg,image/png,image/webp" required class="photo-file-input" aria-describedby="photoFileHelp selected-photo-info" />
              <input type="file" id="photoOriginalFile" name="originalPhoto" accept="image/jpeg,image/png,image/webp" hidden />
              <input type="hidden" id="photoEditorState" name="editorState" value="" />
              <input type="file" id="photoCameraInput" accept="image/jpeg,image/png,image/webp" capture="environment" class="photo-file-input" tabindex="-1" aria-label="Take a picture with the rear camera" />
              <div class="photo-file-actions" data-photo-file-actions>
                <label for="photoFile" class="btn btn-outline photo-file-trigger" tabindex="-1">
                  <%- include('../partials/icon', { name: 'photo-camera', size: '1.125rem', ariaHidden: true }) %>
                  <span>Choose photo</span>
                </label>
                <button type="button" class="btn btn-outline photo-file-trigger photo-camera-trigger" data-photo-camera-trigger hidden>
                  <%- include('../partials/icon', { name: 'photo-camera', size: '1.125rem', ariaHidden: true }) %>
                  <span>Take picture</span>
                </button>
              </div>
              <span id="photoFileHelp" class="photo-file-help">JPEG, PNG or WebP · max 5 MiB</span>
            </div>

            <div id="photo-selection-preview" class="photo-selection-preview" hidden>
              <p id="selected-photo-info" role="status" aria-live="polite"></p>
              <img id="photo-original-preview" alt="Preview of the selected photo" hidden />
            </div>

            <div id="square-cover-cropper" class="square-cover-cropper" hidden>
              <div class="square-cover-intro">
                <div>
                  <strong id="square-cover-title">Square cover correction</strong>
                  <span id="square-cover-description">Place the four corners on the sleeve edges to flatten the photo into a clean square.</span>
                </div>
                <span class="square-cover-editor-tag">DARKROOM / 01</span>
              </div>

              <div class="square-cover-workflow">
                <section class="square-cover-stage-panel square-cover-detect-panel" aria-labelledby="square-cover-detect-title">
                  <header class="square-cover-stage-header">
                    <div>
                      <p class="square-cover-panel-label">01 — EDGE DETECT</p>
                      <h3 id="square-cover-detect-title">Find all four sleeve edges</h3>
                    </div>
                    <span class="square-cover-stage-tag">ON DEVICE</span>
                  </header>
                  <div id="square-cover-detect-stage" class="square-cover-detect-stage">
                    <canvas id="square-cover-detect-image" aria-label="Original photo with the suggested four sleeve edges"></canvas>
                    <svg id="square-cover-detect-overlay" class="square-cover-detect-overlay" viewBox="0 0 1 1" aria-hidden="true">
                      <polygon id="square-cover-detect-polygon" class="square-cover-detect-polygon" points=""></polygon>
                      <circle data-detected-corner="0" class="square-cover-detection-corner" r="7" display="none"></circle>
                      <circle data-detected-corner="1" class="square-cover-detection-corner" r="7" display="none"></circle>
                      <circle data-detected-corner="2" class="square-cover-detection-corner" r="7" display="none"></circle>
                      <circle data-detected-corner="3" class="square-cover-detection-corner" r="7" display="none"></circle>
                    </svg>
                  </div>
                  <p id="square-cover-detection-status" class="square-cover-detection-status" role="status" aria-live="polite">Choose a front or back cover photo to suggest its four sleeve edges on this device.</p>
                  <p class="square-cover-detection-legend">TOP · RIGHT · BOTTOM · LEFT — check every side before saving</p>
                </section>

                <section class="square-cover-stage-panel square-cover-result-panel" aria-labelledby="square-cover-preview-title">
                  <header class="square-cover-stage-header">
                    <div>
                      <p class="square-cover-panel-label">02 — PREVIEW WINDOW</p>
                      <h3 id="square-cover-preview-title">See the corrected sleeve</h3>
                    </div>
                  </header>
                  <canvas id="square-cover-result" aria-label="Pixel-corrected sleeve preview" width="512" height="512"></canvas>
                  <button type="button" class="square-cover-before-after" data-toggle-photo-before-after aria-pressed="false">Show before</button>
                </section>

                <section class="square-cover-stage-panel square-cover-source-panel" aria-labelledby="square-cover-point-title">
                  <header class="square-cover-stage-header">
                    <div>
                      <p class="square-cover-panel-label">03 — POINT EDITOR</p>
                      <h3 id="square-cover-point-title">Fine-tune each corner</h3>
                    </div>
                    <span class="square-cover-stage-tag">4 POINTS</span>
                  </header>
                  <div id="square-cover-source-stage" class="square-cover-source-stage">
                    <canvas id="square-cover-source" aria-label="Photo with four independently adjustable sleeve corners"></canvas>
                    <svg id="square-cover-overlay" class="square-cover-overlay" viewBox="0 0 1 1" aria-hidden="true">
                      <path id="square-cover-shade" class="square-cover-shade" fill-rule="evenodd" d=""></path>
                      <polygon id="square-cover-polygon" class="square-cover-polygon" points=""></polygon>
                    </svg>
                    <button type="button" class="square-cover-handle" data-corner-handle="0" aria-label="Adjust top-left sleeve corner" disabled></button>
                    <button type="button" class="square-cover-handle" data-corner-handle="1" aria-label="Adjust top-right sleeve corner" disabled></button>
                    <button type="button" class="square-cover-handle" data-corner-handle="2" aria-label="Adjust bottom-right sleeve corner" disabled></button>
                    <button type="button" class="square-cover-handle" data-corner-handle="3" aria-label="Adjust bottom-left sleeve corner" disabled></button>
                  </div>
                  <div id="square-cover-magnifier" class="square-cover-magnifier" hidden>
                    <canvas id="square-cover-magnifier-canvas" width="112" height="112" aria-hidden="true"></canvas>
                    <span>2× detail follows the active corner</span>
                  </div>
                  <p class="square-cover-help">Move all four points independently. Drag a corner, or focus it and use the arrow keys; hold Shift for larger steps.</p>
                </section>
              </div>

              <section class="square-cover-tone-panel" aria-labelledby="square-cover-frame-title">
                <header class="square-cover-tone-header">
                  <div>
                    <p class="square-cover-panel-label">03 — FRAME REFINEMENT</p>
                    <h3 id="square-cover-frame-title">Rotate, zoom &amp; position</h3>
                  </div>
                </header>
                <details class="square-cover-adjustments">
                  <summary>Fine-tune the photo framing <span>Corner handles remain available</span></summary>
                  <div class="square-cover-adjustment-grid">
                    <label class="square-cover-adjustment" for="photo-frame-rotation">
                      <span>Straighten</span>
                      <output data-photo-frame-value="rotation">0°</output>
                      <input id="photo-frame-rotation" type="range" min="-15" max="15" value="0" step="0.1" data-photo-frame="rotation" />
                    </label>
                    <label class="square-cover-adjustment" for="photo-frame-zoom">
                      <span>Zoom</span>
                      <output data-photo-frame-value="zoom">100%</output>
                      <input id="photo-frame-zoom" type="range" min="80" max="130" value="100" step="1" data-photo-frame="zoom" />
                    </label>
                    <label class="square-cover-adjustment" for="photo-frame-offset-x">
                      <span>Move horizontally</span>
                      <output data-photo-frame-value="offsetX">0%</output>
                      <input id="photo-frame-offset-x" type="range" min="-3" max="3" value="0" step="0.5" data-photo-frame="offsetX" />
                    </label>
                    <label class="square-cover-adjustment" for="photo-frame-offset-y">
                      <span>Move vertically</span>
                      <output data-photo-frame-value="offsetY">0%</output>
                      <input id="photo-frame-offset-y" type="range" min="-3" max="3" value="0" step="0.5" data-photo-frame="offsetY" />
                    </label>
                  </div>
                </details>
              </section>

              <section class="square-cover-tone-panel" aria-labelledby="square-cover-tone-title">
                <header class="square-cover-tone-header">
                  <div>
                    <p class="square-cover-panel-label">04 — DARKROOM CONTROLS</p>
                    <h3 id="square-cover-tone-title">Light &amp; colour</h3>
                  </div>
                  <div class="square-cover-history-actions" aria-label="Photo edit history">
                    <button type="button" data-photo-editor-undo disabled>Undo</button>
                    <button type="button" data-photo-editor-redo disabled>Redo</button>
                    <button type="button" data-photo-editor-reset>Reset</button>
                  </div>
                </header>

                <div class="square-cover-histogram-wrap">
                  <canvas id="square-cover-histogram" width="288" height="64" aria-label="Live image luminance histogram"></canvas>
                  <span>SHADOWS <span aria-hidden="true">←</span> MIDTONES <span aria-hidden="true">→</span> HIGHLIGHTS</span>
                </div>

                <details class="square-cover-adjustments">
                  <summary>Fine-tune tonal and colour controls <span>Neutral by default</span></summary>
                  <div class="square-cover-adjustment-grid">
                    <label class="square-cover-adjustment" for="photo-adjust-exposure">
                      <span>Exposure</span>
                      <output data-photo-adjustment-value="exposure">0.0 EV</output>
                      <input id="photo-adjust-exposure" type="range" min="-100" max="100" value="0" step="1" data-photo-adjustment="exposure" />
                    </label>
                    <label class="square-cover-adjustment" for="photo-adjust-blackPoint">
                      <span>Black point</span>
                      <output data-photo-adjustment-value="blackPoint">0</output>
                      <input id="photo-adjust-blackPoint" type="range" min="0" max="60" value="0" step="1" data-photo-adjustment="blackPoint" />
                    </label>
                    <label class="square-cover-adjustment" for="photo-adjust-shadows">
                      <span>Shadows</span>
                      <output data-photo-adjustment-value="shadows">0</output>
                      <input id="photo-adjust-shadows" type="range" min="-100" max="100" value="0" step="1" data-photo-adjustment="shadows" />
                    </label>
                    <label class="square-cover-adjustment" for="photo-adjust-contrast">
                      <span>Contrast</span>
                      <output data-photo-adjustment-value="contrast">0</output>
                      <input id="photo-adjust-contrast" type="range" min="-100" max="100" value="0" step="1" data-photo-adjustment="contrast" />
                    </label>
                    <label class="square-cover-adjustment" for="photo-adjust-highlights">
                      <span>Highlights</span>
                      <output data-photo-adjustment-value="highlights">0</output>
                      <input id="photo-adjust-highlights" type="range" min="-100" max="100" value="0" step="1" data-photo-adjustment="highlights" />
                    </label>
                    <label class="square-cover-adjustment" for="photo-adjust-whitePoint">
                      <span>White point</span>
                      <output data-photo-adjustment-value="whitePoint">255</output>
                      <input id="photo-adjust-whitePoint" type="range" min="195" max="255" value="255" step="1" data-photo-adjustment="whitePoint" />
                    </label>
                    <label class="square-cover-adjustment" for="photo-adjust-gamma">
                      <span>Midtones / gamma</span>
                      <output data-photo-adjustment-value="gamma">1.00</output>
                      <input id="photo-adjust-gamma" type="range" min="50" max="200" value="100" step="1" data-photo-adjustment="gamma" />
                    </label>
                    <label class="square-cover-adjustment" for="photo-adjust-temperature">
                      <span>Temperature</span>
                      <output data-photo-adjustment-value="temperature">0</output>
                      <input id="photo-adjust-temperature" type="range" min="-100" max="100" value="0" step="1" data-photo-adjustment="temperature" />
                    </label>
                    <label class="square-cover-adjustment" for="photo-adjust-tint">
                      <span>Tint</span>
                      <output data-photo-adjustment-value="tint">0</output>
                      <input id="photo-adjust-tint" type="range" min="-100" max="100" value="0" step="1" data-photo-adjustment="tint" />
                    </label>
                    <label class="square-cover-adjustment" for="photo-adjust-saturation">
                      <span>Saturation</span>
                      <output data-photo-adjustment-value="saturation">0</output>
                      <input id="photo-adjust-saturation" type="range" min="-100" max="100" value="0" step="1" data-photo-adjustment="saturation" />
                    </label>
                  </div>
                </details>
              </section>

              <p id="photo-editor-source-notice" class="photo-role-guidance" role="status" hidden></p>
              <p id="square-cover-status" role="status" aria-live="polite" class="square-cover-status">Place each corner on the sleeve edge before uploading.</p>
            </div>

            <div class="photo-upload-field">
              <label for="altText">Alt text <span>(describe what is visible)</span></label>
              <input type="text" id="altText" name="altText" placeholder="Describe what is visible, e.g. a crease or Side A label" required maxlength="250" />
            </div>

            <div class="photo-dialog-actions">
              <button type="button" class="btn btn-outline" data-close-photo-upload>Cancel</button>
              <button type="submit" class="btn btn-primary">Upload photo</button>
            </div>
          </form>
      </dialog>

      <dialog id="photoHelpDialog" class="photo-dialog photo-help-dialog" aria-labelledby="photoHelpTitle">
        <div class="photo-dialog-header">
          <h2 id="photoHelpTitle">Photo help</h2>
          <button type="button" class="photo-dialog-close" data-close-photo-help aria-label="Close photo help">×</button>
        </div>
        <ul class="photo-help-list">
          <li>Use the front and back slots for the two sides of the actual sleeve.</li>
          <li>For covers, keep the whole sleeve visible in the square crop. The preview is what Crate Dig will show.</li>
          <li>Use Additional photos for the record, label, inserts, or visible wear.</li>
          <li>Upload JPEG, PNG, or WebP images up to 5 MiB each. You can add up to five photos.</li>
          <li>Describe important visible details in the alt text. Avoid glare and do not hide damage.</li>
        </ul>
        <div class="photo-dialog-actions">
          <button type="button" class="btn btn-primary" data-close-photo-help>Got it</button>
        </div>
      </dialog>
    </section>

    <!-- Details Update Form -->
    <form action="/listings/<%= listing.id %>/edit" method="POST" class="edit-listing-form" novalidate>
      <h2 style="font-family: var(--font-display); font-size: var(--font-size-lg); margin-bottom: var(--space-4);">Listing Details</h2>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); margin-bottom: var(--space-4);">
        <%- include('../partials/form-select', {
          name: 'mediaCondition',
          label: 'Media Condition',
          required: true,
          error: form.fieldErrors.mediaCondition,
          options: [
            { value: 'M', label: 'M (Mint)', selected: physicalCopy.mediaCondition === 'M' },
            { value: 'NM', label: 'NM (Near Mint)', selected: physicalCopy.mediaCondition === 'NM' },
            { value: 'VG+', label: 'VG+ (Very Good Plus)', selected: physicalCopy.mediaCondition === 'VG+' },
            { value: 'VG', label: 'VG (Very Good)', selected: physicalCopy.mediaCondition === 'VG' },
            { value: 'VG-', label: 'VG- (Very Good Minus)', selected: physicalCopy.mediaCondition === 'VG-' },
            { value: 'G+', label: 'G+ (Good Plus)', selected: physicalCopy.mediaCondition === 'G+' },
            { value: 'G', label: 'G (Good)', selected: physicalCopy.mediaCondition === 'G' },
            { value: 'F', label: 'F (Fair)', selected: physicalCopy.mediaCondition === 'F' },
            { value: 'P', label: 'P (Poor)', selected: physicalCopy.mediaCondition === 'P' }
          ]
        }) %>

        <%- include('../partials/form-select', {
          name: 'sleeveCondition',
          label: 'Sleeve Condition',
          required: true,
          error: form.fieldErrors.sleeveCondition,
          options: [
            { value: 'M', label: 'M (Mint)', selected: physicalCopy.sleeveCondition === 'M' },
            { value: 'NM', label: 'NM (Near Mint)', selected: physicalCopy.sleeveCondition === 'NM' },
            { value: 'VG+', label: 'VG+ (Very Good Plus)', selected: physicalCopy.sleeveCondition === 'VG+' },
            { value: 'VG', label: 'VG (Very Good)', selected: physicalCopy.sleeveCondition === 'VG' },
            { value: 'VG-', label: 'VG- (Very Good Minus)', selected: physicalCopy.sleeveCondition === 'VG-' },
            { value: 'G+', label: 'G+ (Good Plus)', selected: physicalCopy.sleeveCondition === 'G+' },
            { value: 'G', label: 'G (Good)', selected: physicalCopy.sleeveCondition === 'G' },
            { value: 'F', label: 'F (Fair)', selected: physicalCopy.sleeveCondition === 'F' },
            { value: 'P', label: 'P (Poor)', selected: physicalCopy.sleeveCondition === 'P' }
          ]
        }) %>
      </div>

      <div style="margin-bottom: var(--space-4);">
        <%- include('../partials/form-input', {
          type: 'text',
          name: 'priceEur',
          label: 'Price (€ EUR)',
          value: form.values.priceEur !== undefined ? form.values.priceEur : (listing.price !== null ? (listing.price / 100).toFixed(2) : ''),
          placeholder: 'e.g. 24.95',
          error: form.fieldErrors.priceEur
        }) %>
      </div>

      <div style="margin-bottom: var(--space-4); display: flex; align-items: center; gap: var(--space-2);">
        <input type="checkbox" id="tradeAvailable" name="tradeAvailable" value="true" <%= (form.values.tradeAvailable === 'true' || form.values.tradeAvailable === true || (form.values.tradeAvailable === undefined && listing.tradeAvailable)) ? 'checked' : '' %> style="width: 18px; height: 18px;" />
        <label for="tradeAvailable" style="font-family: var(--font-body); font-weight: bold; font-size: var(--font-size-sm); cursor: pointer;">
          Open to trade offers
        </label>
      </div>

      <%- include('../partials/form-textarea', {
        name: 'description',
        label: 'Listing Description',
        value: form.values.description !== undefined ? form.values.description : (listing.description || ''),
        rows: 4,
        error: form.fieldErrors.description
      }) %>

      <%- include('../partials/form-textarea', {
        name: 'notes',
        label: 'Physical Record Notes',
        value: form.values.notes !== undefined ? form.values.notes : (physicalCopy.notes || ''),
        rows: 2,
        error: form.fieldErrors.notes
      }) %>

      <div style="margin-top: var(--space-6); display: flex; gap: var(--space-3);">
        <%- include('../partials/button', {
          text: 'Save Details',
          type: 'submit',
          variant: 'primary',
          size: 'md'
        }) %>
        <a href="/listings/<%= listing.id %>/preview" class="btn btn-outline btn-md">Preview Listing</a>
      </div>
    </form>
  </div>
  <script src="/js/release-file-picker.js" defer></script>
  <script src="/js/listing-photo-editor-core.js" defer></script>
  <script src="/js/square-photo-cropper.js" defer></script>
</div>
