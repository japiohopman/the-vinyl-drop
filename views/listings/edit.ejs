<div class="edit-listing-page" style="max-width: 750px; margin: var(--space-8) auto;">
  <div class="card edit-listing-card" style="padding: var(--space-4); border: var(--border-thick); border-radius: var(--radius-md); background: var(--color-surface-card);">
    <header class="edit-listing-header">
      <a href="/listings" class="mobile-back-control" aria-label="Back to My Listings"><span class="back-control-icon" aria-hidden="true">←</span><span class="back-control-label">Back to My Listings</span></a>
      <h1>Edit listing</h1>
      <a href="/listings/<%= listing.id %>/preview" class="btn btn-outline btn-sm edit-listing-preview-link">Preview <span aria-hidden="true">→</span></a>
    </header>

    <div class="edit-listing-record">
      <h2><%= release.title %></h2>
      <p>by <%= release.artist %><% if (release.releaseYear) { %> · <%= release.releaseYear %><% } %></p>
    </div>
      <h2 style="font-family: var(--font-heading); font-size: var(--font-size-md); margin: 0;"><%= release.title %></h2>
      <p style="font-family: var(--font-mono); font-size: var(--font-size-sm); color: var(--color-ink-muted); margin: 0;">by <%= release.artist %> (<%= release.releaseYear || '' %>)</p>
    </div>

    <%- include('../partials/form-errors', {
      errors: form.generalErrors.length > 0
        ? form.generalErrors
        : Object.values(form.fieldErrors)
    }) %>

    <!-- Physical-copy photo management -->
    <section class="photos-section">
      <div class="photo-section-header">
        <div>
          <h2>Photos</h2>
          <p>Show the exact copy you are selling.</p>
        </div>
        <button type="button" class="btn btn-outline btn-sm photo-help-trigger" data-open-photo-help>
          <span class="photo-help-mark" aria-hidden="true">?</span>
          <span>Help</span>
        </button>
      </div>

      <% const frontCoverPhoto = photos.find(function(photo) { return photo.role === 'front_cover'; }); %>
      <% const backCoverPhoto = photos.find(function(photo) { return photo.role === 'back_cover'; }); %>
      <% const coverSlots = [ { role: 'front_cover', label: 'Front cover', photo: frontCoverPhoto }, { role: 'back_cover', label: 'Back cover', photo: backCoverPhoto } ]; %>

      <div class="cover-photo-slots">
        <% coverSlots.forEach(function(slot) { %>
          <article class="cover-photo-slot<%= slot.photo ? ' is-filled' : ' is-empty' %>" data-cover-slot="<%= slot.role %>">
            <div class="cover-photo-slot-heading">
              <%- include('../partials/icon', { name: 'photo-camera', size: '1.25rem', ariaHidden: true }) %>
              <h3><%= slot.label %></h3>
            </div>
            <% if (slot.photo) { %>
              <div class="cover-photo-preview listing-photo-card" data-photo-role="<%= slot.role %>">
                <img class="listing-photo-image" src="<%= slot.photo.publicUrl %>" alt="<%= slot.photo.altText || slot.label + ' photo' %>" />
                <p class="listing-photo-square-warning" hidden role="status"></p>
              </div>
              <p class="cover-photo-status"><span aria-hidden="true">✓</span> Photo added</p>
              <form action="/listings/<%= listing.id %>/photos/<%= slot.photo.id %>/delete" method="POST" class="cover-photo-remove-form">
                <button type="submit" class="photo-remove-link">Remove photo</button>
              </form>
            <% } else { %>
              <div class="cover-photo-empty-state">
                <%- include('../partials/icon', { name: 'photo-camera', size: '1.75rem', ariaHidden: true }) %>
                <span>No photo yet</span>
              </div>
              <% if (photos.length < 5) { %>
                <button type="button" class="btn btn-primary cover-photo-upload-button" data-open-photo-upload data-photo-role="<%= slot.role %>" data-photo-label="<%= slot.label %>">Upload <%= slot.label.toLowerCase() %></button>
              <% } else { %>
                <p class="photo-limit-note">Photo limit reached</p>
              <% } %>
            <% } %>
          </article>
        <% }); %>
      </div>

      <% if (photos.length >= 5) { %>
        <p class="photo-limit-note" role="status">You have reached the 5-photo limit. Remove a photo before adding another.</p>
      <% } %>

      <details class="additional-photos">
        <summary>Additional photos <span>Optional</span></summary>
        <p class="additional-photos-copy">Add the record, inside sleeve, inserts, or condition details.</p>

        <% const additionalPhotos = photos.filter(function(photo) { return photo.role !== 'front_cover' && photo.role !== 'back_cover'; }); %>
        <% if (additionalPhotos.length > 0) { %>
          <div class="additional-photo-list">
            <% additionalPhotos.forEach(function(photo, idx) { %>
              <article class="additional-photo-card listing-photo-card" data-photo-role="<%= photo.role %>">
                <img class="listing-photo-image" src="<%= photo.publicUrl %>" alt="<%= photo.altText || 'Additional listing photo' %>" />
                <div class="additional-photo-meta">
                  <strong><%= photoRoleLabels[photo.role] || photoRoleLabels.legacy_unclassified %></strong>
                  <% if (photo.altText) { %><span><%= photo.altText %></span><% } %>
                  <form action="/listings/<%= listing.id %>/photos/<%= photo.id %>/role" method="POST" class="additional-photo-role-form">
                    <label for="photo-role-<%= idx %>">Photo type</label>
                    <select id="photo-role-<%= idx %>" name="role" required class="form-control">
                      <% photoRoles.forEach(function(role) { %>
                        <option value="<%= role %>" <%= role === photo.role ? 'selected' : '' %>><%= photoRoleLabels[role] %></option>
                      <% }); %>
                    </select>
                    <button type="submit" class="btn btn-outline btn-sm">Save type</button>
                  </form>
                  <form action="/listings/<%= listing.id %>/photos/<%= photo.id %>/delete" method="POST">
                    <button type="submit" class="photo-remove-link">Remove photo</button>
                  </form>
                </div>
              </article>
            <% }); %>
          </div>
        <% } else { %>
          <p class="additional-photos-empty">No additional photos yet.</p>
        <% } %>

        <% if (photos.length < 5) { %>
          <button type="button" class="btn btn-outline additional-photo-add-button" data-open-photo-upload data-photo-role="optional" data-photo-label="Additional photo">
            <%- include('../partials/icon', { name: 'photo-camera', size: '1rem', ariaHidden: true }) %>
            Add another photo
          </button>
        <% } %>
      </details>

      <dialog id="photoUploadDialog" class="photo-dialog" aria-labelledby="photoUploadTitle" data-open-on-load="<%= photoError ? 'true' : 'false' %>">
        <div class="photo-dialog-header">
          <h2 id="photoUploadTitle">Upload a photo</h2>
          <button type="button" class="photo-dialog-close" data-close-photo-upload aria-label="Close upload dialog">×</button>
        </div>
        <% if (photoError) { %>
          <p role="alert" class="photo-dialog-error"><%= photoError %></p>
        <% } %>
        <% if (photos.length < 5) { %>
          <form action="/listings/<%= listing.id %>/photos" method="POST" enctype="multipart/form-data" class="photo-upload-form">
            <div class="photo-upload-field">
              <label for="newPhotoRole">Photo type</label>
              <select id="newPhotoRole" name="role" required class="form-control">
                <option value="">Choose a photo type</option>
                <% newPhotoRoles.forEach(function(role) { %>
                  <option value="<%= role %>" data-guidance="<%= photoRoleGuidance[role] %>"><%= photoRoleLabels[role] %></option>
                <% }); %>
              </select>
            </div>
            <p id="photo-role-guidance" role="status" aria-live="polite" class="photo-role-guidance">Choose what the photo shows.</p>

            <div class="photo-upload-field">
              <span class="photo-upload-label">Photo file</span>
              <input type="file" id="photoFile" name="photo" accept="image/jpeg,image/png,image/webp" required class="photo-file-input" aria-describedby="photoFileHelp selected-photo-info" />
              <label for="photoFile" class="btn btn-outline photo-file-trigger">
                <%- include('../partials/icon', { name: 'photo-camera', size: '1.125rem', ariaHidden: true }) %>
                <span>Choose photo</span>
              </label>
              <span id="photoFileHelp" class="photo-file-help">JPEG, PNG or WebP · max 5 MiB</span>
            </div>

            <div id="photo-selection-preview" class="photo-selection-preview" hidden>
              <p id="selected-photo-info" role="status" aria-live="polite"></p>
              <img id="photo-original-preview" alt="Preview of the selected photo" hidden />
            </div>

            <div id="square-cover-cropper" class="square-cover-cropper" hidden>
              <p class="square-cover-intro">
                <strong id="square-cover-title">Square cover crop</strong>
                <span id="square-cover-description">Keep the complete sleeve inside the square.</span>
              </p>
              <div class="square-cover-preview-grid">
                <div>
                  <p>Original and crop area</p>
                  <canvas id="square-cover-source" aria-label="Original photo with square crop area"></canvas>
                </div>
                <div>
                  <p>Saved square preview</p>
                  <canvas id="square-cover-result" aria-label="Preview of the saved square photo" width="512" height="512"></canvas>
                </div>
              </div>
              <label for="square-cover-zoom">Zoom</label>
              <input id="square-cover-zoom" type="range" min="55" max="100" value="100" step="1" />
              <label for="square-cover-position">Position along the long edge</label>
              <input id="square-cover-position" type="range" min="0" max="100" value="50" step="1" />
              <p id="square-cover-status" role="status" aria-live="polite" class="square-cover-status">Review the square preview before uploading.</p>
            </div>

            <div class="photo-upload-field">
              <label for="altText">Alt text <span>(describe what is visible)</span></label>
              <input type="text" id="altText" name="altText" placeholder="e.g. Front cover with a crease in the top-right corner" required maxlength="250" />
            </div>

            <div class="photo-dialog-actions">
              <button type="button" class="btn btn-outline" data-close-photo-upload>Cancel</button>
              <button type="submit" class="btn btn-primary">Upload photo</button>
            </div>
          </form>
        <% } %>
      </dialog>

      <dialog id="photoHelpDialog" class="photo-dialog photo-help-dialog" aria-labelledby="photoHelpTitle">
        <div class="photo-dialog-header">
          <h2 id="photoHelpTitle">Photo help</h2>
          <button type="button" class="photo-dialog-close" data-close-photo-help aria-label="Close photo help">×</button>
        </div>
        <ul class="photo-help-list">
          <li>Use the front and back slots for the two sides of the actual sleeve.</li>
          <li>For covers, keep the whole sleeve visible in the square crop. The preview is what Crate Dig will show.</li>
          <li>Use Additional photos for the record, label, inserts, or visible wear.</li>
          <li>Upload JPEG, PNG, or WebP images up to 5 MiB each. You can add up to five photos.</li>
          <li>Describe important visible details in the alt text. Avoid glare and do not hide damage.</li>
        </ul>
        <div class="photo-dialog-actions">
          <button type="button" class="btn btn-primary" data-close-photo-help>Got it</button>
        </div>
      </dialog>
    </section>

    <!-- Details Update Form -->
    <form action="/listings/<%= listing.id %>/edit" method="POST" class="edit-listing-form" novalidate>
      <h2 style="font-family: var(--font-display); font-size: var(--font-size-lg); margin-bottom: var(--space-4);">Listing Details</h2>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); margin-bottom: var(--space-4);">
        <%- include('../partials/form-select', {
          name: 'mediaCondition',
          label: 'Media Condition',
          required: true,
          error: form.fieldErrors.mediaCondition,
          options: [
            { value: 'M', label: 'M (Mint)', selected: physicalCopy.mediaCondition === 'M' },
            { value: 'NM', label: 'NM (Near Mint)', selected: physicalCopy.mediaCondition === 'NM' },
            { value: 'VG+', label: 'VG+ (Very Good Plus)', selected: physicalCopy.mediaCondition === 'VG+' },
            { value: 'VG', label: 'VG (Very Good)', selected: physicalCopy.mediaCondition === 'VG' },
            { value: 'VG-', label: 'VG- (Very Good Minus)', selected: physicalCopy.mediaCondition === 'VG-' },
            { value: 'G+', label: 'G+ (Good Plus)', selected: physicalCopy.mediaCondition === 'G+' },
            { value: 'G', label: 'G (Good)', selected: physicalCopy.mediaCondition === 'G' },
            { value: 'F', label: 'F (Fair)', selected: physicalCopy.mediaCondition === 'F' },
            { value: 'P', label: 'P (Poor)', selected: physicalCopy.mediaCondition === 'P' }
          ]
        }) %>

        <%- include('../partials/form-select', {
          name: 'sleeveCondition',
          label: 'Sleeve Condition',
          required: true,
          error: form.fieldErrors.sleeveCondition,
          options: [
            { value: 'M', label: 'M (Mint)', selected: physicalCopy.sleeveCondition === 'M' },
            { value: 'NM', label: 'NM (Near Mint)', selected: physicalCopy.sleeveCondition === 'NM' },
            { value: 'VG+', label: 'VG+ (Very Good Plus)', selected: physicalCopy.sleeveCondition === 'VG+' },
            { value: 'VG', label: 'VG (Very Good)', selected: physicalCopy.sleeveCondition === 'VG' },
            { value: 'VG-', label: 'VG- (Very Good Minus)', selected: physicalCopy.sleeveCondition === 'VG-' },
            { value: 'G+', label: 'G+ (Good Plus)', selected: physicalCopy.sleeveCondition === 'G+' },
            { value: 'G', label: 'G (Good)', selected: physicalCopy.sleeveCondition === 'G' },
            { value: 'F', label: 'F (Fair)', selected: physicalCopy.sleeveCondition === 'F' },
            { value: 'P', label: 'P (Poor)', selected: physicalCopy.sleeveCondition === 'P' }
          ]
        }) %>
      </div>

      <div style="margin-bottom: var(--space-4);">
        <%- include('../partials/form-input', {
          type: 'text',
          name: 'priceEur',
          label: 'Price (€ EUR)',
          value: form.values.priceEur !== undefined ? form.values.priceEur : (listing.price !== null ? (listing.price / 100).toFixed(2) : ''),
          placeholder: 'e.g. 24.95',
          error: form.fieldErrors.priceEur
        }) %>
      </div>

      <div style="margin-bottom: var(--space-4); display: flex; align-items: center; gap: var(--space-2);">
        <input type="checkbox" id="tradeAvailable" name="tradeAvailable" value="true" <%= (form.values.tradeAvailable === 'true' || form.values.tradeAvailable === true || (form.values.tradeAvailable === undefined && listing.tradeAvailable)) ? 'checked' : '' %> style="width: 18px; height: 18px;" />
        <label for="tradeAvailable" style="font-family: var(--font-body); font-weight: bold; font-size: var(--font-size-sm); cursor: pointer;">
          Open to trade offers
        </label>
      </div>

      <%- include('../partials/form-textarea', {
        name: 'description',
        label: 'Listing Description',
        value: form.values.description !== undefined ? form.values.description : (listing.description || ''),
        rows: 4,
        error: form.fieldErrors.description
      }) %>

      <%- include('../partials/form-textarea', {
        name: 'notes',
        label: 'Physical Record Notes',
        value: form.values.notes !== undefined ? form.values.notes : (physicalCopy.notes || ''),
        rows: 2,
        error: form.fieldErrors.notes
      }) %>

      <div style="margin-top: var(--space-6); display: flex; gap: var(--space-3);">
        <%- include('../partials/button', {
          text: 'Save Details',
          type: 'submit',
          variant: 'primary',
          size: 'md'
        }) %>
        <a href="/listings/<%= listing.id %>/preview" class="btn btn-outline btn-md">Preview Listing</a>
      </div>
    </form>
  </div>
  <script src="/js/square-photo-cropper.js" defer></script>
</div>
