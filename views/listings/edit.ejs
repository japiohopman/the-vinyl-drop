<div class="edit-listing-page" style="max-width: 750px; margin: var(--space-8) auto;">
  <a href="/listings" class="mobile-back-control" aria-label="Back to My Listings" style="font-family: var(--font-mono); font-size: var(--font-size-sm); color: var(--color-ink-muted); text-decoration: none;"><span class="back-control-icon" aria-hidden="true">←</span><span class="back-control-label">Back to My Listings</span></a>

  <div class="card" style="padding: var(--space-6); border: var(--border-thick); border-radius: var(--radius-md); background: var(--color-surface-card); margin-top: var(--space-4);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4);">
      <h1 style="font-family: var(--font-display); font-size: var(--font-size-xl); margin: 0;">Edit Listing & Photos</h1>
      <a href="/listings/<%= listing.id %>/preview" class="btn btn-outline btn-sm">Preview Listing &rarr;</a>
    </div>

    <div style="padding: var(--space-3); background: var(--color-surface-bg); border-radius: var(--radius-sm); margin-bottom: var(--space-6); border: 1px solid var(--color-border-subtle);">
      <h2 style="font-family: var(--font-heading); font-size: var(--font-size-md); margin: 0;"><%= release.title %></h2>
      <p style="font-family: var(--font-mono); font-size: var(--font-size-sm); color: var(--color-ink-muted); margin: 0;">by <%= release.artist %> (<%= release.releaseYear || '' %>)</p>
    </div>

    <%- include('../partials/form-errors', {
      errors: form.generalErrors.length > 0
        ? form.generalErrors
        : Object.values(form.fieldErrors)
    }) %>

    <!-- Photos Management Section -->
    <section class="photos-section" style="margin-bottom: var(--space-8); padding-bottom: var(--space-6); border-bottom: 2px dashed var(--color-border-subtle);">
      <h2 style="font-family: var(--font-display); font-size: var(--font-size-lg); margin-bottom: var(--space-2);">Photos of this physical copy — used by Crate Dig</h2>
      <p style="font-family: var(--font-mono); font-size: var(--font-size-sm); color: var(--color-ink-muted); margin-bottom: var(--space-4);">
        Upload up to 5 photos of the exact copy offered in this listing (JPEG, PNG or WebP; max 5 MiB each). Choose what the photo shows before selecting the file. Front and back cover photos are cropped to a square so both sides line up in Crate Dig; other photo types keep their original framing so condition details are not cut off. Existing photos are not recropped automatically — if an older cover is still portrait, delete it and upload it again with the correct cover role.
      </p>

      <!-- Photos Upload Form -->
      <% if (photos.length < 5) { %>
        <form action="/listings/<%= listing.id %>/photos" method="POST" enctype="multipart/form-data" style="margin-bottom: var(--space-6); background: var(--color-surface-bg); padding: var(--space-4); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-sm);">
          <div style="display: flex; flex-direction: column; gap: var(--space-3);">
            <label for="newPhotoRole" style="font-family: var(--font-body); font-weight: bold; font-size: var(--font-size-sm);">What is shown in this photo? (required)</label>
            <select id="newPhotoRole" name="role" required class="form-control">
              <option value="">Choose a photo type</option>
              <% newPhotoRoles.forEach(function(role) { %>
                <option value="<%= role %>" data-guidance="<%= photoRoleGuidance[role] %>"><%= photoRoleLabels[role] %></option>
              <% }); %>
            </select>
            <p id="photo-role-guidance" role="status" aria-live="polite" style="font-size: var(--font-size-sm); color: var(--color-ink-muted); margin: 0;">
              Choose a photo type first. Front and back covers show a square crop preview; other photo types keep their original framing.
            </p>
            <details>
              <summary>Photo tips by type</summary>
              <ul style="padding-left: var(--space-5); font-size: var(--font-size-sm);">
                <% newPhotoRoles.forEach(function(role) { %>
                  <li style="margin: var(--space-2) 0;"><strong><%= photoRoleLabels[role] %>:</strong> <%= photoRoleGuidance[role] %></li>
                <% }); %>
              </ul>
            </details>
            <label for="photoFile" style="font-family: var(--font-body); font-weight: bold; font-size: var(--font-size-sm);">
              Choose one photo (JPEG, PNG or WebP; max 5 MiB)
            </label>
            <input type="file" id="photoFile" name="photo" accept="image/jpeg,image/png,image/webp" required style="font-family: var(--font-mono); font-size: var(--font-size-sm);" />
            <div id="photo-selection-preview" hidden style="padding: var(--space-3); margin-top: var(--space-1); border: 1px solid var(--color-border-subtle); background: var(--color-white);">
              <p id="selected-photo-info" role="status" aria-live="polite" style="font-size: var(--font-size-xs); color: var(--color-ink-muted); margin: 0 0 var(--space-2);"></p>
              <img id="photo-original-preview" alt="Preview of the selected photo" hidden style="display: block; width: 100%; max-width: 320px; max-height: 240px; object-fit: contain; background: var(--color-paper-muted);" />
            </div>
            <div id="square-cover-cropper" hidden style="padding: var(--space-3); border: 1px solid var(--color-border-subtle); background: var(--color-white);">
              <p style="font-size: var(--font-size-sm); margin-bottom: var(--space-2);">
                <strong id="square-cover-title">Square cover crop</strong> —
                <span id="square-cover-description">Adjust the crop until the complete sleeve fits inside the square. The preview below is what will be saved.</span>
              </p>
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: var(--space-3); align-items: start;">
                <div>
                  <p style="font-size: var(--font-size-xs); font-weight: 700; margin-bottom: var(--space-1);">Original photo and crop area</p>
                  <canvas id="square-cover-source" aria-label="Original photo with square crop area" style="display:block;width:100%;max-width:320px;height:auto;background:var(--color-paper-muted);"></canvas>
                </div>
                <div>
                  <p style="font-size: var(--font-size-xs); font-weight: 700; margin-bottom: var(--space-1);">Square image that will be saved</p>
                  <canvas id="square-cover-result" aria-label="Preview of the saved square photo" width="512" height="512" style="display:block;width:100%;max-width:280px;height:auto;background:var(--color-paper-muted);"></canvas>
                </div>
              </div>
              <label for="square-cover-zoom" style="display:block;font-size:var(--font-size-sm);font-weight:700;margin-top:var(--space-3);">Zoom</label>
              <input id="square-cover-zoom" type="range" min="55" max="100" value="100" step="1" style="width:100%;max-width:320px;min-height:32px;" />
              <label for="square-cover-position" style="display:block;font-size:var(--font-size-sm);font-weight:700;margin-top:var(--space-2);">Position along the long edge</label>
              <input id="square-cover-position" type="range" min="0" max="100" value="50" step="1" style="width:100%;max-width:320px;min-height:32px;" />
              <p id="square-cover-status" role="status" aria-live="polite" style="font-size:var(--font-size-xs);color:var(--color-ink-muted);margin-top:var(--space-2);">Review the complete sleeve and the square preview before uploading.</p>
            </div>
            <label for="altText" style="font-family: var(--font-body); font-weight: bold; font-size: var(--font-size-sm);">Alt-tekst (beschrijf wat zichtbaar is)</label>
            <input type="text" id="altText" name="altText" placeholder="Bijvoorbeeld: Side A-label of slijtage aan de rechterhoek" required maxlength="250" style="padding: 8px; border: var(--border-thin); font-size: var(--font-size-sm);" />
            <div>
              <%- include('../partials/button', {
                text: 'Upload Photo',
                type: 'submit',
                variant: 'primary',
                size: 'sm'
              }) %>
            </div>
          </div>
        </form>
      <% } else { %>
        <p style="font-family: var(--font-mono); font-size: var(--font-size-sm); color: var(--color-brand-primary); font-weight: bold;">
          Maximum limit of 5 photos reached for this listing.
        </p>
      <% } %>

      <% if (photoError) { %>
        <p role="alert" style="padding: var(--space-3); border: 1px solid var(--color-error-border); color: var(--color-error-border); margin-bottom: var(--space-4);"><%= photoError %></p>
      <% } %>

      <!-- Existing Photos List -->
      <% if (photos.length > 0) { %>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: var(--space-4);">
          <% photos.forEach(function(photo, idx) { %>
            <div class="listing-photo-card" data-photo-role="<%= photo.role %>" style="border: var(--border-thin); padding: var(--space-2); border-radius: var(--radius-sm); background: #fff; text-align: center;">
              <img class="listing-photo-image" src="<%= photo.publicUrl %>" alt="<%= photo.altText || 'Listing photo' %>" style="width: 100%; height: 140px; object-fit: cover; border-radius: var(--radius-xs);" />
              <p class="listing-photo-square-warning" hidden role="status" style="font-size: var(--font-size-xs); color: var(--color-error-border); text-align: left; margin: var(--space-2) 0;"></p>
              <div style="margin-top: var(--space-2); font-family: var(--font-mono); font-size: var(--font-size-xs); color: var(--color-ink-muted);">
                Foto #<%= idx + 1 %> · <strong><%= photoRoleLabels[photo.role] || photoRoleLabels.legacy_unclassified %></strong>
              </div>
              <p style="font-size: var(--font-size-xs); color: var(--color-ink-muted); text-align: left;"><%= photoRoleGuidance[photo.role] || photoRoleGuidance.legacy_unclassified %></p>
              <form action="/listings/<%= listing.id %>/photos/<%= photo.id %>/role" method="POST" style="margin-top: var(--space-2); text-align: left;">
                <label for="photo-role-<%= idx %>" style="font-size: var(--font-size-xs); font-weight: 700;">Classificeer / wijzig fotorol</label>
                <select id="photo-role-<%= idx %>" name="role" required class="form-control">
                  <% photoRoles.forEach(function(role) { %>
                    <option value="<%= role %>" <%= role === photo.role ? 'selected' : '' %>><%= photoRoleLabels[role] %></option>
                  <% }); %>
                </select>
                <button type="submit" class="btn btn-outline btn-sm" style="width: 100%; margin-top: var(--space-2);">Rol opslaan</button>
              </form>
              <form action="/listings/<%= listing.id %>/photos/<%= photo.id %>/delete" method="POST" style="margin-top: var(--space-2);">
                <button type="submit" class="btn btn-outline btn-sm" style="width: 100%; color: #dc2626; border-color: #fca5a5;">Delete Photo</button>
              </form>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <p style="font-family: var(--font-mono); font-size: var(--font-size-sm); color: var(--color-ink-muted);">No photos uploaded yet.</p>
      <% } %>
    </section>

    <!-- Details Update Form -->
    <form action="/listings/<%= listing.id %>/edit" method="POST" class="edit-listing-form" novalidate>
      <h2 style="font-family: var(--font-display); font-size: var(--font-size-lg); margin-bottom: var(--space-4);">Listing Details</h2>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); margin-bottom: var(--space-4);">
        <%- include('../partials/form-select', {
          name: 'mediaCondition',
          label: 'Media Condition',
          required: true,
          error: form.fieldErrors.mediaCondition,
          options: [
            { value: 'M', label: 'M (Mint)', selected: physicalCopy.mediaCondition === 'M' },
            { value: 'NM', label: 'NM (Near Mint)', selected: physicalCopy.mediaCondition === 'NM' },
            { value: 'VG+', label: 'VG+ (Very Good Plus)', selected: physicalCopy.mediaCondition === 'VG+' },
            { value: 'VG', label: 'VG (Very Good)', selected: physicalCopy.mediaCondition === 'VG' },
            { value: 'VG-', label: 'VG- (Very Good Minus)', selected: physicalCopy.mediaCondition === 'VG-' },
            { value: 'G+', label: 'G+ (Good Plus)', selected: physicalCopy.mediaCondition === 'G+' },
            { value: 'G', label: 'G (Good)', selected: physicalCopy.mediaCondition === 'G' },
            { value: 'F', label: 'F (Fair)', selected: physicalCopy.mediaCondition === 'F' },
            { value: 'P', label: 'P (Poor)', selected: physicalCopy.mediaCondition === 'P' }
          ]
        }) %>

        <%- include('../partials/form-select', {
          name: 'sleeveCondition',
          label: 'Sleeve Condition',
          required: true,
          error: form.fieldErrors.sleeveCondition,
          options: [
            { value: 'M', label: 'M (Mint)', selected: physicalCopy.sleeveCondition === 'M' },
            { value: 'NM', label: 'NM (Near Mint)', selected: physicalCopy.sleeveCondition === 'NM' },
            { value: 'VG+', label: 'VG+ (Very Good Plus)', selected: physicalCopy.sleeveCondition === 'VG+' },
            { value: 'VG', label: 'VG (Very Good)', selected: physicalCopy.sleeveCondition === 'VG' },
            { value: 'VG-', label: 'VG- (Very Good Minus)', selected: physicalCopy.sleeveCondition === 'VG-' },
            { value: 'G+', label: 'G+ (Good Plus)', selected: physicalCopy.sleeveCondition === 'G+' },
            { value: 'G', label: 'G (Good)', selected: physicalCopy.sleeveCondition === 'G' },
            { value: 'F', label: 'F (Fair)', selected: physicalCopy.sleeveCondition === 'F' },
            { value: 'P', label: 'P (Poor)', selected: physicalCopy.sleeveCondition === 'P' }
          ]
        }) %>
      </div>

      <div style="margin-bottom: var(--space-4);">
        <%- include('../partials/form-input', {
          type: 'text',
          name: 'priceEur',
          label: 'Price (€ EUR)',
          value: form.values.priceEur !== undefined ? form.values.priceEur : (listing.price !== null ? (listing.price / 100).toFixed(2) : ''),
          placeholder: 'e.g. 24.95',
          error: form.fieldErrors.priceEur
        }) %>
      </div>

      <div style="margin-bottom: var(--space-4); display: flex; align-items: center; gap: var(--space-2);">
        <input type="checkbox" id="tradeAvailable" name="tradeAvailable" value="true" <%= (form.values.tradeAvailable === 'true' || form.values.tradeAvailable === true || (form.values.tradeAvailable === undefined && listing.tradeAvailable)) ? 'checked' : '' %> style="width: 18px; height: 18px;" />
        <label for="tradeAvailable" style="font-family: var(--font-body); font-weight: bold; font-size: var(--font-size-sm); cursor: pointer;">
          Open to trade offers
        </label>
      </div>

      <%- include('../partials/form-textarea', {
        name: 'description',
        label: 'Listing Description',
        value: form.values.description !== undefined ? form.values.description : (listing.description || ''),
        rows: 4,
        error: form.fieldErrors.description
      }) %>

      <%- include('../partials/form-textarea', {
        name: 'notes',
        label: 'Physical Record Notes',
        value: form.values.notes !== undefined ? form.values.notes : (physicalCopy.notes || ''),
        rows: 2,
        error: form.fieldErrors.notes
      }) %>

      <div style="margin-top: var(--space-6); display: flex; gap: var(--space-3);">
        <%- include('../partials/button', {
          text: 'Save Details',
          type: 'submit',
          variant: 'primary',
          size: 'md'
        }) %>
        <a href="/listings/<%= listing.id %>/preview" class="btn btn-outline btn-md">Preview Listing</a>
      </div>
    </form>
  </div>
  <script src="/js/square-photo-cropper.js" defer></script>
</div>
