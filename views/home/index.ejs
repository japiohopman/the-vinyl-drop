<section class="home-intro" aria-labelledby="home-intro-title">
  <div class="home-intro-copy">
    <p class="home-intro-kicker">BUY · TRADE · DIG</p>
    <h1 id="home-intro-title"><%= message %></h1>
    <p>Discover records from local collectors. Find your next favourite, or add a copy to the crate.</p>
  </div>
  <div class="home-intro-actions">
    <a href="/browse" class="btn btn-primary">Browse records</a>
    <a href="/drop/new" class="btn btn-outline">+ Drop a record</a>
  </div>
</section>

<section class="recent-drops">
  <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--space-6); flex-wrap: wrap; gap: var(--space-4);">
    <h2 style="font-family: var(--font-display); font-size: var(--font-size-2xl);">Recent Drops</h2>
    <a href="/browse" style="font-family: var(--font-mono); font-size: var(--font-size-sm); color: var(--color-rust-accessible); text-decoration: underline;">
      View all drops →
    </a>
  </div>

  <% const dropsList = (typeof listings !== 'undefined' && listings) ? listings : ((typeof recentDrops !== 'undefined' && recentDrops) ? recentDrops : []); %>
  <% if (dropsList && dropsList.length > 0) { %>
    <div class="listing-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: var(--space-6);">
      <% dropsList.forEach(function(item) { %>
        <%- include('../partials/listing-card', { listing: item }) %>
      <% }); %>
    </div>
  <% } else { %>
    <div class="empty-state" style="padding: var(--space-12) var(--space-4); text-align: center; border: 2px dashed var(--color-border-subtle); border-radius: var(--radius-md);">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: var(--space-4); color: var(--color-ink-muted);" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>
      <h3 style="font-family: var(--font-display); font-size: var(--font-size-lg); margin-bottom: var(--space-2);">No recent drops yet</h3>
      <p style="color: var(--color-ink-muted); margin-bottom: var(--space-6);">Be the first to list a vinyl record in our community crate!</p>
      <a href="/drop/new" class="btn btn-primary">+ Drop a Record</a>
    </div>
  <% } %>
</section>

<section class="home-discovery" aria-labelledby="random-albums-title">
  <div class="home-section-heading">
    <div>
      <p class="home-intro-kicker">PICK FROM THE CRATE</p>
      <h2 id="random-albums-title">Random Albums</h2>
      <p class="home-section-description">A rotating handful of records from the community, beyond the newest drops.</p>
    </div>
    <a href="/browse" class="home-section-link">Explore the catalogue <span aria-hidden="true">→</span></a>
  </div>

  <% const discoveryList = (typeof discoveryListings !== 'undefined' && Array.isArray(discoveryListings)) ? discoveryListings : []; %>
  <% if (discoveryList.length > 0) { %>
    <div class="listing-grid home-listing-grid">
      <% discoveryList.forEach(function(item) { %>
        <%- include('../partials/listing-card', { listing: item }) %>
      <% }); %>
    </div>
  <% } else if (dropsList && dropsList.length > 0) { %>
    <p class="home-discovery-empty">That's the crate for now. More records will appear here as the community adds them.</p>
  <% } else { %>
    <p class="home-discovery-empty">No records to discover yet. Be the first to drop one into the crate.</p>
  <% } %>
</section>
