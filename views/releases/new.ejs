<div class="custom-release-page">
  <header class="custom-release-intro">
    <h1>Add a record</h1>
    <p>Enter the artist and track or album title. Discogs fills in the release details when it finds a confident match.</p>
  </header>

  <% if (form && form.generalErrors && form.generalErrors.length > 0) { %>
    <div class="custom-release-errors" role="alert"><%= form.generalErrors.join(', ') %></div>
  <% } %>

  <form action="/releases/new" method="POST" enctype="multipart/form-data" class="card custom-release-form" data-discogs-lookup-form>
    <div class="custom-release-primary-fields">
      <div class="custom-release-field">
        <label for="releaseArtist">Artist *</label>
        <input id="releaseArtist" type="text" name="artist" value="<%= form.values.artist || '' %>" required maxlength="120" autocomplete="off" class="form-input" placeholder="e.g. James Brown" data-discogs-lookup-artist />
      </div>
      <div class="custom-release-field">
        <label for="releaseTitle">Track or album title *</label>
        <input id="releaseTitle" type="text" name="title" value="<%= form.values.title || '' %>" required maxlength="160" autocomplete="off" class="form-input" placeholder="e.g. Sex Machine" data-discogs-lookup-title />
      </div>
    </div>

    <p class="discogs-lookup-status" id="discogsLookupStatus" role="status" aria-live="polite" aria-atomic="true" data-state="idle">Enter an artist and title to check Discogs.</p>
    <input type="hidden" name="coverArtUrl" id="discogsCoverArtUrl" value="<%= form.values.coverArtUrl || '' %>" data-discogs-field="coverArtUrl" />

    <details class="custom-release-details" id="releaseMetadataDetails">
      <summary>Release details</summary>
      <div class="custom-release-grid">
        <div class="custom-release-field">
          <label for="releaseLabel">Label</label>
          <input id="releaseLabel" type="text" name="label" value="<%= form.values.label || '' %>" maxlength="160" class="form-input" placeholder="Record label" data-discogs-field="label" />
        </div>
        <div class="custom-release-field">
          <label for="releaseCatalogueNumber">Catalogue number</label>
          <input id="releaseCatalogueNumber" type="text" name="catalogueNumber" value="<%= form.values.catalogueNumber || '' %>" maxlength="120" class="form-input" placeholder="e.g. WL-001" data-discogs-field="catalogueNumber" />
        </div>
        <div class="custom-release-field">
          <label for="releaseYear">Year</label>
          <input id="releaseYear" type="number" min="1880" max="<%= new Date().getFullYear() + 1 %>" name="releaseYear" value="<%= form.values.releaseYear || '' %>" class="form-input" placeholder="Year" data-discogs-field="releaseYear" />
        </div>
        <div class="custom-release-field">
          <label for="releaseFormat">Format</label>
          <input id="releaseFormat" type="text" name="format" value="<%= form.values.format || 'LP' %>" maxlength="120" class="form-input" placeholder="e.g. Vinyl, LP, Album" data-discogs-field="format" />
        </div>
        <div class="custom-release-field">
          <label for="releaseBarcode">Barcode (EAN/UPC)</label>
          <input id="releaseBarcode" type="text" name="barcode" value="<%= form.values.barcode || '' %>" maxlength="120" class="form-input" placeholder="Optional" data-discogs-field="barcode" />
        </div>
        <div class="custom-release-field">
          <label for="releaseCountry">Country</label>
          <input id="releaseCountry" type="text" name="country" value="<%= form.values.country || '' %>" maxlength="120" class="form-input" placeholder="Country" data-discogs-field="country" />
        </div>
        <div class="custom-release-field custom-release-field-full">
          <label for="releaseGenre">Genre / style</label>
          <input id="releaseGenre" type="text" name="genre" value="<%= form.values.genre || '' %>" maxlength="160" class="form-input" placeholder="e.g. Hip Hop, Funk" data-discogs-field="genre" />
        </div>
      </div>

      <fieldset class="release-catalog-artwork">
        <legend>Catalogue artwork (optional)</legend>
        <p class="custom-release-artwork-copy">This artwork represents the release edition. Photos of your physical copy are added in the next step.</p>
        <p id="releaseCoverArtDescription" class="custom-release-file-description">Upload artwork if the Discogs image is missing or incorrect (JPEG, PNG, WebP; up to 5MB).</p>
        <div class="custom-release-file-picker">
          <input id="releaseCoverArt" type="file" name="coverArt" accept="image/jpeg,image/png,image/webp" class="custom-release-file-input" aria-describedby="releaseCoverArtDescription releaseCoverArtFilename" />
          <label for="releaseCoverArt" class="btn btn-outline custom-release-file-trigger">
            <%- include('../partials/icon', { name: 'photo-camera', size: '1.25rem', ariaHidden: true }) %>
            <span class="custom-release-file-mobile-label">Use this device</span>
            <span class="custom-release-file-desktop-label">Choose file</span>
          </label>
          <span id="releaseCoverArtFilename" class="custom-release-file-name" role="status" aria-live="polite">No file selected</span>
        </div>
      </fieldset>
    </details>

    <button type="submit" class="btn btn-primary custom-release-submit">Continue to listing <span aria-hidden="true">→</span></button>
  </form>
</div>
<script src="/js/release-file-picker.js" defer></script>
<script src="/js/discogs-release-lookup.js" defer></script>
