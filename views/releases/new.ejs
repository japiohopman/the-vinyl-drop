<div class="custom-release-page">
  <header class="custom-release-intro">
    <h1>Add a record</h1>
    <p>Enter the artist and track or album title. Discogs fills in the release details when it finds a confident match.</p>
  </header>

  <% if (form && form.generalErrors && form.generalErrors.length > 0) { %>
    <div class="custom-release-errors" role="alert"><%= form.generalErrors.join(', ') %></div>
  <% } %>

  <form action="/releases/new" method="POST" class="card custom-release-form" data-discogs-lookup-form>
    <div class="custom-release-primary-fields">
      <div class="custom-release-field">
        <label for="releaseArtist">Artist *</label>
        <input id="releaseArtist" type="text" name="artist" value="<%= form.values.artist || '' %>" required maxlength="120" autocomplete="off" class="form-input" placeholder="e.g. James Brown" data-discogs-lookup-artist />
      </div>
      <div class="custom-release-field">
        <label for="releaseTitle">Track or album title *</label>
        <input id="releaseTitle" type="text" name="title" value="<%= form.values.title || '' %>" required maxlength="160" autocomplete="off" class="form-input" placeholder="e.g. Sex Machine" data-discogs-lookup-title />
      </div>
    </div>

    <p class="discogs-lookup-status" id="discogsLookupStatus" role="status" aria-live="polite" aria-atomic="true" data-state="idle">Enter an artist and title to check Discogs.</p>
    <input type="hidden" name="coverArtUrl" id="discogsCoverArtUrl" value="<%= form.values.coverArtUrl || '' %>" data-discogs-field="coverArtUrl" />
    <input type="hidden" name="discogsExternalId" id="discogsExternalId" value="<%= form.values.discogsExternalId || '' %>" data-discogs-field="discogsExternalId" />

    <section class="discogs-cover-preview" data-discogs-cover-preview data-state="idle" aria-labelledby="discogsArtworkTitle">
      <div class="discogs-cover-preview-frame" data-discogs-cover-frame>
        <div class="discogs-artwork-placeholder" data-discogs-artwork-placeholder aria-hidden="true">
          <%- include('../partials/icon', { name: 'photo-camera', size: '2rem', ariaHidden: true }) %>
          <span>Artwork preview</span>
        </div>
        <img alt="Discogs catalogue artwork preview" loading="eager" decoding="async" referrerpolicy="no-referrer" hidden />
      </div>
      <div class="discogs-cover-preview-copy">
        <span class="discogs-cover-preview-kicker" id="discogsArtworkTitle">RELEASE ARTWORK</span>
        <p data-discogs-cover-preview-status>Artwork will appear here after a confident Discogs match. You can add or replace release artwork later in Edit listing.</p>
      </div>
    </section>

    <details class="custom-release-details" id="releaseMetadataDetails">
      <summary>Release details</summary>
      <div class="custom-release-grid">
        <div class="custom-release-field">
          <label for="releaseLabel">Label</label>
          <input id="releaseLabel" type="text" name="label" value="<%= form.values.label || '' %>" maxlength="160" class="form-input" placeholder="Record label" data-discogs-field="label" />
        </div>
        <div class="custom-release-field">
          <label for="releaseCatalogueNumber">Catalogue number</label>
          <input id="releaseCatalogueNumber" type="text" name="catalogueNumber" value="<%= form.values.catalogueNumber || '' %>" maxlength="120" class="form-input" placeholder="e.g. WL-001" data-discogs-field="catalogueNumber" />
        </div>
        <div class="custom-release-field">
          <label for="releaseYear">Year</label>
          <input id="releaseYear" type="number" min="1880" max="<%= new Date().getFullYear() + 1 %>" name="releaseYear" value="<%= form.values.releaseYear || '' %>" class="form-input" placeholder="Year" data-discogs-field="releaseYear" />
        </div>
        <div class="custom-release-field">
          <label for="releaseFormat">Format source details</label>
          <input id="releaseFormat" type="text" name="format" value="<%= form.values.format || 'LP' %>" maxlength="120" class="form-input" placeholder="e.g. Vinyl, LP, Album" data-discogs-field="format" />
          <small>Original catalogue format text is retained.</small>
        </div>
        <div class="custom-release-field custom-release-field-full">
          <span class="custom-release-field-label">Recognized vinyl characteristics</span>
          <% const selectedFormatCharacteristics = Array.isArray(form.values.formatCharacteristics) ? form.values.formatCharacteristics : []; %>
          <div role="group" aria-label="Recognized vinyl characteristics" class="custom-release-format-options">
            <% (typeof formatCharacteristicOptions !== 'undefined' && Array.isArray(formatCharacteristicOptions) ? formatCharacteristicOptions : []).forEach(function(option) { %>
              <label>
                <input type="checkbox" name="formatCharacteristics" value="<%= option.value %>" <%= selectedFormatCharacteristics.includes(option.value) ? 'checked' : '' %> />
                <span><%= option.label %> — <%= option.description %></span>
              </label>
            <% }); %>
          </div>
          <small>Only explicitly selected or clearly identified characteristics are saved. No size is guessed from “single”, RPM or “vinyl”.</small>
        </div>
        <div class="custom-release-field">
          <label for="releaseBarcode">Barcode (EAN/UPC)</label>
          <input id="releaseBarcode" type="text" name="barcode" value="<%= form.values.barcode || '' %>" maxlength="120" class="form-input" placeholder="Optional" data-discogs-field="barcode" />
        </div>
        <div class="custom-release-field">
          <label for="releaseCountry">Country</label>
          <input id="releaseCountry" type="text" name="country" value="<%= form.values.country || '' %>" maxlength="120" list="releaseCountryOptions" class="form-input" placeholder="Start typing a country" data-discogs-field="country" />
          <input type="hidden" name="countryCode" value="<%= form.values.countryCode || '' %>" data-discogs-field="countryCode" />
          <datalist id="releaseCountryOptions">
            <% (typeof countryOptions !== 'undefined' && Array.isArray(countryOptions) ? countryOptions : []).forEach(function(country) { %>
              <option value="<%= country.label %>"></option>
            <% }); %>
          </datalist>
          <small>Choose a supported country. Discogs aliases such as UK and USA are normalized automatically.</small>
        </div>
        <div class="custom-release-field custom-release-field-full">
          <label for="releaseGenre">Genre / style</label>
          <input id="releaseGenre" type="text" name="genre" value="<%= form.values.genre || '' %>" maxlength="160" list="releaseGenreOptions" class="form-input" placeholder="e.g. Hip Hop, Funk / Soul" data-discogs-field="genre" />
          <datalist id="releaseGenreOptions">
            <% (typeof genreOptions !== 'undefined' && Array.isArray(genreOptions) ? genreOptions : []).forEach(function(genre) { %>
              <option value="<%= genre %>"></option>
            <% }); %>
          </datalist>
          <small>Use one or more values from the supported genre vocabulary. Original Discogs text is retained.</small>
        </div>
      </div>

    </details>

    <button type="submit" class="btn btn-primary custom-release-submit">Continue to listing <span aria-hidden="true">→</span></button>
  </form>
</div>
<script src="/js/discogs-release-lookup.js" defer></script>
