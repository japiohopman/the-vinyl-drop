{
  "name": "the-vinyl-drop",
  "version": "0.1.0",
  "description": "A local community marketplace for buying, selling, and trading physical vinyl records.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "jest",
    "test:a11y": "tsx scripts/test-accessibility.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:verify": "tsx scripts/verify-migration.ts"
  },
  "keywords": [
    "vinyl",
    "marketplace",
    "express",
    "ejs",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/busboy": "^3.2.2",
    "@supabase/supabase-js": "^2.117.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
