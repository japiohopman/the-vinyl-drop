# Environment Configuration

# Server
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
ALLOWED_REDIRECT_URLS=http://localhost:3000

# Database Configuration (Supabase / PostgreSQL)
# Pooler connection string for application runtime queries (e.g. Supavisor port 6543)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Direct connection string for Drizzle migrations (port 5432)
DATABASE_DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Auth Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
