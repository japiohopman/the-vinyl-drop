# Environment Configuration

# Server & Application Origin
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
ALLOWED_REDIRECT_URLS=http://localhost:3000

# Database Configuration (Supabase PostgreSQL)
# For hosted Supabase, use the Session pooler connection string (or direct connection port 5432) for long-running Express ORM queries.
# Local Supabase CLI / PostgreSQL default: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Direct connection string for Drizzle Kit migration commands (port 5432)
DATABASE_DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Auth Configuration (Required for Express runtime authentication & Google OAuth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Shared PostgreSQL request-rate counters (requires migration 0019 on the target database).
# Defaults off in all runtime environments; enable only after migration and access checks.
# SHARED_RATE_LIMITS_ENABLED=true

# One-time checked-signup approval gate for Supabase Auth's Before User Created hook.
# Defaults on in automated tests only; runtime environments require explicit opt-in after configuring the hook.
# SIGNUP_PASSWORD_CHECK_APPROVAL_ENABLED=true

# Small, manual invite-only beta gate (not a public waitlist).
# Enable only after the owner has added invited testers to the private runtime allowlist.
# Keep real addresses in restricted deployment settings, never in this file or public GitHub.
# BETA_INVITE_ONLY_ENABLED=true
# BETA_ALLOWED_EMAILS=first-invited-tester@example.com,second-invited-tester@example.com
