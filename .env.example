# Environment Configuration

# Server & Application Origin
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
ALLOWED_REDIRECT_URLS=http://localhost:3000

# Database Configuration (Supabase PostgreSQL)
# For hosted Render services on IPv4, use the Supabase Shared Pooler in Session mode (port 5432).
# Keep DATABASE_URL and DATABASE_DIRECT_URL pointed at the same production database host.
# Local Supabase CLI / PostgreSQL default: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Drizzle Kit migration connection; in production this may also use the Shared Session Pooler on port 5432.
DATABASE_DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Auth Configuration (Required for Express runtime authentication & Google OAuth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Production-only database target identity guard (non-secret metadata for local migration preflight).
# PRODUCTION_DB_PROJECT_REF must match the process-only TVD_CONFIRM_PRODUCTION_DB_PROJECT_REF.
# PRODUCTION_DB_HOST must be the exact host used in both production PostgreSQL URLs (for example, aws-0-eu-west-1.pooler.supabase.com).
# Never set these values to the staging project.
# PRODUCTION_DB_PROJECT_REF=replace-with-production-project-ref
# PRODUCTION_DB_HOST=aws-0-eu-west-1.pooler.supabase.com

# Shared PostgreSQL request-rate counters (requires migration 0019 on the target database).
# Defaults off in all runtime environments; enable only after migration, role and client-IP checks.
# Use a dedicated random secret (at least 32 characters), stable across all instances and overlapping deploys.
# Do not commit the value or reuse RECOVERY_SIGNING_SECRET; rotating it resets active rate-limit windows.
# SHARED_RATE_LIMITS_SECRET=replace-with-a-stable-random-secret-of-at-least-32-characters
# SHARED_RATE_LIMITS_ENABLED=true

# One-time checked-signup approval gate for Supabase Auth's Before User Created hook.
# Defaults on in automated tests only; runtime environments require explicit opt-in after configuring the hook.
# SIGNUP_PASSWORD_CHECK_APPROVAL_ENABLED=true

# Small, manual invite-only beta gate (not a public waitlist).
# Enable only after the owner has added invited testers to the private runtime allowlist.
# Keep real addresses in restricted deployment settings, never in this file or public GitHub.
# BETA_INVITE_ONLY_ENABLED=true
# BETA_ALLOWED_EMAILS=first-invited-tester@example.com,second-invited-tester@example.com
